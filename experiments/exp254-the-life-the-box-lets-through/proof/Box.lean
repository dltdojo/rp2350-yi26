  subst hF
  psimp [hpc, hmem, csrsConfigured, csrsReady, csrsBooted, csrsH]

/-- From reset (the image loaded at `0x80000000`, `pc = 0x80000040`, M-mode, any CSRs that lock no PMP entry --
    reset's among them -- any registers), 61 steps leave the machine in U-mode at the payload's first word, the PMP fencing it
    in with three entries -- code `[0x80010000, 0x80010080)` read and execute, data `[0x80010000, 0x80011000)` and
    stack `[0x8001f000, 0x80020000)` read and write -- every register zero but `sp`. -/
theorem monitor_boot (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem : s.core.mem = M0)
    (hpc : s.core.pc = 0x80000040#32) (hh : s.halted = false) (hm : s.mode = .M)
    (hlock : PmpUnlocked s.csrs.pmpcfg0) :
    WXBoxed (PrivMachine.run env 61 s) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 ∧
    (PrivMachine.run env 61 s).core.pc = 0x80010000#32 ∧
    (PrivMachine.run env 61 s).csrs = csrsBooted ∧
    (PrivMachine.run env 61 s).core.mem = M0 ∧
    (∀ r, (PrivMachine.run env 61 s).core.reg r = if r = 2 then 0x80020000#32 else 0#32) ∧
    (PrivMachine.run env 61 s).io = s.io ∧ (PrivMachine.run env 61 s).host = s.host := by
  obtain ⟨c1, c2, c3, c4, c5, cio, cho⟩ := monitor_boot_config env M0 s hW hmem hpc hh hm hlock
  have hC0 : Cleared 0 (PrivMachine.run env 28 s) := by
    intro r hr
    have : r = 0 := by bv_omega
    subst this
    simp
  obtain ⟨a1, a2, a3, a4, a5, a6, a7, a8⟩ := monitor_launch_1 env M0 _ hW c2 c1 c3 c4 c5 hC0
  obtain ⟨b1, b2, b3, b4, b5, b6, b7, b8⟩ := monitor_launch_2 env M0 _ hW a2 a1 a3 a4 a5 a6
  obtain ⟨e1, e2, e3, e4, e5, e6, e7, e8⟩ := monitor_launch_3 env M0 _ hW b2 b1 b3 b4 b5 b6
  obtain ⟨g1, g2, g3, g4, g5, g6, g7, g8⟩ := monitor_launch_4 env M0 _ hW e2 e1 e3 e4 e5
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, hb, h13, h14, h15⟩ :=
    monitor_launch_5 env M0 _ hW g2 g1 g3 g4 g5
  rw [show 61 = 28 + 12 + 12 + 7 + 1 + 1 from rfl, PrivMachine.run_add, PrivMachine.run_add,
    PrivMachine.run_add, PrivMachine.run_add, PrivMachine.run_add]
  refine ⟨⟨h4, h3, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, h1, hb, h2, ?_, by rw [h14, g7, e7, b7, a7, cio],
    by rw [h15, g8, e8, b8, a8, cho]⟩
  · rw [h5]; decide
  · rw [h5]; decide
  · rw [h5]; decide
  · exact Or.inl (by rw [h5]; decide)
  · simp [h6, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop]
  · simp [h7, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop]
  · simp [h8, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop]
  · intro r
    rw [h13 r, g6 r]
    exact e6 r (by have h := r.isLt; omega)


theorem run_two {env : Rv32.Env} {n m : Nat} {s s1 s2 : PrivMachine}
    (h1 : PrivMachine.run env n s = s1) (h2 : PrivMachine.run env m s1 = s2) :
    PrivMachine.run env (n + m) s = s2 := by
  rw [PrivMachine.run_add, h1, h2]

/-- A register a chunk did not name is what it was. -/
theorem reg_keep {cur prev : Reg → Word} {l : List (Nat × Word)} {k : Reg} {v : Word}
    (hr : ∀ r, cur r = regsUpd prev l r) (hn : l.find? (fun p => p.1 == k.toNat) = none)
    (hv : prev k = v) : cur k = v := by
  rw [hr k]; simp [regsUpd, hn, hv]

/-- A register a chunk named is what it was told. -/
theorem reg_set {cur prev : Reg → Word} {l : List (Nat × Word)} {k : Reg} {v : Word}
    (hr : ∀ r, cur r = regsUpd prev l r) (hn : l.find? (fun p => p.1 == k.toNat) = some (k.toNat, v)) :
    cur k = v := by
  rw [hr k]; simp [regsUpd, hn]

/-- The state after a chunk is a handler state again. -/
theorem HState.next {env : Rv32.Env} {M0 : Word → Byte} {s t : PrivMachine} (hS : HState env M0 s)
    (ha : Agree M0 t.core.mem 0x80000000 604) (hh : t.halted = false) (hm : t.mode = .M) :
    HState env M0 t := ⟨hS.words, ha, hS.region, hh, hm⟩


theorem ofNat_toNat_mod (x : Word) : BitVec.ofNat 32 (x.toNat % 4294967296) = x := by
  apply BitVec.eq_of_toNat_eq
  have := x.isLt
  simp only [BitVec.toNat_ofNat, Nat.reducePow]
  omega


/-! ## What the monitor writes, and where -/

/-- Memory outside the monitor's stack words and report words is what it was. -/
def FrameSP (m m' : Word → Byte) : Prop := ∀ x, ¬ InStack x → ¬ InPorts x → m' x = m x

theorem frameSP_of {m m' : Word → Byte} (f : Frame m m') (v : SvcSame m m') : FrameSP m m' := by
  intro x hs hp
  by_cases hv : InSvc x
  · exact v x hv
  · exact f x hs hp hv

theorem FrameSP.trans {a b c : Word → Byte} (h1 : FrameSP a b) (h2 : FrameSP b c) : FrameSP a c :=
  fun x i p => (h2 x i p).trans (h1 x i p)

/-! ## The park loop, and the exit code -/

/-- The park loop, reached: every register but `a0` zero, `mscratch` zero, the two words trap entry saved zero. -/
def Parked (t : PrivMachine) (a0 : Word) : Prop :=
  t.core.pc = 0x80000254#32 ∧ t.halted = false ∧ t.mode = .M ∧ t.csrs.mscratch = 0#32 ∧
  readLE t.core.mem 0x80008000#32 4 = 0 ∧ readLE t.core.mem 0x80008004#32 4 = 0 ∧
  t.core.reg 10#5 = a0 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32

/-- The code the monitor parks with after a trap: the payload's own `a0` if it asked for HALT (`ecall` with
    `t0 = 1`), and 1 for everything else. -/
def exitCode (u : PrivMachine) : Word :=
  if u.csrs.mcause = 8#32 ∧ u.core.reg 5#5 = 1#32 then u.core.reg 10#5 else 1#32

/-- A fault's report to the print word: the tag, `mcause`, `mepc`, `mtval` (0: Hazard3 hardwires it)
    and `minstret`. -/
def faultIo (u : PrivMachine) : List IoEvent :=
  [⟨0xc0000004#32, 0x4641554c#32⟩, ⟨0xc0000004#32, u.csrs.mcause⟩, ⟨0xc0000004#32, u.csrs.mepc⟩,
   ⟨0xc0000004#32, 0#32⟩, ⟨0xc0000004#32, u.csrs.minstret⟩]

/-- A HALT's report to the print word: the tag, the payload's `a0`, `minstret` and `mcycle`. -/
def haltIo (u : PrivMachine) : List IoEvent :=
  [⟨0xc0000004#32, 0x48414c54#32⟩, ⟨0xc0000004#32, u.core.reg 10#5⟩, ⟨0xc0000004#32, u.csrs.minstret⟩,
   ⟨0xc0000004#32, u.csrs.mcycle⟩]

/-- What the host hears of a trap, in order: the report for the way it trapped, then the exit code to the exit word. -/
def trapIo (u : PrivMachine) : List IoEvent :=
  (if u.csrs.mcause = 8#32 ∧ u.core.reg 5#5 = 1#32 then haltIo u else faultIo u) ++ [⟨0xc0000008#32, exitCode u⟩]

/-- How many steps the monitor takes from the trap vector to the park loop: an `ecall` for HALT, 57; an `ecall` for
    anything else, 62; any other trap, 59. -/
def trapSteps (u : PrivMachine) : Nat :=
  if u.csrs.mcause = 8#32 then (if u.core.reg 5#5 = 1#32 then 57 else 62) else 59

/-- The machine `k` steps into the payload, after boot's `61`. -/
def payloadAt (env : Rv32.Env) (s : PrivMachine) (k : Nat) : PrivMachine :=
  PrivMachine.run env k (PrivMachine.run env 61 s)

/-- The machine the monitor leaves after handling the trap at `u`. -/
def parkedAfter (env : Rv32.Env) (u : PrivMachine) : PrivMachine :=
  PrivMachine.run env (trapSteps u) u

/-- The bytes of the code entry, `[0x80010000, 0x80010080)`, are `C`'s. -/
def CodeSame (C : Word → Byte) (m : Word → Byte) : Prop :=
  ∀ x : Word, 0x80010000 ≤ x.toNat → x.toNat < 0x80010080 → m x = C x

