    (hpc : s.core.pc = 0x80000134#32) (hcs : s.csrs = csrsH ms e c m cy {} (0x80008000#32)) (hc : c = 8#32) (ht0 : s.core.reg 5#5 ≠ 1#32) :
    (PrivMachine.run env 62 s).core.pc = 0x80000254#32 ∧
    Agree M0 (PrivMachine.run env 62 s).core.mem 0x80000000 604 ∧
    (PrivMachine.run env 62 s).halted = false ∧
    (PrivMachine.run env 62 s).mode = .M ∧
    (PrivMachine.run env 62 s).csrs = csrsH ms e c m cy { cy := true, ir := true } (0#32) ∧
    (PrivMachine.run env 62 s).host = s.host ∧
    (PrivMachine.run env 62 s).io = s.io ++ [⟨0xc0000004#32, 0x4641554c#32⟩, ⟨0xc0000004#32, c⟩, ⟨0xc0000004#32, e⟩, ⟨0xc0000004#32, 0#32⟩, ⟨0xc0000004#32, m⟩, ⟨0xc0000008#32, 1#32⟩] ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x80008000#32 4 = 0 ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x80008004#32 4 = 0 ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x80008008#32 4 = readLE s.core.mem 0x80008008#32 4 ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x8000800c#32 4 = readLE s.core.mem 0x8000800c#32 4 ∧
    SvcSame s.core.mem (PrivMachine.run env 62 s).core.mem ∧
    Frame s.core.mem (PrivMachine.run env 62 s).core.mem ∧
    (∀ r, (PrivMachine.run env 62 s).core.reg r = regsUpd s.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32), (10, 1#32)] r) := by
  have p0 := hpc
  have c0 := hcs
  have hS0 := hS
  obtain ⟨s1, hs1⟩ : ∃ t, PrivMachine.run env 7 s = t := ⟨_, rfl⟩
  obtain ⟨p1, a1, h1, m1, c1, ho1, io1, w1_0, w1_1, w1_2, w1_3, sv1, fr1, r1⟩ := monitor_enter env M0 s hS0 ms e c m cy p0 c0
  rw [hs1] at p1 a1 h1 m1 c1 ho1 io1 w1_0 w1_1 w1_2 w1_3 sv1 fr1 r1
  have sv1_0 : readLE s1.core.mem 0xc0000010#32 4 = readLE s.core.mem 0xc0000010#32 4 := SvcSame.read sv1 _ (by decide)
  have sv1_1 : readLE s1.core.mem 0xc0000014#32 4 = readLE s.core.mem 0xc0000014#32 4 := SvcSame.read sv1 _ (by decide)
  have sv1_2 : readLE s1.core.mem 0xc0000018#32 4 = readLE s.core.mem 0xc0000018#32 4 := SvcSame.read sv1 _ (by decide)
  have sv1_3 : readLE s1.core.mem 0xc000001c#32 4 = readLE s.core.mem 0xc000001c#32 4 := SvcSame.read sv1 _ (by decide)
  simp [hc, regsUpd] at p1
  have hS1 := hS0.next a1 h1 m1
  obtain ⟨s2, hs2⟩ : ∃ t, PrivMachine.run env 3 s1 = t := ⟨_, rfl⟩
  obtain ⟨p2, a2, h2, m2, c2, ho2, io2, w2_0, w2_1, w2_2, w2_3, sv2, fr2, r2⟩ := call_is_halt env M0 s1 hS1 ms e c m cy (s.core.reg 2#5) ((s.core.reg 5#5).toNat % 4294967296) p1 c1 (by simp [r1, regsUpd, hc, ht0]) w1_0
  rw [hs2] at p2 a2 h2 m2 c2 ho2 io2 w2_0 w2_1 w2_2 w2_3 sv2 fr2 r2
  have sv2_0 : readLE s2.core.mem 0xc0000010#32 4 = readLE s1.core.mem 0xc0000010#32 4 := SvcSame.read sv2 _ (by decide)
  have sv2_1 : readLE s2.core.mem 0xc0000014#32 4 = readLE s1.core.mem 0xc0000014#32 4 := SvcSame.read sv2 _ (by decide)
  have sv2_2 : readLE s2.core.mem 0xc0000018#32 4 = readLE s1.core.mem 0xc0000018#32 4 := SvcSame.read sv2 _ (by decide)
  have sv2_3 : readLE s2.core.mem 0xc000001c#32 4 = readLE s1.core.mem 0xc000001c#32 4 := SvcSame.read sv2 _ (by decide)
  simp [ofNat_toNat_mod, ht0, regsUpd] at p2
  have hS2 := hS1.next a2 h2 m2
  obtain ⟨s3, hs3⟩ : ∃ t, PrivMachine.run env 18 s2 = t := ⟨_, rfl⟩
  obtain ⟨p3, a3, h3, m3, c3, ho3, io3, w3_0, w3_1, w3_2, w3_3, sv3, fr3, r3⟩ := monitor_fault_exit env M0 s2 hS2 ms e c m cy (s.core.reg 2#5) p2 c2 (by simp [r2, r1, regsUpd, hc, ht0])
  rw [hs3] at p3 a3 h3 m3 c3 ho3 io3 w3_0 w3_1 w3_2 w3_3 sv3 fr3 r3
  have sv3_0 : readLE s3.core.mem 0xc0000010#32 4 = readLE s2.core.mem 0xc0000010#32 4 := SvcSame.read sv3 _ (by decide)
  have sv3_1 : readLE s3.core.mem 0xc0000014#32 4 = readLE s2.core.mem 0xc0000014#32 4 := SvcSame.read sv3 _ (by decide)
  have sv3_2 : readLE s3.core.mem 0xc0000018#32 4 = readLE s2.core.mem 0xc0000018#32 4 := SvcSame.read sv3 _ (by decide)
  have sv3_3 : readLE s3.core.mem 0xc000001c#32 4 = readLE s2.core.mem 0xc000001c#32 4 := SvcSame.read sv3 _ (by decide)
  have hS3 := hS2.next a3 h3 m3
  obtain ⟨s4, hs4⟩ : ∃ t, PrivMachine.run env 34 s3 = t := ⟨_, rfl⟩
  obtain ⟨p4, a4, h4, m4, c4, ho4, io4, w4_0, w4_1, w4_2, w4_3, sv4, fr4, r4⟩ := monitor_regs env M0 s3 hS3 ms e c m cy p3 c3
  rw [hs4] at p4 a4 h4 m4 c4 ho4 io4 w4_0 w4_1 w4_2 w4_3 sv4 fr4 r4
  have sv4_0 : readLE s4.core.mem 0xc0000010#32 4 = readLE s3.core.mem 0xc0000010#32 4 := SvcSame.read sv4 _ (by decide)
  have sv4_1 : readLE s4.core.mem 0xc0000014#32 4 = readLE s3.core.mem 0xc0000014#32 4 := SvcSame.read sv4 _ (by decide)
  have sv4_2 : readLE s4.core.mem 0xc0000018#32 4 = readLE s3.core.mem 0xc0000018#32 4 := SvcSame.read sv4 _ (by decide)
  have sv4_3 : readLE s4.core.mem 0xc000001c#32 4 = readLE s3.core.mem 0xc000001c#32 4 := SvcSame.read sv4 _ (by decide)
  have hall : PrivMachine.run env 62 s = s4 := run_two hs1 (run_two hs2 (run_two hs3 (hs4)))
  rw [hall]
  refine ⟨p4, a4, h4, m4, c4, ?ho, ?io, ?w0, ?w1, ?w2, ?w3, ?sv, ?fr, ?r⟩
  case ho => exact (ho4.trans (ho3.trans (ho2.trans ho1)))
  case io => simp [io4, io3, io2, io1, ho4, ho3, ho2, ho1, List.append_assoc, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w0 => simp [w4_0, w3_0, w2_0, w1_0, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w1 => simp [w4_1, w3_1, w2_1, w1_1, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w2 => simp [w4_2, w3_2, w2_2, w1_2, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w3 => simp [w4_3, w3_3, w2_3, w1_3, r4, r3, r2, r1, regsUpd, hc, ht0]
  case sv => exact (sv1.trans (sv2.trans (sv3.trans sv4)))
  case fr => exact (fr1.trans (fr2.trans (fr3.trans fr4)))
  case r =>
    intro r
    have hr32 : r = 0#5 ∨ r = 1#5 ∨ r = 2#5 ∨ r = 3#5 ∨ r = 4#5 ∨ r = 5#5 ∨ r = 6#5 ∨ r = 7#5 ∨ r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 ∨ r = 16#5 ∨ r = 17#5 ∨ r = 18#5 ∨ r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨ r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 ∨ r = 31#5 := by bv_omega
    rcases hr32 with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp [w4_0, w4_1, w4_2, w4_3, w3_0, w3_1, w3_2, w3_3, w2_0, w2_1, w2_2, w2_3, w1_0, w1_1, w1_2, w1_3, ofNat_toNat_mod, r4, r3, r2, r1, regsUpd, hc, ht0]


theorem reg32 (r : Reg) : r = 0#5 ∨ r = 1#5 ∨ r = 2#5 ∨ r = 3#5 ∨ r = 4#5 ∨ r = 5#5 ∨ r = 6#5 ∨ r = 7#5 ∨ r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 ∨ r = 16#5 ∨ r = 17#5 ∨ r = 18#5 ∨ r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨ r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 ∨ r = 31#5 := by bv_omega

/-- The register scrub of a HALT: every register but `a0` zero, `a0` as it was. -/
theorem regs_scrubbed {u t : PrivMachine} (q : ∀ r, t.core.reg r = regsUpd u.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32)] r) :
    t.core.reg 10#5 = u.core.reg 10#5 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32 := by
  refine ⟨?_, ?_⟩
  · rw [q 10#5]; simp [regsUpd]
  · intro r hr
    rw [q r]
    rcases reg32 r with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> first | (exfalso; exact hr rfl) | simp [regsUpd]

/-- The register scrub of a fault: `a0` is 1, every other register zero. -/
theorem regs_scrubbed_fault {u t : PrivMachine} (q : ∀ r, t.core.reg r = regsUpd u.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32), (10, 1#32)] r) :
    t.core.reg 10#5 = 1#32 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32 := by
  refine ⟨?_, ?_⟩
  · rw [q 10#5]; simp [regsUpd]
  · intro r hr
    rw [q r]
    rcases reg32 r with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> first | (exfalso; exact hr rfl) | simp [regsUpd]



/-! ## However the payload leaves, the monitor parks -/

/-- **A trap, and what the monitor makes of it.** From the trap vector, whatever the payload left in its registers
    and memory, and whatever it was that trapped -- an `ecall` for HALT, an `ecall` for anything else, or a fault --
    the monitor parks with the exit code `exitCode u` (the payload's own `a0` for a HALT, 1 for the rest), every other
    register zero, `mscratch` and the saved words zero, its own words in place, and **every byte of memory but its stack
    words and its report words as the payload left it**: the code, the data, the stack, the rest; the PMP as boot set it;
    and the host has heard `trapIo u`, the report for the way it trapped and then the exit code. -/
theorem monitor_traps (env : Rv32.Env) (M0 : Word → Byte) (u : PrivMachine)
    (hS : HState env M0 u) (ms : MStatus) (e c m cy : Word)
    (hpc : u.core.pc = 0x80000134#32) (hcs : u.csrs = csrsH ms e c m cy {} 0x80008000#32) :
    Parked (PrivMachine.run env (trapSteps u) u) (exitCode u) ∧
      Agree M0 (PrivMachine.run env (trapSteps u) u).core.mem 0x80000000 604 ∧
      FrameSP u.core.mem (PrivMachine.run env (trapSteps u) u).core.mem ∧
      (PrivMachine.run env (trapSteps u) u).csrs.pmpcfg0 = 0x001b1b1d#32 ∧
      (PrivMachine.run env (trapSteps u) u).host = u.host ∧
      (PrivMachine.run env (trapSteps u) u).io = u.io ++ trapIo u := by
  have hcu : u.csrs.mcause = c := by rw [hcs]; rfl
  by_cases hc : c = 8#32
  · by_cases ht0 : u.core.reg 5#5 = 1#32
    · -- an `ecall` for HALT
      obtain ⟨p, a, h, m', cc, ho, io, w0, w1, w2, w3, sv, fr, r⟩ := monitor_halt env M0 u hS ms e c m cy hpc hcs hc ht0
      obtain ⟨k1, k2⟩ := regs_scrubbed r
      have hn : trapSteps u = 57 := by simp [trapSteps, hcu, hc, ht0]
      rw [hn]
      refine ⟨⟨p, h, m', by rw [cc]; rfl, w0, w1, ?_, k2⟩, a, frameSP_of fr sv, by rw [cc]; rfl, ho, ?_⟩
      · rw [k1]
        simp [exitCode, hcu, hc, ht0]
      · rw [io]
        simp [trapIo, faultIo, haltIo, exitCode, hcs, csrsH, hcu, hc, ht0]
    · -- an `ecall` for anything else
      obtain ⟨p, a, h, m', cc, ho, io, w0, w1, w2, w3, sv, fr, r⟩ := monitor_fault_syscall env M0 u hS ms e c m cy hpc hcs hc ht0
      obtain ⟨k1, k2⟩ := regs_scrubbed_fault r
      have hn : trapSteps u = 62 := by simp [trapSteps, hcu, hc, ht0]
      rw [hn]
      refine ⟨⟨p, h, m', by rw [cc]; rfl, w0, w1, ?_, k2⟩, a, frameSP_of fr sv, by rw [cc]; rfl, ho, ?_⟩
      · rw [k1]
        simp [exitCode, hcu, hc, ht0]
      · rw [io]
        simp [trapIo, faultIo, haltIo, exitCode, hcs, csrsH, hcu, hc, ht0]
  · -- a trap that is not an `ecall`
      obtain ⟨p, a, h, m', cc, ho, io, w0, w1, w2, w3, sv, fr, r⟩ := monitor_fault_cause env M0 u hS ms e c m cy hpc hcs hc
      obtain ⟨k1, k2⟩ := regs_scrubbed_fault r
      have hn : trapSteps u = 59 := by simp [trapSteps, hcu, hc]
      rw [hn]
      refine ⟨⟨p, h, m', by rw [cc]; rfl, w0, w1, ?_, k2⟩, a, frameSP_of fr sv, by rw [cc]; rfl, ho, ?_⟩
      · rw [k1]
        simp [exitCode, hcu, hc]
      · rw [io]
        simp [trapIo, faultIo, haltIo, exitCode, hcs, csrsH, hcu, hc]


/-! ## The payload runs, and traps -/

/-- The payload is in the box: it runs up to its first trap. Its writes land in the data and the stack only, the code
    is not among them, and the monitor's words stay where they were; at the trap the machine is in M-mode at the trap
    vector, with the CSRs boot set and `HState` true, so that the handler's theorems apply. -/
theorem payload_runs (env : Rv32.Env) (M0 : Word → Byte) (s1 : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem1 : s1.core.mem = M0) (henv : env.region = monRegion)
    (hcs1 : s1.csrs = csrsBooted)
    (hbox : WXBoxed s1 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000) (n : Nat) :
    ∃ k, k ≤ n ∧
      (∀ x : Word, WxFrozen 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 x →
        (PrivMachine.run env k s1).core.mem x = M0 x) ∧
      Agree M0 (PrivMachine.run env k s1).core.mem 0x80000000 604 ∧
      ((k = n ∧ (PrivMachine.run env k s1).mode = .U ∧
        WXBoxed (PrivMachine.run env k s1) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000) ∨
       (0 < k ∧ (PrivMachine.run env k s1).mode = .M ∧ HState env M0 (PrivMachine.run env k s1) ∧
        (PrivMachine.run env k s1).core.pc = 0x80000134#32 ∧
        ∃ ms e c m cy, (PrivMachine.run env k s1).csrs = csrsH ms e c m cy {} 0x80008000#32)) := by
  obtain ⟨k, hkn, hkept, hhalt, hframe, hres⟩ :=
    wx_run env 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 (by decide) (by decide) n s1 hbox
  refine ⟨k, hkn, ?_⟩
  obtain ⟨u, hu⟩ : ∃ t, PrivMachine.run env k s1 = t := ⟨_, rfl⟩
  rw [hu] at hkept hhalt hframe hres ⊢
  have hfroz : ∀ x : Word, WxFrozen 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 x →
      u.core.mem x = M0 x := fun x hx => by rw [hframe x hx, hmem1]
  have hagree : Agree M0 u.core.mem 0x80000000 604 := by
    intro x h1 h2
    exact hfroz x (Or.inr ⟨by omega, by omega⟩)
  refine ⟨hfroz, hagree, ?_⟩
  rcases hres with ⟨hk, hmode, hb⟩ | ⟨hpos, hmode, hpc2⟩
  · exact Or.inl ⟨hk, hmode, hb⟩
  · right
    obtain ⟨k1, k2, k3, k4, k5, k6, k7, k8⟩ := hkept
    rw [hcs1] at k1 k2 k3 k4 k5 k6 k7 k8 hpc2
    have hcsu : u.csrs = csrsH u.csrs.mstatus u.csrs.mepc u.csrs.mcause u.csrs.minstret u.csrs.mcycle {} 0x80008000#32 :=
      csrs_eq_csrsH u.csrs k1 k2 k3 k4 k5 k6 k7 k8
    have hpcu : u.core.pc = 0x80000134#32 := by
      rw [hpc2]; show (0x80000134#32 &&& ~~~3#32) = 0x80000134#32; decide
    exact ⟨hpos, hmode, ⟨hW, hagree, henv, hhalt, hmode⟩, hpcu, _, _, _, _, _, hcsu⟩

set_option maxHeartbeats 4000000 in
/-- **The code the box forbids writing.** From reset -- or from any CSRs that lock no PMP entry -- the monitor boots
    (61 steps) and the payload runs for up to `n`
    steps. Either it is still running, in U-mode, boxed by the three entries, the monitor's words where they were and
    the code, `[0x80010000, 0x80010080)`, **the bytes it started with** -- or it trapped, and the monitor takes
    `trapSteps` steps to the park loop with the exit code `exitCode u` (the payload's own `a0` for a HALT, 1 for the
    rest), every other register zero, and every byte of memory but the monitor's stack and report words as the payload
    left it -- the code among them, still the bytes it started with -- and the host has heard `trapIo u`: the report
    for the way it trapped, then the exit code. -/
theorem monitor_end_to_end (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem : s.core.mem = M0)
    (hpc : s.core.pc = 0x80000040#32) (hh : s.halted = false) (hm : s.mode = .M)
    (hlock : PmpUnlocked s.csrs.pmpcfg0) (henv : env.region = monRegion) (n : Nat) :
    ∃ k, k ≤ n ∧
      ((k = n ∧ (payloadAt env s k).mode = .U ∧
        WXBoxed (payloadAt env s k) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 ∧
        Agree M0 (payloadAt env s k).core.mem 0x80000000 604 ∧
        CodeSame M0 (payloadAt env s k).core.mem) ∨
       (0 < k ∧
        Parked (parkedAfter env (payloadAt env s k)) (exitCode (payloadAt env s k)) ∧
        Agree M0 (parkedAfter env (payloadAt env s k)).core.mem 0x80000000 604 ∧
        CodeSame M0 (parkedAfter env (payloadAt env s k)).core.mem ∧
        FrameSP (payloadAt env s k).core.mem (parkedAfter env (payloadAt env s k)).core.mem ∧
        (parkedAfter env (payloadAt env s k)).io = (payloadAt env s k).io ++ trapIo (payloadAt env s k))) := by
  obtain ⟨hbox, hpc1, hcsb, hmem1, hreg1, -, -⟩ := monitor_boot env M0 s hW hmem hpc hh hm hlock
  obtain ⟨k, hkn, hfroz, hagree, hres⟩ := payload_runs env M0 _ hW hmem1 henv hcsb hbox n
  refine ⟨k, hkn, ?_⟩
  unfold payloadAt parkedAfter
  rcases hres with ⟨hk, hmode, hb⟩ | ⟨hpos, hmode, hS, hpcu, ms, e, c, m, cy, hcsu⟩
  · exact Or.inl ⟨hk, hmode, hb, hagree, fun x h1 h2 => hfroz x (Or.inl ⟨h1, h2⟩)⟩
  · right
    obtain ⟨hP, hA, hF, -, -, hio⟩ := monitor_traps env M0 _ hS ms e c m cy hpcu hcsu
    refine ⟨hpos, hP, hA, ?_, hF, hio⟩
    intro x h1 h2
    have hs : ¬ InStack x := by unfold InStack; omega
    have hp : ¬ InPorts x := by unfold InPorts; omega
    rw [hF x hs hp]
    exact hfroz x (Or.inl ⟨h1, h2⟩)

/-! ## Round after round -/

/-- A reset, as weak as one can be: the core starts again at the reset vector, in M-mode, with nothing running; the
    registers, the CSRs and memory are whatever they were. A reset that also resets the CSRs is one of these. -/
def resetOf (p : PrivMachine) : PrivMachine :=
  { p with core := { p.core with pc := 0x80000040#32 }, mode := .M, halted := false }

/-- What a round needs of the machine it starts from, and nothing else: the monitor's words in memory, the code region
    as it was loaded (`C`), no PMP entry locked, and the region Tier 1 lets M-mode touch. The registers and the rest of
    the CSRs are not in it. -/
structure Ready (env : Rv32.Env) (C : Word → Byte) (p : PrivMachine) : Prop where
  words    : WordsAt p.core.mem 0x80000000#32 monitorCode
  code     : CodeSame C p.core.mem
  unlocked : PmpUnlocked p.csrs.pmpcfg0
  region   : env.region = monRegion

/-- `k` steps into a payload, `k > 0`, is its first trap: M-mode, and every step before was U-mode. -/
def Trapped (env : Rv32.Env) (s : PrivMachine) (k : Nat) : Prop :=
  0 < k ∧ (PrivMachine.run env k s).mode = .M ∧ ∀ i, i < k → (PrivMachine.run env i s).mode = .U

/-- One round, from `p` to `q`: reset, boot, the payload runs to its first trap, and the monitor takes it to the park loop. -/
def Round (env : Rv32.Env) (p q : PrivMachine) : Prop :=
  ∃ k, Trapped env (PrivMachine.run env 61 (resetOf p)) k ∧ q = parkedAfter env (payloadAt env (resetOf p) k)

/-- What the host may do between rounds: anything at all to the machine -- its registers, its CSRs, its memory -- but
    write the monitor's words or the code, or lock a PMP entry. rounds.py writes the next round's seed word, in the
    data. -/
def HostWrite (p q : PrivMachine) : Prop :=
  PmpUnlocked q.csrs.pmpcfg0 ∧
    ∀ x : Word, (0x80000000 ≤ x.toNat ∧ x.toNat < 0x80000000 + 604) ∨ (0x80010000 ≤ x.toNat ∧ x.toNat < 0x80010080) →
      q.core.mem x = p.core.mem x

/-- Any number of rounds, and between any two of them, any number of the host's writes. -/
inductive Rounds (env : Rv32.Env) : PrivMachine → PrivMachine → Prop
  | refl (p : PrivMachine) : Rounds env p p
  | step {p q r : PrivMachine} : Round env p q → Rounds env q r → Rounds env p r
  | host {p q r : PrivMachine} : HostWrite p q → Rounds env q r → Rounds env p r

/-- **The host's write leaves the machine ready.** It did not touch the monitor's words or the code, and locked
    nothing. -/
theorem ready_of_host (env : Rv32.Env) (C : Word → Byte) (p q : PrivMachine) (hR : Ready env C p)
    (h : HostWrite p q) : Ready env C q := by
  obtain ⟨hl, hm⟩ := h
  refine ⟨?_, ?_, hl, hR.region⟩
  · have hA : Agree p.core.mem q.core.mem 0x80000000 604 := fun x h1 h2 => hm x (Or.inl ⟨h1, h2⟩)
    exact WordsAt.of_agree (by rw [monitorCode_length]; decide) (by rw [monitorCode_length]; exact hA) hR.words
  · intro x h1 h2
    rw [hm x (Or.inr ⟨h1, h2⟩)]
    exact hR.code x h1 h2

/-- **Boot does not depend on what came before.** From any machine that is `Ready` -- whatever its registers, its
    CSRs but for a lock, its privilege, its `pc`, and whatever is in memory outside the monitor's words -- a reset and
    61 steps leave exactly the machine `monitor_boot` describes: boxed by the three entries, the CSR file `csrsBooted`
    (counters at 2, `mstatus`, `mepc`, `mcause`, the trap vector, the PMP -- all constants), `sp` at the top
    of the stack entry, every other register zero, memory untouched. No register and no CSR a round leaves behind
    reaches the next; memory outside the monitor's words does, and the payload reads it. -/
theorem monitor_reentry (env : Rv32.Env) (C : Word → Byte) (p : PrivMachine) (hR : Ready env C p) :
    WXBoxed (PrivMachine.run env 61 (resetOf p)) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 ∧
    (PrivMachine.run env 61 (resetOf p)).csrs = csrsBooted ∧
    (PrivMachine.run env 61 (resetOf p)).core.pc = 0x80010000#32 ∧
    (PrivMachine.run env 61 (resetOf p)).core.mem = p.core.mem ∧
    (∀ r, (PrivMachine.run env 61 (resetOf p)).core.reg r = if r = 2 then 0x80020000#32 else 0#32) := by
  obtain ⟨hbox, hpc1, hcsb, hmem1, hreg1, -, -⟩ :=
    monitor_boot env p.core.mem (resetOf p) hR.words rfl rfl rfl rfl hR.unlocked
  exact ⟨hbox, hcsb, hpc1, hmem1, hreg1⟩

/-- **A round leaves the machine ready for the next.** If `p` is `Ready` and `q` is where a round from `p` ends, `q` is
    parked -- every register but `a0` zero, `mscratch` and the saved words zero -- and `Ready` again, with the code
    region the bytes it was and the PMP as boot set it, which locks nothing. -/
theorem monitor_round_ready (env : Rv32.Env) (C : Word → Byte) (p q : PrivMachine) (hR : Ready env C p)
    (hq : Round env p q) : Ready env C q ∧ ∃ a, Parked q a := by
  obtain ⟨k, ⟨hk0, hkM, hkU⟩, hq⟩ := hq
  obtain ⟨hbox, hcsb, hpc1, hmem1, hreg1⟩ := monitor_reentry env C p hR
  obtain ⟨k', hk'k, hfroz, hagree, hres⟩ :=
    payload_runs env p.core.mem _ hR.words hmem1 hR.region hcsb hbox k
  -- the first trap is `k`: a shorter run that trapped would have been in M-mode before `k`
  have hkk : k' = k := by
    rcases hres with ⟨h1, h2, _⟩ | ⟨h1, h2, _⟩
    · exfalso
      have : (PrivMachine.run env k' (PrivMachine.run env 61 (resetOf p))).mode = .M := by rw [h1]; exact hkM
      rw [h2] at this
      exact absurd this (by decide)
    · by_cases hne : k' = k
      · exact hne
      · exfalso
        have := hkU k' (by omega)
        rw [h2] at this
        exact absurd this (by decide)
  subst hkk
  rcases hres with ⟨_, h2, _⟩ | ⟨hpos, hmode, hS, hpcu, ms, e, c, m, cy, hcsu⟩
  · exfalso
    rw [h2] at hkM
    exact absurd hkM (by decide)
  · obtain ⟨hP, hA, hF, hC, -, -⟩ := monitor_traps env p.core.mem _ hS ms e c m cy hpcu hcsu
    rw [hq]
    unfold parkedAfter payloadAt
    refine ⟨⟨?_, ?_, ?_, hR.region⟩, _, hP⟩
    · exact WordsAt.of_agree (by rw [monitorCode_length]; decide) (by rw [monitorCode_length]; exact hA) hR.words
    · intro x h1 h2
      have hs : ¬ InStack x := by unfold InStack; omega
      have hp : ¬ InPorts x := by unfold InPorts; omega
      rw [hF x hs hp, hfroz x (Or.inl ⟨h1, h2⟩)]
      exact hR.code x h1 h2
    · rw [hC]; intro i; revert i; decide

/-- **Any number of rounds.** From a `Ready` machine, after any number of rounds and of the host's writes between them,
    the machine is `Ready` again -- the monitor's words in place and the code region the bytes it was loaded with --
    and so a reset and boot start the next round exactly as `monitor_reentry` says. This is what rounds.py runs. -/
theorem monitor_rounds (env : Rv32.Env) (C : Word → Byte) (p q : PrivMachine) (h : Rounds env p q)
    (hR : Ready env C p) : Ready env C q := by
  induction h with
  | refl => exact hR
  | step hr _ ih => exact ih (monitor_round_ready env C _ _ hR hr).1
  | host hw _ ih => exact ih (ready_of_host env C _ _ hR hw)

end Exp240

namespace Exp225
open Rv32

def T1 : Reg := 6
def T2 : Reg := 7
def T3 : Reg := 28
def T4 : Reg := 29
def T5 : Reg := 30

def setup : List Instr := [ .auipc T1 0, .ld .lw T0 T1 0x100, .opi .addi T1 T1 0x200, .opi .addi T2 0 256 ]

/-- One generation, in the register: left, then centre OR right, then XOR. -/
def body : List Instr := [
  .sh .srli T3 T0 1, .sh .slli T4 T0 31, .op .or T3 T3 T4,
  .sh .slli T4 T0 1, .sh .srli T5 T0 31, .op .or T4 T4 T5,
  .op .or T4 T4 T0, .op .xor T0 T3 T4 ]

def stepLine : List Instr := [ .opi .addi T1 T1 4, .opi .addi T2 T2 0xfff ]

def finishLine : List Instr := [ .opi .addi T0 0 1, .opi .addi A0 0 0 ]

def kernel : List Instr :=
  setup ++ body ++ [ .st .sw T1 T0 0 ] ++ stepLine ++ [ .br .bne T2 0 0xfea ] ++ finishLine ++ [ .ecall ]

def bytes : List UInt8 := toBytes kernel

def image : ByteArray := ⟨bytes.toArray⟩

theorem kernel_length : kernel.length = 19 := by decide

/-! ## The specification -/

def SEED : Nat := 0x100
def HIST : Nat := 0x200
def N : Nat := 256

/-- One generation of the ring. -/
def life (x : Word) : Word := (x >>> 1 ||| x <<< 31) ^^^ ((x <<< 1 ||| x >>> 31) ||| x)

/-- Generation `n` from `x`. -/
def gen (x : Word) : Nat → Word
  | 0 => x
  | n + 1 => life (gen x n)

/-- The seed: the word at base + 0x100. -/
def seedOf (m : Word → Byte) (base : Word) : Word := BitVec.ofNat 32 (readLE m (base + BitVec.ofNat 32 SEED) 4)

/-- Byte `d` of the history: generation `d / 4 + 1`, little-endian. -/
def hist (x : Word) (d : Nat) : Byte := BitVec.ofNat 8 ((gen x (d / 4 + 1)).toNat / 256 ^ (d % 4))

/-- Memory after `i` generations: the first `4 i` bytes from 0x200 are the
history, everything else as it was. -/
def lived (m0 : Word → Byte) (base : Word) (i : Nat) : Word → Byte :=
  overlay m0 (base + BitVec.ofNat 32 HIST) (4 * i) (hist (seedOf m0 base))

/-! ## `life` is Rule 30 -/

/-- **Cell by cell, Rule 30**: cell i becomes its left neighbour (i+1) XOR
(itself OR its right neighbour, i-1), round the ring of 32. -/
theorem rule30 (x : Word) (i : Nat) (hi : i < 32) :
    (life x).getLsbD i = (x.getLsbD ((i + 1) % 32) ^^ (x.getLsbD i || x.getLsbD ((i + 31) % 32))) := by
  rcases (by omega : i = 0 ∨ i = 31 ∨ (0 < i ∧ i < 31)) with h | h | ⟨h0, h1⟩
  · subst h; simp [life, Bool.or_comm]
  · subst h; simp [life, Bool.or_comm]
  · have a : (i + 1) % 32 = 1 + i := by omega
    have b : (i + 31) % 32 = i - 1 := by omega
    simp [life, a, b, h1, BitVec.getLsbD_of_ge x (31 + i) (by omega), show ¬ i < 1 by omega]
    cases x.getLsbD i <;> cases x.getLsbD (i - 1) <;> simp <;> omega

/-! ## The loop -/

structure Inv (m0 : Word → Byte) (base : Word) (i : Nat) (st : Machine) : Prop where
  pc : st.pc = base + BitVec.ofNat 32 (4 * (if i < N then 4 else 16))
  x : st.reg T0 = gen (seedOf m0 base) i
  p : st.reg T1 = base + BitVec.ofNat 32 (HIST + 4 * i)
  n : st.reg T2 = BitVec.ofNat 32 (N - i)
  mem : st.mem = lived m0 base i

variable {env : Env} {base : Word}

theorem seg_body : (kernel.drop 4).take body.length = body := by decide
theorem seg_step : (kernel.drop 13).take stepLine.length = stepLine := by decide
theorem seg_finish : (kernel.drop 16).take finishLine.length = finishLine := by decide

theorem body_x (st : Machine) : (st.line body).reg T0 = life (st.reg T0) := by
  simp [body, Machine.line, Machine.alu, reg_setReg, shiftI, aluR, life, T0, T3, T4, T5]

theorem body_keeps (st : Machine) (r : Reg) (h1 : r ≠ T0) (h3 : r ≠ T3) (h4 : r ≠ T4) (h5 : r ≠ T5) :
    (st.line body).reg r = st.reg r :=
  line_keeps st body r (by
    intro i hi; simp only [body, List.mem_cons, List.mem_nil_iff, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp only [rdOf, ne_eq, Option.some.injEq] <;>
      first | exact fun e => h1 e.symm | exact fun e => h3 e.symm | exact fun e => h4 e.symm | exact fun e => h5 e.symm)

theorem lived_code (hfit : base.toNat + 0x10000 ≤ 2^32) {m0 : Word → Byte} (hc : CodeAt m0 base kernel)
    {i : Nat} (hi : i ≤ N) : CodeAt (lived m0 base i) base kernel :=
  code_of_overlay hfit hc (by rw [kernel_length]; decide) (by simp only [N, HIST] at hi ⊢; omega) _

theorem back4 (base : Word) :
    base + BitVec.ofNat 32 (4 * 15) + ((0xfea : BitVec 12) ++ 0#1).signExtend 32 = base + BitVec.ofNat 32 (4 * 4) := by
  rw [BitVec.add_assoc]; congr 1

/-- **One generation**: from the top of generation `i`, twelve instructions
on, the top of generation `i + 1` — or, after the last, the halt. -/
theorem iter (hp : Placed env base) {m0 : Word → Byte} (hc : CodeAt m0 base kernel) {i : Nat} (hi : i < N)
    {st : Machine} (h : Inv m0 base i st) : ∃ st', run env 12 st = .running st' ∧ Inv m0 base (i + 1) st' := by
  have fit := hp.fit
  have hpc : st.pc = base + BitVec.ofNat 32 (4 * 4) := by rw [h.pc]; simp [hi]
  have hcode : CodeAt st.mem base kernel := by rw [h.mem]; exact lived_code fit hc (by omega)
  -- the generation, in t0
  have e1 := run_line (prog := kernel) hp body (by decide) 4 st seg_body (by decide) hcode hpc (by decide)
  have p1 : (st.line body).pc = base + BitVec.ofNat 32 (4 * 12) := line_pc_at body hpc (by decide)
  have x1 : (st.line body).reg T0 = gen (seedOf m0 base) (i + 1) := by rw [body_x, h.x]; rfl
  have t1 : (st.line body).reg T1 = st.reg T1 := body_keeps st T1 (by decide) (by decide) (by decide) (by decide)
  have t2 : (st.line body).reg T2 = st.reg T2 := body_keeps st T2 (by decide) (by decide) (by decide) (by decide)
  -- stored
  obtain ⟨s2, e2, p2, m2, r2⟩ := storeStep (prog := kernel) hp 12 (by decide) (s := st.line body)
    (by rw [line_mem]; exact hcode) p1 (rs1 := T1) (rs2 := T0) (imm := 0) (by decide) (HIST + 4 * i)
    (by rw [t1, h.p]; simp) (by simp only [HIST, N] at hi ⊢; omega) (by simp only [HIST]; omega)
  have mem2 : s2.mem = lived m0 base (i + 1) := by
    rw [m2, line_mem, h.mem]
    funext y
    unfold lived
    rw [show base + BitVec.ofNat 32 (HIST + 4 * i) = base + BitVec.ofNat 32 HIST + BitVec.ofNat 32 (4 * i) by
      rw [BitVec.add_assoc, BitVec.ofNat_add]]
    apply overlay_step
    · rw [toNat_off fit _ (by simp only [HIST]; omega)]; simp only [HIST, N] at hi ⊢; omega
    · intro d hd
      rw [x1]; simp only [hist]
      rw [show (4 * i + d) / 4 = i by omega, show (4 * i + d) % 4 = d by omega]
  have hc2 : CodeAt s2.mem base kernel := by rw [mem2]; exact lived_code fit hc (by omega)
  -- on to the next word, one fewer to go
  have e3 := run_line (prog := kernel) hp stepLine (by decide) 13 s2 seg_step (by decide) hc2
    (by rw [p2]) (by decide)
  have p3 : (s2.line stepLine).pc = base + BitVec.ofNat 32 (4 * 15) := line_pc_at stepLine (by rw [p2]) (by decide)
  have g1 : (s2.line stepLine).reg T1 = s2.reg T1 + (4 : BitVec 12).signExtend 32 := by
    simp [stepLine, Machine.line, Machine.alu, reg_setReg, aluI, T1, T2]
  have g2 : (s2.line stepLine).reg T2 = s2.reg T2 + (0xfff : BitVec 12).signExtend 32 := by
    simp [stepLine, Machine.line, Machine.alu, reg_setReg, aluI, T1, T2]
  have g0 : (s2.line stepLine).reg T0 = s2.reg T0 := by
    simp [stepLine, Machine.line, Machine.alu, reg_setReg, aluI, T0, T1, T2]
  have c1 : (s2.line stepLine).reg T1 = base + BitVec.ofNat 32 (HIST + 4 * (i + 1)) := by
    rw [g1, r2, t1, h.p, show BitVec.signExtend 32 (4 : BitVec 12) = BitVec.ofNat 32 4 by decide, off_add fit _ _ (by simp only [HIST, N] at hi ⊢; omega)]
    congr 2
  have c2 : (s2.line stepLine).reg T2 = BitVec.ofNat 32 (N - (i + 1)) := by
    rw [g2, r2, t2, h.n, show N - i = N - (i + 1) + 1 by simp only [N] at hi ⊢; omega]
    exact dec_one _ (by simp only [N]; omega)
  have c0 : (s2.line stepLine).reg T0 = gen (seedOf m0 base) (i + 1) := by rw [g0, r2, x1]
  have hcl : CodeAt (s2.line stepLine).mem base kernel := by rw [line_mem]; exact hc2
  have tk : taken .bne ((s2.line stepLine).reg T2) ((s2.line stepLine).reg 0) = decide (i + 1 < N) := by
    rw [c2, reg_zero]
    simp only [taken, N] at hi ⊢
    by_cases hl : i + 1 < 256
    · simp only [hl, decide_true, bne_iff_ne, ne_eq]
      intro e; have := congrArg BitVec.toNat e; simp at this; omega
    · simp only [hl, decide_false, bne_eq_false_iff_eq]
      apply BitVec.eq_of_toNat_eq; simp; omega
  have run3 : ∀ st', run env 1 (s2.line stepLine) = .running st' → run env 12 st = .running st' := by
    intro st' e
    rw [show 12 = body.length + (1 + (stepLine.length + 1)) by rfl, run_add_running e1, run_add_running e2,
      run_add_running e3, e]
  by_cases hl : i + 1 < N
  · refine ⟨(s2.line stepLine).setPc ((s2.line stepLine).pc + ((0xfea : BitVec 12) ++ 0#1).signExtend 32),
      run3 _ ((stepK hp 15 (by decide) hcl p3 (i := .br .bne T2 0 0xfea) (by decide)
        (exec_br_taken (by rw [tk]; simp [hl])) 0).trans (run_zero _ _)), ⟨?_, ?_, ?_, ?_, ?_⟩⟩
    · rw [setPc_pc, p3, back4]; simp [hl]
    · rw [setPc_reg, c0]
    · rw [setPc_reg, c1]
    · rw [setPc_reg, c2]
    · rw [setPc_mem, line_mem, mem2]
  · refine ⟨(s2.line stepLine).next,
      run3 _ ((stepK hp 15 (by decide) hcl p3 (i := .br .bne T2 0 0xfea) (by decide)
        (exec_br_not (by rw [tk]; simp [hl])) 0).trans (run_zero _ _)), ⟨?_, ?_, ?_, ?_, ?_⟩⟩
    · rw [next_pc, p3, pc_next fit 15 (by decide)]; simp [hl]
    · rw [next_reg, c0]
    · rw [next_reg, c1]
    · rw [next_reg, c2]
    · rw [next_mem, line_mem, mem2]

/-- All 256 generations, by induction. -/
theorem loop (hp : Placed env base) {m0 : Word → Byte} (hc : CodeAt m0 base kernel) {st : Machine}
    (h : Inv m0 base 0 st) : ∀ j ≤ N, ∃ st', run env (12 * j) st = .running st' ∧ Inv m0 base j st' := by
  intro j hj
  induction j with
  | zero => exact ⟨st, rfl, h⟩
  | succ j ih =>
    obtain ⟨s', e, hs'⟩ := ih (by omega)
    obtain ⟨s'', e', hs''⟩ := iter hp hc (by omega) hs'
    exact ⟨s'', by rw [show 12 * (j + 1) = 12 * j + 12 by omega, run_add_running e, e'], hs''⟩

theorem setup_run (hp : Placed env base) (st : Machine) (hpc : st.pc = base) (hcode : CodeAt st.mem base kernel) :
    ∃ st', run env 4 st = .running st' ∧ Inv st.mem base 0 st' := by
  obtain ⟨s1, e1, p1, m1, r1⟩ := regStep (prog := kernel) hp 0 (by decide) hcode (by simp [hpc])
      (i := .auipc T1 0) (by decide) rfl
  have b1 : s1.reg T1 = base := by rw [reg_wrote r1 (by decide), hpc]; simp
  obtain ⟨s2, e2, p2, m2, r2⟩ := loadStep (prog := kernel) hp 1 (by decide) (by rw [m1]; exact hcode) p1
      (rd := T0) (rs1 := T1) (imm := 0x100) (by decide) SEED (by rw [b1, show BitVec.signExtend 32 (0x100 : BitVec 12) = BitVec.ofNat 32 SEED by decide])
      (by decide) (by decide)
  obtain ⟨s3, e3, p3, m3, r3⟩ := regStep (prog := kernel) hp 2 (by decide) (by rw [m2, m1]; exact hcode) p2
      (i := .opi .addi T1 T1 0x200) (by decide) rfl
  obtain ⟨s4, e4, p4, m4, r4⟩ := regStep (prog := kernel) hp 3 (by decide) (by rw [m3, m2, m1]; exact hcode) p3
      (i := .opi .addi T2 0 256) (by decide) rfl
  refine ⟨s4, ?_, ⟨by rw [p4]; rfl, ?_, ?_, ?_, ?_⟩⟩
  · rw [show 4 = 1 + (1 + (1 + 1)) by rfl]; exact run_cons e1 (run_cons e2 (run_cons e3 e4))
  · rw [reg_kept r4 (by decide), reg_kept r3 (by decide), reg_wrote r2 (by decide), m1]; rfl
  · rw [reg_kept r4 (by decide), reg_wrote r3 (by decide)]
    simp only [aluI]; rw [reg_kept r2 (by decide), b1, show BitVec.signExtend 32 (0x200 : BitVec 12) = BitVec.ofNat 32 (HIST + 4 * 0) by decide]
  · rw [reg_wrote r4 (by decide)]; simp [aluI, N]
  · rw [m4, m3, m2, m1]; simp [lived, overlay_zero]

/-- HALT, at the `ecall`, with `t0 = 1`. -/
theorem halts_at (hp : Placed env base) {st : Machine} (hcode : CodeAt st.mem base kernel)
    (hpc : st.pc = base + BitVec.ofNat 32 (4 * 18)) (ht0 : st.reg T0 = 1) :
    run env 1 st = .halted (st.reg A0) st := by
  have hk' : 18 < kernel.length := by rw [kernel_length]; decide
  have hi : kernel.getD 18 .ecall = .ecall := by decide
  have : kernel[18] = .ecall := by rw [← hi]; simp [List.getD_eq_getElem?_getD, hk']
  exact run_code_halt 0 hk' hcode hpc (by rw [hpc]; exact align_off hp.align hp.fit _ (by omega) (by omega))
    (by rw [hpc]; exact ok_off hp _ 4 (by omega) (by omega)) (by rw [this]; exact exec_halt ht0)

theorem finish_run (hp : Placed env base) {m0 : Word → Byte} (hc : CodeAt m0 base kernel) {st : Machine}
    (h : Inv m0 base N st) :
    ∃ s1 st', run env 2 st = .running s1 ∧ run env 1 s1 = .halted 0 st' ∧ st'.mem = lived m0 base N := by
  have hpc : st.pc = base + BitVec.ofNat 32 (4 * 16) := by rw [h.pc]; rfl
  have hcode : CodeAt st.mem base kernel := by rw [h.mem]; exact lived_code hp.fit hc (by decide)
  have e1 := run_line (prog := kernel) hp finishLine (by decide) 16 st seg_finish (by decide) hcode hpc (by decide)
  have p1 : (st.line finishLine).pc = base + BitVec.ofNat 32 (4 * 18) := line_pc_at finishLine hpc (by decide)
  have t1 : (st.line finishLine).reg T0 = 1 := by
    simp [finishLine, Machine.line, Machine.alu, reg_setReg, aluI, T0, A0]
  have a1 : (st.line finishLine).reg A0 = 0 := by
    simp [finishLine, Machine.line, Machine.alu, reg_setReg, aluI, T0, A0]
  have e2 := halts_at hp (st := st.line finishLine) (by rw [line_mem]; exact hcode) p1 t1
  rw [a1] at e2
  exact ⟨_, _, e1, e2, by rw [line_mem, h.mem]⟩

/-- Setup, 256 generations and the two instructions before the `ecall`: 3078
instructions, and the machine they leave. -/
theorem to_the_ecall (hp : Placed env base) (st : Machine) (hpc : st.pc = base) (hcode : CodeAt st.mem base kernel) :
    ∃ s1 st', run env 3078 st = .running s1 ∧ run env 1 s1 = .halted 0 st' ∧ st'.mem = lived st.mem base N := by
  obtain ⟨s0, e0, i0⟩ := setup_run hp st hpc hcode
  obtain ⟨sN, eN, iN⟩ := loop hp hcode i0 N (Nat.le_refl _)
  obtain ⟨s1, st', e2, e1, m⟩ := finish_run hp hcode iN
  exact ⟨s1, st', by rw [show 3078 = 4 + (12 * N + 2) by rfl, run_add_running e0, run_add_running eN, e2], e1, m⟩

/-- **The kernel lives.** From `base`, with the kernel's bytes there, it halts
with 0 after exactly 3079 instructions; the 1024 bytes from 0x200 are then
generations 1 to 256 of Rule 30 from the seed at 0x100, and every other byte
is what it was. For every `base` the region fits at, every value of every
byte, every register. -/
theorem lives (hp : Placed env base) (st : Machine) (hpc : st.pc = base) (hcode : CodeAt st.mem base kernel) :
    ∃ st', run env 3079 st = .halted 0 st' ∧ st'.mem = lived st.mem base N := by
  obtain ⟨s1, st', e, e1, m⟩ := to_the_ecall hp st hpc hcode
  exact ⟨st', by rw [show 3079 = 3078 + 1 by rfl, run_add_running e, e1], m⟩

/-- **And not before**: after 3078 it is still running, whatever the seed. -/
theorem not_before (hp : Placed env base) (st : Machine) (hpc : st.pc = base) (hcode : CodeAt st.mem base kernel) :
    ∃ s1, run env 3078 st = .running s1 := by
  obtain ⟨s1, -, e, -, -⟩ := to_the_ecall hp st hpc hcode
  exact ⟨s1, e⟩

/-! ## The bytes are the kernel -/

theorem bytes_words : ∀ k (h : k < kernel.length),
    (bytes.getD (4 * k) 0).toNat + 256 * (bytes.getD (4 * k + 1) 0).toNat
      + 65536 * (bytes.getD (4 * k + 2) 0).toNat + 16777216 * (bytes.getD (4 * k + 3) 0).toNat
      = (encode kernel[k]).toNat := by
  decide

/-- **From the state the shell builds**: any image that begins with the
kernel's 76 bytes, the seed at 0x100. -/
theorem from_boot (hp : Placed env base) (img : ByteArray) (hsize : 76 ≤ img.size)
    (himg : ∀ d (h : d < 76), img.get d (by omega) = bytes.getD d 0) :
    let m0 := memOfImage base img
    (∃ s1, run env 3078 (boot env.region img) = .running s1) ∧
    ∃ st', run env 3079 (boot env.region img) = .halted 0 st' ∧ st'.mem = lived m0 base N := by
  intro m0
  have hpc : (boot env.region img).pc = base := by simp [boot, hp.region]
  have hmem : (boot env.region img).mem = m0 := by simp [boot, hp.region, m0]
  have hcode : CodeAt (boot env.region img).mem base kernel := by
    rw [hmem]
    exact code_of_image hp.fit (by decide) bytes_words img (by rw [kernel_length]; exact hsize)
      (fun d h => himg d (by rw [kernel_length] at h; exact h))
  refine ⟨not_before hp _ hpc hcode, ?_⟩
  obtain ⟨st', e, m⟩ := lives hp _ hpc hcode
  rw [hmem] at m
  exact ⟨st', e, m⟩


end Exp225

namespace Exp253
open Rv32 Rv32.Ct Rv32.Reach

/-- One run: every place public, so the checker refuses nothing for being secret. -/
def P : List (Nat × Nat) := [(0, 0x10000)]

/-- A state where the registers named are known, and the rest are whatever they are. -/
def known (o : List (Nat × AV)) : AState :=
  (List.range 32).map fun n => match o.find? (fun p => p.1 == n) with
    | some (_, v) => v
    | none => .pub

/-- The loop's head, at instruction 4: `t1` (x6) is where the next generation goes, `base + 0x600 - 4 · t2`, with
`t2` (x7) the generations to go, 1 to 256. -/
def heads : Heads := [(4, known [(6, .aff 7 (-4) 0x600), (7, .num 1 256)])]

/-- The seed, the one word the kernel loads: `[base + 0x100, base + 0x104)`. -/
def seed : Nat × Nat := (0x100, 0x104)

/-- The history, where it stores: `[base + 0x200, base + 0x600)`, 256 words. -/
def history : Nat × Nat := (0x200, 0x600)

set_option maxRecDepth 100000 in
theorem accepted : check Exp225.kernel P heads = true := by decide

set_option maxRecDepth 100000 in
theorem windows : windowed Exp225.kernel P heads seed history = true := by decide

set_option maxRecDepth 100000 in
theorem halts_only : haltsOnly Exp225.kernel P heads = true := by decide

/-- **Every step the kernel takes.** From its first word, wherever it is `Hosted`: every state of the run is `Good`
-- at one of its 19 instructions, the kernel in memory, a load only of the seed, a store only into the history, an
`ecall` only with `t0 = 1`. -/
theorem life_reach {env : Env} {base : Word} (hp : Hosted env base Exp225.kernel.length) {s : Machine}
    (hpc : s.pc = base) (hcode : CodeAt s.mem base Exp225.kernel) :
    ∀ n m, run env n s = .running m → Good env base Exp225.kernel seed history m :=
  reach hp accepted windows halts_only (by decide) hpc hcode

/-- **exp225's run, and every step of it.** In its own 64 KiB: HALT 0 after exactly 3079 instructions with the
history Rule 30's, as exp225 proved; every state on the way is `Good`; and memory outside the history is as it was. -/
theorem life_whole {env : Env} {base : Word} (hp : Placed env base) {s : Machine} (hpc : s.pc = base)
    (hcode : CodeAt s.mem base Exp225.kernel) :
    ∃ s', run env 3079 s = .halted 0 s' ∧ s'.mem = Exp225.lived s.mem base Exp225.N ∧
      (∀ n m, run env n s = .running m → Good env base Exp225.kernel seed history m ∧
        ∀ x : Word, ¬ (base.toNat + 0x200 ≤ x.toNat ∧ x.toNat < base.toNat + 0x600) → m.mem x = s.mem x) := by
  have hh : Hosted env base Exp225.kernel.length := hp.hosted (by rw [Exp225.kernel_length]; decide)
  obtain ⟨s', h, hm⟩ := Exp225.lives hp s hpc hcode
  refine ⟨s', h, hm, fun n m hm' => ⟨life_reach hh hpc hcode n m hm', fun x hx => ?_⟩⟩
  exact frame hp.fit (by decide) n s m (fun i _ m' h' => life_reach hh hpc hcode i m' h') hm' x hx

end Exp253

/-! # exp254 — exp225's kernel behind exp240's monitor

exp240 boxes its payload with no byte both writable and runnable, and proves the monitor boots, runs whatever the
payload is up to its first trap, and parks. exp225 proves its kernel halts with Rule 30's history, in a 64 KiB region
of Tier 1. exp253 proves where every step of that run fetches, loads and stores. Here the three are one run: from
reset, the kernel's 3079 steps are the Tier 2 steps one for one, every one let through by the box, and the monitor
parks with HALT 0 and the history in memory. -/

namespace Exp254
open Rv32 Rv32.Priv Rv32.Refinement Rv32.Join Rv32.Reach Exp240

/-- The kernel's first word: the start of exp240's code entry. -/
abbrev base : Word := 0x80010000#32

/-- The kernel's world: Tier 2's, with the region its 64 KiB, `[0x80010000, 0x80020000)`. -/
def kenv (env : Rv32.Env) : Rv32.Env := boxEnv env 0x80010000 0x80020000

theorem placed (env : Rv32.Env) : Placed (kenv env) base := ⟨by decide, by decide, rfl⟩

theorem within (env : Rv32.Env) (henv : env.region = monRegion) :
    Region.within ⟨0x80010000, 0x80020000⟩ env.region := by
  rw [henv]; exact ⟨by decide, by decide⟩

/-- **Every step exp253 vouches for is one exp240's box lets through.** The kernel's 76 bytes are in the code entry,
`[0x80010000, 0x80010080)`; the seed and the history are in the data entry, `[0x80010000, 0x80011000)`, past the
code. -/
theorem wx_ok {env : Rv32.Env} {m : Machine} (hg : Good (kenv env) base Exp225.kernel Exp253.seed Exp253.history m) :
    WxOk 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 m := by
  refine wxOk_of_good (by decide) hg (by rw [Exp225.kernel_length]; decide) (by rw [Exp225.kernel_length]; decide)
    ⟨by decide, fun o w h1 h2 _ => ?_⟩ ⟨by decide, fun o w h1 h2 _ => ?_⟩
  · simp only [Exp253.seed] at h1 h2
    simp only [WxReadable, WxWritable, BitVec.toNat_ofNat]
    omega
  · simp only [Exp253.history] at h1 h2
    simp only [WxWritable, BitVec.toNat_ofNat]
    omega

/-- **The payload's run, to its trap.** From where boot leaves the machine -- W^X-boxed at the kernel's first word,
the CSRs `csrsBooted`, the kernel in the code, the monitor's words in place -- the kernel's 3079 steps are 3079 Tier
2 steps: every one before the last in U-mode, and the last the `ecall` that traps. At the trap vector: cause 8, `t0 =
1`, `a0 = 0`, both counters at 3081 (boot's 2 and the kernel's 3079), memory exp225's `lived` -- the history Rule
30's -- and no port touched. -/
theorem life_traps (env : Rv32.Env) (M0 : Word → Byte) (s1 : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hA : Agree M0 s1.core.mem 0x80000000 604)
    (henv : env.region = monRegion)
    (hbox : WXBoxed s1 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000)
    (hcs : s1.csrs = csrsBooted) (hpc : s1.core.pc = base) (hcode : CodeAt s1.core.mem base Exp225.kernel) :
    (∀ i, i < 3079 → (PrivMachine.run env i s1).mode = .U) ∧
    (PrivMachine.run env 3079 s1).mode = .M ∧ HState env M0 (PrivMachine.run env 3079 s1) ∧
    (PrivMachine.run env 3079 s1).core.pc = 0x80000134#32 ∧
    (PrivMachine.run env 3079 s1).csrs = csrsH (PrivMachine.run env 3079 s1).csrs.mstatus
      (PrivMachine.run env 3079 s1).csrs.mepc 8#32 3081#32 3081#32 {} 0x80008000#32 ∧
    (PrivMachine.run env 3079 s1).core.reg 5#5 = 1#32 ∧ (PrivMachine.run env 3079 s1).core.reg 10#5 = 0#32 ∧
    (PrivMachine.run env 3079 s1).core.mem = Exp225.lived s1.core.mem base Exp225.N ∧
    (PrivMachine.run env 3079 s1).io = s1.io ∧ (PrivMachine.run env 3079 s1).host = s1.host := by
  have hp := placed env
  have hR := within env henv
  obtain ⟨c, c', e, e1, hlived⟩ := Exp225.to_the_ecall hp s1.core hpc hcode
  obtain ⟨-, -, -, hall⟩ := Exp253.life_whole hp hpc hcode
  have hq : ∀ i < 3078, ∀ m, run (kenv env) i s1.core = .running m →
      (decode (fetched m) = some .ecall → m.reg T0 = 1) ∧
      WxOk 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 m :=
    fun i _ m hm => ⟨quiet_of_good (hall i m hm).1, wx_ok (hall i m hm).1⟩
  have hc := (wx_ok (hall 3078 c e).1).1
  have hh1 : run (kenv env) (3078 + 1) s1.core = .halted 0 c' := by rw [run_add_running e, e1]
  have hinh : s1.csrs.mcountinhibit = {} := by rw [hcs]; rfl
  obtain ⟨t1, t2, t3, t4, t5, t6, t7, t8, t9, -, t11, t12, t13, t14, t15⟩ :=
    wx_halt_in_box env hR 3078 s1 hbox hinh e hh1 hq hc
  -- before the trap, every state is the boxed one `wx_run_in_box` describes
  have hU : ∀ i, i < 3079 → (PrivMachine.run env i s1).mode = .U := by
    intro i hi
    obtain ⟨m, hm⟩ := run_running_prefix (env := kenv env) i (3078 - i) s1.core
      (by rw [Nat.add_sub_cancel' (by omega)]; exact e)
    exact (wx_run_in_box env hR i s1 m hbox hinh hm (fun j hj => hq j (by omega))).2.1.isUMode
  have hmem : (PrivMachine.run env 3079 s1).core.mem = Exp225.lived s1.core.mem base Exp225.N := by
    rw [t5, ← hlived, t8]
  have hagree : Agree M0 (PrivMachine.run env 3079 s1).core.mem 0x80000000 604 := by
    intro x h1 h2
    rw [t5, (hall 3078 c e).2 x (by simp only [BitVec.toNat_ofNat]; omega)]
    exact hA x h1 h2
  obtain ⟨k1, k2, k3, k4, k5, k6, k7, k8⟩ := t11
  rw [hcs] at k1 k2 k3 k4 k5 k6 k7 k8 t3 t12 t13
  have hcsu := csrs_eq_csrsH _ k1 k2 k3 k4 k5 k6 k7 k8
  rw [t9, t12, t13] at hcsu
  refine ⟨hU, t1, ⟨hW, hagree, henv, t2, t1⟩, ?_, hcsu, by rw [t4]; exact t6, by rw [t4]; exact t7, hmem, t14, t15⟩
  rw [t3]; decide

/-- **exp225's life, behind exp240's box.** From reset -- or from any CSRs that lock no PMP entry -- with exp240's
monitor at `0x80000000` and exp225's kernel at `0x80010000`: after exactly 61 + 3079 + 57 steps the monitor is parked
with HALT 0, every register but `a0` zero. Memory but the monitor's stack and report words is exp225's `lived`:
the 1024 bytes from `0x80010200` generations 1 to 256 of Rule 30 from the seed at `0x80010100`, every other byte as it
was. And the host has heard the HALT report -- the tag, `a0 = 0`, 3081 instructions and 3081 cycles -- then 0 at the
exit word, and nothing before. -/
theorem life_behind_the_box (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hK : CodeAt M0 base Exp225.kernel)
    (hmem : s.core.mem = M0) (hpc : s.core.pc = 0x80000040#32) (hh : s.halted = false) (hm : s.mode = .M)
    (hlock : PmpUnlocked s.csrs.pmpcfg0) (henv : env.region = monRegion) :
    Parked (PrivMachine.run env (61 + 3079 + 57) s) 0#32 ∧
    (∀ x, ¬ InStack x → ¬ InPorts x →
      (PrivMachine.run env (61 + 3079 + 57) s).core.mem x = Exp225.lived M0 base Exp225.N x) ∧
    (PrivMachine.run env (61 + 3079 + 57) s).io = s.io ++
      [⟨0xc0000004#32, 0x48414c54#32⟩, ⟨0xc0000004#32, 0#32⟩, ⟨0xc0000004#32, 3081#32⟩,
       ⟨0xc0000004#32, 3081#32⟩, ⟨0xc0000008#32, 0#32⟩] := by
  obtain ⟨hbox, hpc1, hcsb, hmem1, -, hio1, -⟩ := monitor_boot env M0 s hW hmem hpc hh hm hlock
  obtain ⟨-, hM, hS, hpcu, hcsu, ht0, ha0, hmu, hiou, -⟩ :=
    life_traps env M0 _ hW (by rw [hmem1]; exact Agree.refl _ _ _) henv hbox hcsb hpc1 (by rw [hmem1]; exact hK)
  rw [PrivMachine.run_add, PrivMachine.run_add]
  obtain ⟨hP, -, hF, -, -, hio⟩ := monitor_traps env M0 _ hS _ _ _ _ _ hpcu hcsu
  have hmc : (PrivMachine.run env 3079 (PrivMachine.run env 61 s)).csrs.mcause = 8#32 := by rw [hcsu]; rfl
  have hn : trapSteps (PrivMachine.run env 3079 (PrivMachine.run env 61 s)) = 57 := by
    simp [trapSteps, hmc, ht0]
  have hx : exitCode (PrivMachine.run env 3079 (PrivMachine.run env 61 s)) = 0#32 := by
    simp [exitCode, hmc, ht0, ha0]
  rw [hn, hx] at hP
  rw [hn] at hF hio
  refine ⟨hP, fun x hs hp => ?_, ?_⟩
  · rw [hF x hs hp, hmu, hmem1]
  · have hmi : (PrivMachine.run env 3079 (PrivMachine.run env 61 s)).csrs.minstret = 3081#32 := by rw [hcsu]; rfl
    have hmy : (PrivMachine.run env 3079 (PrivMachine.run env 61 s)).csrs.mcycle = 3081#32 := by rw [hcsu]; rfl
    rw [hio, hiou, hio1]
    simp [trapIo, haltIo, exitCode, hmc, ht0, ha0, hmi, hmy]

end Exp254

