      else if s.length = 0 then .next ⟨pc, [] :: r, c.sigs⟩
      else if s.length ≠ 64 then .done C_SIZE
      else if c.sigs ≠ 0 then .done C_COUNT
      else if env.sig pk s then .next ⟨pc, [1] :: r, 1⟩
      else .done C_INVALID
    | _ => .done C_UNDER
  else .done C_BAD

/-- The end: exactly one element, and true. -/
def finish (st : List Elem) : Nat :=
  match st with
  | [e] => if cast e then C_OK else C_FALSE
  | _ => C_CLEAN

/-- At most `n` opcodes, then the end; every opcode moves `pc` on. -/
def runS (env : Env) (scr : List Byte) : Nat → Cfg → Nat
  | 0, _ => C_CLEAN
  | n + 1, c =>
    if c.pc < scr.length then
      match stepOp env scr c with
      | .next c' => runS env scr n c'
      | .done k => k
    else finish c.st

/-- **What the kernel halts with**, for a script and the stack it starts with
(top first). -/
def verdict (env : Env) (scr : List Byte) (st : List Elem) : Nat :=
  runS env scr (scr.length + 1) ⟨0, st, 0⟩

