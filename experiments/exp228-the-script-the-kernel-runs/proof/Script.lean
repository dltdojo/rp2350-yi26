/-- Hex to bytes. -/
def unhex (s : String) : List Rv32.Byte :=
  let d (c : Char) : Nat := if c.isDigit then c.toNat - '0'.toNat else c.toLower.toNat - 'a'.toNat + 10
  let cs := s.toList
  (List.range (cs.length / 2)).map fun i => BitVec.ofNat 8 (16 * d (cs.getD (2 * i) '0') + d (cs.getD (2 * i + 1) '0'))

/-- SHA-256, for `spec` runs only — no theorem here mentions it. -/
def sha (input : List Rv32.Byte) (d : Fin 32) : Rv32.Byte :=
  BitVec.ofNat 8 (Sha256.digest ⟨(input.map fun b => b.toNat.toUInt8).toArray⟩)[d.val]!.toNat

/-- `spec CASES`: the specification's verdict for each line of CASES —
`script | element element … | key signature key signature …`, every field
hex, `-` for an empty one, the stack bottom first — with `env.hash` SHA-256 and
`env.sig` true for exactly the pairs listed. The specification itself, run, so
that script.py can be held to it before any proof is. -/
def specMain (path : String) : IO Unit := do
  for line in (← IO.FS.readFile path).splitOn "\n" do
    match line.splitOn "|" with
    | [scr, stk, sg] =>
      let field (w : String) : List Rv32.Byte := if w = "-" then [] else unhex w
      let words (t : String) := ((t.splitOn " ").filter (· ≠ "")).map field
      let sigs := words sg
      let pairs := (List.range (sigs.length / 2)).map fun i => (sigs.getD (2 * i) [], sigs.getD (2 * i + 1) [])
      let env : Rv32.Env := { region := ⟨0, 0⟩, hash := sha, sig := fun pk s => pairs.contains (pk, s) }
      IO.println (Exp228.verdict env ((words scr).headD []) (words stk).reverse)
    | _ => pure ()

def main (args : List String) : IO Unit := do
  match args with
  | ["spec", path] => specMain path
  | [out] =>
    IO.FS.writeBinFile out Exp228.image
    for (i, k) in Exp228.kernel.zipIdx do
      IO.println s!"  {Rv32.hex8 (4 * k) |>.drop 4}  {Rv32.hex8 (Rv32.encode i).toNat}  {i.toAsm}"
  | _ => pure ()
