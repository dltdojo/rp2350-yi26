    | b :: a :: r =>
      match decode b, decode a with
      | some y, some x => .next ⟨pc, encode (if op = 0x93 then x + y else x - y) :: r, c.sigs⟩
      | _, _ => .done C_NUM
    | _ => .done C_UNDER
  else if op = 0xa8 then
    match c.st with
    | a :: r => .next ⟨pc, List.ofFn (env.hash a) :: r, c.sigs⟩
    | _ => .done C_UNDER
