    (hpc : s.core.pc = 0x80000134#32) (hcs : s.csrs = csrsH ms e c m cy {} (0x80008000#32)) (hc : c = 8#32) (ht0 : s.core.reg 5#5 ≠ 1#32) :
    (PrivMachine.run env 62 s).core.pc = 0x80000254#32 ∧
    Agree M0 (PrivMachine.run env 62 s).core.mem 0x80000000 604 ∧
    (PrivMachine.run env 62 s).halted = false ∧
    (PrivMachine.run env 62 s).mode = .M ∧
    (PrivMachine.run env 62 s).csrs = csrsH ms e c m cy { cy := true, ir := true } (0#32) ∧
    (PrivMachine.run env 62 s).host = s.host ∧
    (PrivMachine.run env 62 s).io = s.io ++ [⟨0xc0000004#32, 0x4641554c#32⟩, ⟨0xc0000004#32, c⟩, ⟨0xc0000004#32, e⟩, ⟨0xc0000004#32, 0#32⟩, ⟨0xc0000004#32, m⟩, ⟨0xc0000008#32, 1#32⟩] ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x80008000#32 4 = 0 ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x80008004#32 4 = 0 ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x80008008#32 4 = readLE s.core.mem 0x80008008#32 4 ∧
    readLE (PrivMachine.run env 62 s).core.mem 0x8000800c#32 4 = readLE s.core.mem 0x8000800c#32 4 ∧
    SvcSame s.core.mem (PrivMachine.run env 62 s).core.mem ∧
    Frame s.core.mem (PrivMachine.run env 62 s).core.mem ∧
    (∀ r, (PrivMachine.run env 62 s).core.reg r = regsUpd s.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32), (10, 1#32)] r) := by
  have p0 := hpc
  have c0 := hcs
  have hS0 := hS
  obtain ⟨s1, hs1⟩ : ∃ t, PrivMachine.run env 7 s = t := ⟨_, rfl⟩
  obtain ⟨p1, a1, h1, m1, c1, ho1, io1, w1_0, w1_1, w1_2, w1_3, sv1, fr1, r1⟩ := monitor_enter env M0 s hS0 ms e c m cy p0 c0
  rw [hs1] at p1 a1 h1 m1 c1 ho1 io1 w1_0 w1_1 w1_2 w1_3 sv1 fr1 r1
  have sv1_0 : readLE s1.core.mem 0xc0000010#32 4 = readLE s.core.mem 0xc0000010#32 4 := SvcSame.read sv1 _ (by decide)
  have sv1_1 : readLE s1.core.mem 0xc0000014#32 4 = readLE s.core.mem 0xc0000014#32 4 := SvcSame.read sv1 _ (by decide)
  have sv1_2 : readLE s1.core.mem 0xc0000018#32 4 = readLE s.core.mem 0xc0000018#32 4 := SvcSame.read sv1 _ (by decide)
  have sv1_3 : readLE s1.core.mem 0xc000001c#32 4 = readLE s.core.mem 0xc000001c#32 4 := SvcSame.read sv1 _ (by decide)
  simp [hc, regsUpd] at p1
  have hS1 := hS0.next a1 h1 m1
  obtain ⟨s2, hs2⟩ : ∃ t, PrivMachine.run env 3 s1 = t := ⟨_, rfl⟩
  obtain ⟨p2, a2, h2, m2, c2, ho2, io2, w2_0, w2_1, w2_2, w2_3, sv2, fr2, r2⟩ := call_is_halt env M0 s1 hS1 ms e c m cy (s.core.reg 2#5) ((s.core.reg 5#5).toNat % 4294967296) p1 c1 (by simp [r1, regsUpd, hc, ht0]) w1_0
  rw [hs2] at p2 a2 h2 m2 c2 ho2 io2 w2_0 w2_1 w2_2 w2_3 sv2 fr2 r2
  have sv2_0 : readLE s2.core.mem 0xc0000010#32 4 = readLE s1.core.mem 0xc0000010#32 4 := SvcSame.read sv2 _ (by decide)
  have sv2_1 : readLE s2.core.mem 0xc0000014#32 4 = readLE s1.core.mem 0xc0000014#32 4 := SvcSame.read sv2 _ (by decide)
  have sv2_2 : readLE s2.core.mem 0xc0000018#32 4 = readLE s1.core.mem 0xc0000018#32 4 := SvcSame.read sv2 _ (by decide)
  have sv2_3 : readLE s2.core.mem 0xc000001c#32 4 = readLE s1.core.mem 0xc000001c#32 4 := SvcSame.read sv2 _ (by decide)
  simp [ofNat_toNat_mod, ht0, regsUpd] at p2
  have hS2 := hS1.next a2 h2 m2
  obtain ⟨s3, hs3⟩ : ∃ t, PrivMachine.run env 18 s2 = t := ⟨_, rfl⟩
  obtain ⟨p3, a3, h3, m3, c3, ho3, io3, w3_0, w3_1, w3_2, w3_3, sv3, fr3, r3⟩ := monitor_fault_exit env M0 s2 hS2 ms e c m cy (s.core.reg 2#5) p2 c2 (by simp [r2, r1, regsUpd, hc, ht0])
  rw [hs3] at p3 a3 h3 m3 c3 ho3 io3 w3_0 w3_1 w3_2 w3_3 sv3 fr3 r3
  have sv3_0 : readLE s3.core.mem 0xc0000010#32 4 = readLE s2.core.mem 0xc0000010#32 4 := SvcSame.read sv3 _ (by decide)
  have sv3_1 : readLE s3.core.mem 0xc0000014#32 4 = readLE s2.core.mem 0xc0000014#32 4 := SvcSame.read sv3 _ (by decide)
  have sv3_2 : readLE s3.core.mem 0xc0000018#32 4 = readLE s2.core.mem 0xc0000018#32 4 := SvcSame.read sv3 _ (by decide)
  have sv3_3 : readLE s3.core.mem 0xc000001c#32 4 = readLE s2.core.mem 0xc000001c#32 4 := SvcSame.read sv3 _ (by decide)
  have hS3 := hS2.next a3 h3 m3
  obtain ⟨s4, hs4⟩ : ∃ t, PrivMachine.run env 34 s3 = t := ⟨_, rfl⟩
  obtain ⟨p4, a4, h4, m4, c4, ho4, io4, w4_0, w4_1, w4_2, w4_3, sv4, fr4, r4⟩ := monitor_regs env M0 s3 hS3 ms e c m cy p3 c3
  rw [hs4] at p4 a4 h4 m4 c4 ho4 io4 w4_0 w4_1 w4_2 w4_3 sv4 fr4 r4
  have sv4_0 : readLE s4.core.mem 0xc0000010#32 4 = readLE s3.core.mem 0xc0000010#32 4 := SvcSame.read sv4 _ (by decide)
  have sv4_1 : readLE s4.core.mem 0xc0000014#32 4 = readLE s3.core.mem 0xc0000014#32 4 := SvcSame.read sv4 _ (by decide)
  have sv4_2 : readLE s4.core.mem 0xc0000018#32 4 = readLE s3.core.mem 0xc0000018#32 4 := SvcSame.read sv4 _ (by decide)
  have sv4_3 : readLE s4.core.mem 0xc000001c#32 4 = readLE s3.core.mem 0xc000001c#32 4 := SvcSame.read sv4 _ (by decide)
  have hall : PrivMachine.run env 62 s = s4 := run_two hs1 (run_two hs2 (run_two hs3 (hs4)))
  rw [hall]
  refine ⟨p4, a4, h4, m4, c4, ?ho, ?io, ?w0, ?w1, ?w2, ?w3, ?sv, ?fr, ?r⟩
  case ho => exact (ho4.trans (ho3.trans (ho2.trans ho1)))
  case io => simp [io4, io3, io2, io1, ho4, ho3, ho2, ho1, List.append_assoc, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w0 => simp [w4_0, w3_0, w2_0, w1_0, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w1 => simp [w4_1, w3_1, w2_1, w1_1, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w2 => simp [w4_2, w3_2, w2_2, w1_2, r4, r3, r2, r1, regsUpd, hc, ht0]
  case w3 => simp [w4_3, w3_3, w2_3, w1_3, r4, r3, r2, r1, regsUpd, hc, ht0]
  case sv => exact (sv1.trans (sv2.trans (sv3.trans sv4)))
  case fr => exact (fr1.trans (fr2.trans (fr3.trans fr4)))
  case r =>
    intro r
    have hr32 : r = 0#5 ∨ r = 1#5 ∨ r = 2#5 ∨ r = 3#5 ∨ r = 4#5 ∨ r = 5#5 ∨ r = 6#5 ∨ r = 7#5 ∨ r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 ∨ r = 16#5 ∨ r = 17#5 ∨ r = 18#5 ∨ r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨ r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 ∨ r = 31#5 := by bv_omega
    rcases hr32 with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp [w4_0, w4_1, w4_2, w4_3, w3_0, w3_1, w3_2, w3_3, w2_0, w2_1, w2_2, w2_3, w1_0, w1_1, w1_2, w1_3, ofNat_toNat_mod, r4, r3, r2, r1, regsUpd, hc, ht0]


theorem reg32 (r : Reg) : r = 0#5 ∨ r = 1#5 ∨ r = 2#5 ∨ r = 3#5 ∨ r = 4#5 ∨ r = 5#5 ∨ r = 6#5 ∨ r = 7#5 ∨ r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 ∨ r = 16#5 ∨ r = 17#5 ∨ r = 18#5 ∨ r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨ r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 ∨ r = 31#5 := by bv_omega

/-- The register scrub of a HALT: every register but `a0` zero, `a0` as it was. -/
theorem regs_scrubbed {u t : PrivMachine} (q : ∀ r, t.core.reg r = regsUpd u.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32)] r) :
    t.core.reg 10#5 = u.core.reg 10#5 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32 := by
  refine ⟨?_, ?_⟩
  · rw [q 10#5]; simp [regsUpd]
  · intro r hr
    rw [q r]
    rcases reg32 r with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> first | (exfalso; exact hr rfl) | simp [regsUpd]

/-- The register scrub of a fault: `a0` is 1, every other register zero. -/
theorem regs_scrubbed_fault {u t : PrivMachine} (q : ∀ r, t.core.reg r = regsUpd u.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32), (10, 1#32)] r) :
    t.core.reg 10#5 = 1#32 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32 := by
  refine ⟨?_, ?_⟩
  · rw [q 10#5]; simp [regsUpd]
  · intro r hr
    rw [q r]
    rcases reg32 r with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> first | (exfalso; exact hr rfl) | simp [regsUpd]



/-! ## However the payload leaves, the monitor parks -/

/-- **A trap, and what the monitor makes of it.** From the trap vector, whatever the payload left in its registers
    and memory, and whatever it was that trapped -- an `ecall` for HALT, an `ecall` for anything else, or a fault --
    the monitor parks with the exit code `exitCode u` (the payload's own `a0` for a HALT, 1 for the rest), every other
    register zero, `mscratch` and the saved words zero, its own words in place, and **every byte of memory but its stack
    words and its report words as the payload left it**: the code, the data, the stack, the rest; the PMP as boot set it;
    and the host has heard `trapIo u`, the report for the way it trapped and then the exit code. -/
theorem monitor_traps (env : Rv32.Env) (M0 : Word → Byte) (u : PrivMachine)
    (hS : HState env M0 u) (ms : MStatus) (e c m cy : Word)
    (hpc : u.core.pc = 0x80000134#32) (hcs : u.csrs = csrsH ms e c m cy {} 0x80008000#32) :
    Parked (PrivMachine.run env (trapSteps u) u) (exitCode u) ∧
      Agree M0 (PrivMachine.run env (trapSteps u) u).core.mem 0x80000000 604 ∧
      FrameSP u.core.mem (PrivMachine.run env (trapSteps u) u).core.mem ∧
      (PrivMachine.run env (trapSteps u) u).csrs.pmpcfg0 = 0x001b1b1d#32 ∧
      (PrivMachine.run env (trapSteps u) u).host = u.host ∧
      (PrivMachine.run env (trapSteps u) u).io = u.io ++ trapIo u := by
  have hcu : u.csrs.mcause = c := by rw [hcs]; rfl
  by_cases hc : c = 8#32
  · by_cases ht0 : u.core.reg 5#5 = 1#32
    · -- an `ecall` for HALT
      obtain ⟨p, a, h, m', cc, ho, io, w0, w1, w2, w3, sv, fr, r⟩ := monitor_halt env M0 u hS ms e c m cy hpc hcs hc ht0
      obtain ⟨k1, k2⟩ := regs_scrubbed r
      have hn : trapSteps u = 57 := by simp [trapSteps, hcu, hc, ht0]
      rw [hn]
      refine ⟨⟨p, h, m', by rw [cc]; rfl, w0, w1, ?_, k2⟩, a, frameSP_of fr sv, by rw [cc]; rfl, ho, ?_⟩
      · rw [k1]
        simp [exitCode, hcu, hc, ht0]
      · rw [io]
        simp [trapIo, faultIo, haltIo, exitCode, hcs, csrsH, hcu, hc, ht0]
    · -- an `ecall` for anything else
      obtain ⟨p, a, h, m', cc, ho, io, w0, w1, w2, w3, sv, fr, r⟩ := monitor_fault_syscall env M0 u hS ms e c m cy hpc hcs hc ht0
      obtain ⟨k1, k2⟩ := regs_scrubbed_fault r
      have hn : trapSteps u = 62 := by simp [trapSteps, hcu, hc, ht0]
      rw [hn]
      refine ⟨⟨p, h, m', by rw [cc]; rfl, w0, w1, ?_, k2⟩, a, frameSP_of fr sv, by rw [cc]; rfl, ho, ?_⟩
      · rw [k1]
        simp [exitCode, hcu, hc, ht0]
      · rw [io]
        simp [trapIo, faultIo, haltIo, exitCode, hcs, csrsH, hcu, hc, ht0]
  · -- a trap that is not an `ecall`
      obtain ⟨p, a, h, m', cc, ho, io, w0, w1, w2, w3, sv, fr, r⟩ := monitor_fault_cause env M0 u hS ms e c m cy hpc hcs hc
      obtain ⟨k1, k2⟩ := regs_scrubbed_fault r
      have hn : trapSteps u = 59 := by simp [trapSteps, hcu, hc]
      rw [hn]
      refine ⟨⟨p, h, m', by rw [cc]; rfl, w0, w1, ?_, k2⟩, a, frameSP_of fr sv, by rw [cc]; rfl, ho, ?_⟩
      · rw [k1]
        simp [exitCode, hcu, hc]
      · rw [io]
        simp [trapIo, faultIo, haltIo, exitCode, hcs, csrsH, hcu, hc]


/-! ## The payload runs, and traps -/

/-- The payload is in the box: it runs up to its first trap. Its writes land in the data and the stack only, the code
    is not among them, and the monitor's words stay where they were; at the trap the machine is in M-mode at the trap
    vector, with the CSRs boot set and `HState` true, so that the handler's theorems apply. -/
theorem payload_runs (env : Rv32.Env) (M0 : Word → Byte) (s1 : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem1 : s1.core.mem = M0) (henv : env.region = monRegion)
    (hcs1 : s1.csrs = csrsBooted)
    (hbox : WXBoxed s1 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000) (n : Nat) :
    ∃ k, k ≤ n ∧
      (∀ x : Word, WxFrozen 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 x →
        (PrivMachine.run env k s1).core.mem x = M0 x) ∧
      Agree M0 (PrivMachine.run env k s1).core.mem 0x80000000 604 ∧
      ((k = n ∧ (PrivMachine.run env k s1).mode = .U ∧
        WXBoxed (PrivMachine.run env k s1) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000) ∨
       (0 < k ∧ (PrivMachine.run env k s1).mode = .M ∧ HState env M0 (PrivMachine.run env k s1) ∧
        (PrivMachine.run env k s1).core.pc = 0x80000134#32 ∧
        ∃ ms e c m cy, (PrivMachine.run env k s1).csrs = csrsH ms e c m cy {} 0x80008000#32)) := by
  obtain ⟨k, hkn, hkept, hhalt, hframe, hres⟩ :=
    wx_run env 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 (by decide) (by decide) n s1 hbox
  refine ⟨k, hkn, ?_⟩
  obtain ⟨u, hu⟩ : ∃ t, PrivMachine.run env k s1 = t := ⟨_, rfl⟩
  rw [hu] at hkept hhalt hframe hres ⊢
  have hfroz : ∀ x : Word, WxFrozen 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 x →
      u.core.mem x = M0 x := fun x hx => by rw [hframe x hx, hmem1]
  have hagree : Agree M0 u.core.mem 0x80000000 604 := by
    intro x h1 h2
    exact hfroz x (Or.inr ⟨by omega, by omega⟩)
  refine ⟨hfroz, hagree, ?_⟩
  rcases hres with ⟨hk, hmode, hb⟩ | ⟨hpos, hmode, hpc2⟩
  · exact Or.inl ⟨hk, hmode, hb⟩
  · right
    obtain ⟨k1, k2, k3, k4, k5, k6, k7, k8⟩ := hkept
    rw [hcs1] at k1 k2 k3 k4 k5 k6 k7 k8 hpc2
    have hcsu : u.csrs = csrsH u.csrs.mstatus u.csrs.mepc u.csrs.mcause u.csrs.minstret u.csrs.mcycle {} 0x80008000#32 :=
      csrs_eq_csrsH u.csrs k1 k2 k3 k4 k5 k6 k7 k8
    have hpcu : u.core.pc = 0x80000134#32 := by
      rw [hpc2]; show (0x80000134#32 &&& ~~~3#32) = 0x80000134#32; decide
    exact ⟨hpos, hmode, ⟨hW, hagree, henv, hhalt, hmode⟩, hpcu, _, _, _, _, _, hcsu⟩

set_option maxHeartbeats 4000000 in
/-- **The code the box forbids writing.** From reset -- or from any CSRs that lock no PMP entry -- the monitor boots
    (61 steps) and the payload runs for up to `n`
    steps. Either it is still running, in U-mode, boxed by the three entries, the monitor's words where they were and
    the code, `[0x80010000, 0x80010080)`, **the bytes it started with** -- or it trapped, and the monitor takes
    `trapSteps` steps to the park loop with the exit code `exitCode u` (the payload's own `a0` for a HALT, 1 for the
    rest), every other register zero, and every byte of memory but the monitor's stack and report words as the payload
    left it -- the code among them, still the bytes it started with -- and the host has heard `trapIo u`: the report
    for the way it trapped, then the exit code. -/
theorem monitor_end_to_end (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem : s.core.mem = M0)
    (hpc : s.core.pc = 0x80000040#32) (hh : s.halted = false) (hm : s.mode = .M)
    (hlock : PmpUnlocked s.csrs.pmpcfg0) (henv : env.region = monRegion) (n : Nat) :
    ∃ k, k ≤ n ∧
      ((k = n ∧ (payloadAt env s k).mode = .U ∧
        WXBoxed (payloadAt env s k) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 ∧
        Agree M0 (payloadAt env s k).core.mem 0x80000000 604 ∧
        CodeSame M0 (payloadAt env s k).core.mem) ∨
       (0 < k ∧
        Parked (parkedAfter env (payloadAt env s k)) (exitCode (payloadAt env s k)) ∧
        Agree M0 (parkedAfter env (payloadAt env s k)).core.mem 0x80000000 604 ∧
        CodeSame M0 (parkedAfter env (payloadAt env s k)).core.mem ∧
        FrameSP (payloadAt env s k).core.mem (parkedAfter env (payloadAt env s k)).core.mem ∧
        (parkedAfter env (payloadAt env s k)).io = (payloadAt env s k).io ++ trapIo (payloadAt env s k))) := by
  obtain ⟨hbox, hpc1, hcsb, hmem1, hreg1, -, -⟩ := monitor_boot env M0 s hW hmem hpc hh hm hlock
  obtain ⟨k, hkn, hfroz, hagree, hres⟩ := payload_runs env M0 _ hW hmem1 henv hcsb hbox n
  refine ⟨k, hkn, ?_⟩
  unfold payloadAt parkedAfter
  rcases hres with ⟨hk, hmode, hb⟩ | ⟨hpos, hmode, hS, hpcu, ms, e, c, m, cy, hcsu⟩
  · exact Or.inl ⟨hk, hmode, hb, hagree, fun x h1 h2 => hfroz x (Or.inl ⟨h1, h2⟩)⟩
  · right
    obtain ⟨hP, hA, hF, -, -, hio⟩ := monitor_traps env M0 _ hS ms e c m cy hpcu hcsu
    refine ⟨hpos, hP, hA, ?_, hF, hio⟩
    intro x h1 h2
    have hs : ¬ InStack x := by unfold InStack; omega
    have hp : ¬ InPorts x := by unfold InPorts; omega
    rw [hF x hs hp]
    exact hfroz x (Or.inl ⟨h1, h2⟩)

/-! ## Round after round -/

/-- A reset, as weak as one can be: the core starts again at the reset vector, in M-mode, with nothing running; the
    registers, the CSRs and memory are whatever they were. A reset that also resets the CSRs is one of these. -/
def resetOf (p : PrivMachine) : PrivMachine :=
  { p with core := { p.core with pc := 0x80000040#32 }, mode := .M, halted := false }

/-- What a round needs of the machine it starts from, and nothing else: the monitor's words in memory, the code region
    as it was loaded (`C`), no PMP entry locked, and the region Tier 1 lets M-mode touch. The registers and the rest of
    the CSRs are not in it. -/
structure Ready (env : Rv32.Env) (C : Word → Byte) (p : PrivMachine) : Prop where
  words    : WordsAt p.core.mem 0x80000000#32 monitorCode
  code     : CodeSame C p.core.mem
  unlocked : PmpUnlocked p.csrs.pmpcfg0
  region   : env.region = monRegion

/-- `k` steps into a payload, `k > 0`, is its first trap: M-mode, and every step before was U-mode. -/
def Trapped (env : Rv32.Env) (s : PrivMachine) (k : Nat) : Prop :=
  0 < k ∧ (PrivMachine.run env k s).mode = .M ∧ ∀ i, i < k → (PrivMachine.run env i s).mode = .U

/-- One round, from `p` to `q`: reset, boot, the payload runs to its first trap, and the monitor takes it to the park loop. -/
def Round (env : Rv32.Env) (p q : PrivMachine) : Prop :=
  ∃ k, Trapped env (PrivMachine.run env 61 (resetOf p)) k ∧ q = parkedAfter env (payloadAt env (resetOf p) k)

/-- What the host may do between rounds: anything at all to the machine -- its registers, its CSRs, its memory -- but
    write the monitor's words or the code, or lock a PMP entry. rounds.py writes the next round's seed word, in the
    data. -/
def HostWrite (p q : PrivMachine) : Prop :=
  PmpUnlocked q.csrs.pmpcfg0 ∧
    ∀ x : Word, (0x80000000 ≤ x.toNat ∧ x.toNat < 0x80000000 + 604) ∨ (0x80010000 ≤ x.toNat ∧ x.toNat < 0x80010080) →
      q.core.mem x = p.core.mem x

/-- Any number of rounds, and between any two of them, any number of the host's writes. -/
inductive Rounds (env : Rv32.Env) : PrivMachine → PrivMachine → Prop
  | refl (p : PrivMachine) : Rounds env p p
  | step {p q r : PrivMachine} : Round env p q → Rounds env q r → Rounds env p r
  | host {p q r : PrivMachine} : HostWrite p q → Rounds env q r → Rounds env p r

/-- **The host's write leaves the machine ready.** It did not touch the monitor's words or the code, and locked
    nothing. -/
theorem ready_of_host (env : Rv32.Env) (C : Word → Byte) (p q : PrivMachine) (hR : Ready env C p)
    (h : HostWrite p q) : Ready env C q := by
  obtain ⟨hl, hm⟩ := h
  refine ⟨?_, ?_, hl, hR.region⟩
  · have hA : Agree p.core.mem q.core.mem 0x80000000 604 := fun x h1 h2 => hm x (Or.inl ⟨h1, h2⟩)
    exact WordsAt.of_agree (by rw [monitorCode_length]; decide) (by rw [monitorCode_length]; exact hA) hR.words
  · intro x h1 h2
    rw [hm x (Or.inr ⟨h1, h2⟩)]
    exact hR.code x h1 h2

/-- **Boot does not depend on what came before.** From any machine that is `Ready` -- whatever its registers, its
    CSRs but for a lock, its privilege, its `pc`, and whatever is in memory outside the monitor's words -- a reset and
    61 steps leave exactly the machine `monitor_boot` describes: boxed by the three entries, the CSR file `csrsBooted`
    (counters at 2, `mstatus`, `mepc`, `mcause`, the trap vector, the PMP -- all constants), `sp` at the top
    of the stack entry, every other register zero, memory untouched. No register and no CSR a round leaves behind
    reaches the next; memory outside the monitor's words does, and the payload reads it. -/
theorem monitor_reentry (env : Rv32.Env) (C : Word → Byte) (p : PrivMachine) (hR : Ready env C p) :
    WXBoxed (PrivMachine.run env 61 (resetOf p)) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 ∧
    (PrivMachine.run env 61 (resetOf p)).csrs = csrsBooted ∧
    (PrivMachine.run env 61 (resetOf p)).core.pc = 0x80010000#32 ∧
    (PrivMachine.run env 61 (resetOf p)).core.mem = p.core.mem ∧
    (∀ r, (PrivMachine.run env 61 (resetOf p)).core.reg r = if r = 2 then 0x80020000#32 else 0#32) := by
  obtain ⟨hbox, hpc1, hcsb, hmem1, hreg1, -, -⟩ :=
    monitor_boot env p.core.mem (resetOf p) hR.words rfl rfl rfl rfl hR.unlocked
  exact ⟨hbox, hcsb, hpc1, hmem1, hreg1⟩

/-- **A round leaves the machine ready for the next.** If `p` is `Ready` and `q` is where a round from `p` ends, `q` is
    parked -- every register but `a0` zero, `mscratch` and the saved words zero -- and `Ready` again, with the code
    region the bytes it was and the PMP as boot set it, which locks nothing. -/
theorem monitor_round_ready (env : Rv32.Env) (C : Word → Byte) (p q : PrivMachine) (hR : Ready env C p)
    (hq : Round env p q) : Ready env C q ∧ ∃ a, Parked q a := by
  obtain ⟨k, ⟨hk0, hkM, hkU⟩, hq⟩ := hq
  obtain ⟨hbox, hcsb, hpc1, hmem1, hreg1⟩ := monitor_reentry env C p hR
  obtain ⟨k', hk'k, hfroz, hagree, hres⟩ :=
    payload_runs env p.core.mem _ hR.words hmem1 hR.region hcsb hbox k
  -- the first trap is `k`: a shorter run that trapped would have been in M-mode before `k`
  have hkk : k' = k := by
    rcases hres with ⟨h1, h2, _⟩ | ⟨h1, h2, _⟩
    · exfalso
      have : (PrivMachine.run env k' (PrivMachine.run env 61 (resetOf p))).mode = .M := by rw [h1]; exact hkM
      rw [h2] at this
      exact absurd this (by decide)
    · by_cases hne : k' = k
      · exact hne
      · exfalso
        have := hkU k' (by omega)
        rw [h2] at this
        exact absurd this (by decide)
  subst hkk
  rcases hres with ⟨_, h2, _⟩ | ⟨hpos, hmode, hS, hpcu, ms, e, c, m, cy, hcsu⟩
  · exfalso
    rw [h2] at hkM
    exact absurd hkM (by decide)
  · obtain ⟨hP, hA, hF, hC, -, -⟩ := monitor_traps env p.core.mem _ hS ms e c m cy hpcu hcsu
    rw [hq]
    unfold parkedAfter payloadAt
    refine ⟨⟨?_, ?_, ?_, hR.region⟩, _, hP⟩
    · exact WordsAt.of_agree (by rw [monitorCode_length]; decide) (by rw [monitorCode_length]; exact hA) hR.words
    · intro x h1 h2
      have hs : ¬ InStack x := by unfold InStack; omega
      have hp : ¬ InPorts x := by unfold InPorts; omega
      rw [hF x hs hp, hfroz x (Or.inl ⟨h1, h2⟩)]
      exact hR.code x h1 h2
    · rw [hC]; intro i; revert i; decide

/-- **Any number of rounds.** From a `Ready` machine, after any number of rounds and of the host's writes between them,
    the machine is `Ready` again -- the monitor's words in place and the code region the bytes it was loaded with --
    and so a reset and boot start the next round exactly as `monitor_reentry` says. This is what rounds.py runs. -/
theorem monitor_rounds (env : Rv32.Env) (C : Word → Byte) (p q : PrivMachine) (h : Rounds env p q)
    (hR : Ready env C p) : Ready env C q := by
  induction h with
  | refl => exact hR
  | step hr _ ih => exact ih (monitor_round_ready env C _ _ hR hr).1
  | host hw _ ih => exact ih (ready_of_host env C _ _ hR hw)

end Exp240

