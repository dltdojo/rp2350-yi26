  case w2 => simp [w3_2, w2_2, w1_2, r3, r2, r1, regsUpd]
  case w3 => simp [w3_3, w2_3, w1_3, r3, r2, r1, regsUpd]
  case sv => exact (sv1.trans (sv2.trans sv3))
  case fr => exact (fr1.trans (fr2.trans fr3))
  case r =>
    intro r
    have hr32 : r = 0#5 ∨ r = 1#5 ∨ r = 2#5 ∨ r = 3#5 ∨ r = 4#5 ∨ r = 5#5 ∨ r = 6#5 ∨ r = 7#5 ∨ r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 ∨ r = 16#5 ∨ r = 17#5 ∨ r = 18#5 ∨ r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨ r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 ∨ r = 31#5 := by bv_omega
    rcases hr32 with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp [w3_0, w3_1, w3_2, w3_3, w2_0, w2_1, w2_2, w2_3, w1_0, w1_1, w1_2, w1_3, ofNat_toNat_mod, r3, r2, r1, regsUpd]

