/-- From reset (the image loaded at `0x80000000`, `pc = 0x80000040`, M-mode, CSRs at their reset
    values, any registers), 53 steps leave the machine in U-mode at the payload's first word,
    the PMP fencing off `[0x80010000, 0x80020000)`, every register zero but `sp`. -/
theorem monitor_boot (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem : s.core.mem = M0)
    (hpc : s.core.pc = 0x80000040#32) (hh : s.halted = false) (hm : s.mode = .M)
    (hcs : s.csrs = {}) :
    UBoxed (PrivMachine.run env 53 s) 0x80010000 0x80020000 ∧
    (PrivMachine.run env 53 s).core.pc = 0x80010000#32 ∧
    (∃ ms e c m cy, (PrivMachine.run env 53 s).csrs = csrsH ms e c m cy {} 0x80008000#32) ∧
    (PrivMachine.run env 53 s).core.mem = M0 ∧
    (∀ r, (PrivMachine.run env 53 s).core.reg r = if r = 2 then 0x80020000#32 else 0#32) := by
  obtain ⟨c1, c2, c3, c4, c5⟩ := monitor_boot_config env M0 s hW hmem hpc hh hm hcs
  have hC0 : Cleared 0 (PrivMachine.run env 20 s) := by
    intro r hr
    have : r = 0 := by bv_omega
    subst this
    simp
  obtain ⟨a1, a2, a3, a4, a5, a6⟩ := monitor_launch_1 env M0 _ hW c2 c1 c3 c4 c5 hC0
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := monitor_launch_2 env M0 _ hW a2 a1 a3 a4 a5 a6
  obtain ⟨e1, e2, e3, e4, e5, e6⟩ := monitor_launch_3 env M0 _ hW b2 b1 b3 b4 b5 b6
  obtain ⟨g1, g2, g3, g4, g5, g6⟩ := monitor_launch_4 env M0 _ hW e2 e1 e3 e4 e5
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13⟩ :=
    monitor_launch_5 env M0 _ hW g2 g1 g3 g4 g5
  rw [show 53 = 20 + 12 + 12 + 7 + 1 + 1 from rfl, PrivMachine.run_add, PrivMachine.run_add,
    PrivMachine.run_add, PrivMachine.run_add, PrivMachine.run_add]
  refine ⟨⟨h4, h3, ?_, ?_, ?_, ?_, ?_, ?_⟩, h1, ⟨_, _, _, _, _, csrs_eq_csrsH _ h10 h11 h5 h6 h7 h8 h9 h12⟩, h2, ?_⟩
  · simp [h5, decodePmpCfgByte]
  · simp [h5, decodePmpCfgByte]
  · simp [h5, decodePmpCfgByte]
  · simp [h5, decodePmpCfgByte]
  · simp [h6, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop]
  · intro ⟨i, hi⟩ h
    match i, hi, h with
    | 1, _, _ => simp [h5, decodePmpCfgByte]
    | 2, _, _ => simp [h5, decodePmpCfgByte]
    | 3, _, _ => simp [h5, decodePmpCfgByte]
  · intro r
    rw [h13 r, g6 r]
    exact e6 r (by have h := r.isLt; omega)


theorem run_two {env : Rv32.Env} {n m : Nat} {s s1 s2 : PrivMachine}
    (h1 : PrivMachine.run env n s = s1) (h2 : PrivMachine.run env m s1 = s2) :
    PrivMachine.run env (n + m) s = s2 := by
  rw [PrivMachine.run_add, h1, h2]

/-- A register a chunk did not name is what it was. -/
theorem reg_keep {cur prev : Reg → Word} {l : List (Nat × Word)} {k : Reg} {v : Word}
    (hr : ∀ r, cur r = regsUpd prev l r) (hn : l.find? (fun p => p.1 == k.toNat) = none)
    (hv : prev k = v) : cur k = v := by
  rw [hr k]; simp [regsUpd, hn, hv]

/-- A register a chunk named is what it was told. -/
theorem reg_set {cur prev : Reg → Word} {l : List (Nat × Word)} {k : Reg} {v : Word}
    (hr : ∀ r, cur r = regsUpd prev l r) (hn : l.find? (fun p => p.1 == k.toNat) = some (k.toNat, v)) :
    cur k = v := by
  rw [hr k]; simp [regsUpd, hn]

/-- The state after a chunk is a handler state again. -/
theorem HState.next {env : Rv32.Env} {M0 : Word → Byte} {s t : PrivMachine} (hS : HState env M0 s)
    (ha : Agree M0 t.core.mem 0x80000000 624) (hh : t.halted = false) (hm : t.mode = .M) :
    HState env M0 t := ⟨hS.words, ha, hS.region, hh, hm⟩


theorem ofNat_toNat_mod (x : Word) : BitVec.ofNat 32 (x.toNat % 4294967296) = x := by
  apply BitVec.eq_of_toNat_eq
  have := x.isLt
  simp only [BitVec.toNat_ofNat, Nat.reducePow]
  omega


/-! ## What the monitor writes into the payload's box, and where -/

/-- With the PMP boot set, an M-mode access wholly inside the payload's region is not refused: the entry
    that fences the payload in is not locked, so it binds U-mode and leaves M-mode alone. -/
theorem pmpCheck_mon_in (csrs : PrivCSRs) (addr : Word) (width : Nat) (acc : AccessType)
    (h0 : csrs.pmpcfg0 = 0x1f#32) (h1 : csrs.pmpaddr0 = 0x20005fff#32)
    (hw : 0 < width) (hlo : 0x80010000 ≤ addr.toNat) (hhi : addr.toNat + width ≤ 0x80020000) :
    pmpCheck csrs .M addr width acc = true := by
  unfold pmpCheck PMP_INDICES pmpCheckEntries matchPmpEntry
  have hn : ¬ (addr.toNat + width ≤ 2147549184 ∨ 2147614720 ≤ addr.toNat) := by omega
  have hb : 2147549184 ≤ addr.toNat ∧ addr.toNat + width ≤ 2147614720 := by omega
  simp [h0, h1, decodePmpCfgByte, pmpAddrVal, decodeNapotRange, countTrailingOnes32,
    countTrailingOnes32.loop, hasPermission, hn, hb]

/-- The confidential scratch of exp223's kernel: the SHA-256 schedule at `+0x2200` and the raw samples at
    `+0x3000`, up to the end of the samples at `+0x4000`. -/
def InConf (x : Word) : Prop := 0x80012200 ≤ x.toNat ∧ x.toNat < 0x80014000
/-- The 32-byte digest window, at `+0x2140`. -/
def InDigest (x : Word) : Prop := 0x80012140 ≤ x.toNat ∧ x.toNat < 0x80012160

/-- **What the monitor leaves of memory.** The payload left `m0` and exited with `a0`; the monitor parks with
    `m`: the confidential scratch zero; the digest window zero too, unless `a0` is 0, when its 32 bytes are
    the payload's; every other byte but the monitor's own stack words and report words as it was. -/
def Scrubbed (a0 : Word) (m0 m : Word → Byte) : Prop :=
  (∀ x, InConf x → m x = 0) ∧
  (∀ x, InDigest x → m x = if a0 = 0#32 then m0 x else 0) ∧
  (∀ x, ¬ InConf x → ¬ InDigest x → ¬ InStack x → ¬ InPorts x → m x = m0 x)

/-- The payload's box and the rest of memory outside the monitor's stack words and report words: the
    monitor's earlier steps wrote nothing there. -/
def FrameSP (m m' : Word → Byte) : Prop := ∀ x, ¬ InStack x → ¬ InPorts x → m' x = m x

theorem frameSP_of {m m' : Word → Byte} (f : Frame m m') (v : SvcSame m m') : FrameSP m m' := by
  intro x hs hp
  by_cases hv : InSvc x
  · exact v x hv
  · exact f x hs hp hv

theorem FrameSP.trans {a b c : Word → Byte} (h1 : FrameSP a b) (h2 : FrameSP b c) : FrameSP a c :=
  fun x i p => (h2 x i p).trans (h1 x i p)

/-- A trap's first half, which wrote nothing in the box, followed by a scrub, is a scrub of the box as the
    payload left it. -/
theorem scrubbed_of_frame {a0 : Word} {m0 m1 m2 : Word → Byte} (f : FrameSP m0 m1) (s : Scrubbed a0 m1 m2) :
    Scrubbed a0 m0 m2 := by
  obtain ⟨c, d, o⟩ := s
  refine ⟨c, ?_, ?_⟩
  · intro x hx
    have hs : ¬ InStack x := by unfold InStack InDigest at *; omega
    have hp : ¬ InPorts x := by unfold InPorts InDigest at *; omega
    rw [d x hx, f x hs hp]
  · intro x h1 h2 h3 h4
    rw [o x h1 h2 h3 h4, f x h3 h4]

/-- The pass: the confidential scratch zeroed, the digest window and everything else but the stack and report
    words untouched. -/
theorem scrubbed_pass {m0 m1 m2 m3 m4 : Word → Byte}
    (f1 : Frame m0 m1) (v1 : SvcSame m0 m1) (z : Zeroed 0x80012200 0x80014000 m1 m2)
    (f3 : Frame m2 m3) (v3 : SvcSame m2 m3) (f4 : Frame m3 m4) (v4 : SvcSame m3 m4) :
    Scrubbed 0#32 m0 m4 := by
  have g1 := frameSP_of f1 v1
  have g3 := frameSP_of f3 v3
  have g4 := frameSP_of f4 v4
  refine ⟨?_, ?_, ?_⟩
  · intro x hx
    unfold InConf at hx
    have hs : ¬ InStack x := by unfold InStack; omega
    have hp : ¬ InPorts x := by unfold InPorts; omega
    rw [g4 x hs hp, g3 x hs hp, (z x).1 hx]
  · intro x hx
    unfold InDigest at hx
    have hs : ¬ InStack x := by unfold InStack; omega
    have hp : ¬ InPorts x := by unfold InPorts; omega
    have hc : ¬ (0x80012200 ≤ x.toNat ∧ x.toNat < 0x80014000) := by omega
    simp only [ite_true]
    rw [g4 x hs hp, g3 x hs hp, (z x).2 hc, g1 x hs hp]
  · intro x hc hd hs hp
    have hc' : ¬ (0x80012200 ≤ x.toNat ∧ x.toNat < 0x80014000) := hc
    rw [g4 x hs hp, g3 x hs hp, (z x).2 hc', g1 x hs hp]

/-- The fail: the digest window zeroed too. -/
theorem scrubbed_fail {a0 : Word} (ha : a0 ≠ 0#32) {m0 m1 m2 m3 m4 m5 m6 : Word → Byte}
    (f1 : Frame m0 m1) (v1 : SvcSame m0 m1) (z : Zeroed 0x80012200 0x80014000 m1 m2)
    (f3 : Frame m2 m3) (v3 : SvcSame m2 m3) (f4 : Frame m3 m4) (v4 : SvcSame m3 m4)
    (zd : Zeroed 0x80012140 0x80012160 m4 m5) (f6 : Frame m5 m6) (v6 : SvcSame m5 m6) :
    Scrubbed a0 m0 m6 := by
  have g1 := frameSP_of f1 v1
  have g3 := frameSP_of f3 v3
  have g4 := frameSP_of f4 v4
  have g6 := frameSP_of f6 v6
  refine ⟨?_, ?_, ?_⟩
  · intro x hx
    unfold InConf at hx
    have hs : ¬ InStack x := by unfold InStack; omega
    have hp : ¬ InPorts x := by unfold InPorts; omega
    have hd : ¬ (0x80012140 ≤ x.toNat ∧ x.toNat < 0x80012160) := by omega
    rw [g6 x hs hp, (zd x).2 hd, g4 x hs hp, g3 x hs hp, (z x).1 hx]
  · intro x hx
    unfold InDigest at hx
    have hs : ¬ InStack x := by unfold InStack; omega
    have hp : ¬ InPorts x := by unfold InPorts; omega
    simp only [ha, ite_false]
    rw [g6 x hs hp]
    exact (zd x).1 hx
  · intro x hc hd hs hp
    have hc' : ¬ (0x80012200 ≤ x.toNat ∧ x.toNat < 0x80014000) := hc
    have hd' : ¬ (0x80012140 ≤ x.toNat ∧ x.toNat < 0x80012160) := hd
    rw [g6 x hs hp, (zd x).2 hd', g4 x hs hp, g3 x hs hp, (z x).2 hc', g1 x hs hp]

/-! ## The park loop, and the exit code -/

/-- The park loop, reached: every register but `a0` zero, `mscratch` zero, the two words trap entry saved zero. -/
def Parked (t : PrivMachine) (a0 : Word) : Prop :=
  t.core.pc = 0x80000268#32 ∧ t.halted = false ∧ t.mode = .M ∧ t.csrs.mscratch = 0#32 ∧
  readLE t.core.mem 0x80008000#32 4 = 0 ∧ readLE t.core.mem 0x80008004#32 4 = 0 ∧
  t.core.reg 10#5 = a0 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32

/-- The code the monitor parks with after a trap: the payload's own `a0` if it asked for HALT (`ecall` with
    `t0 = 1`), and 1 for everything else. -/
def exitCode (u : PrivMachine) : Word :=
  if u.csrs.mcause = 8#32 ∧ u.core.reg 5#5 = 1#32 then u.core.reg 10#5 else 1#32

/-- A fault's report to the print word: the tag, `mcause`, `mepc`, `mtval` (0: Hazard3 hardwires it)
    and `minstret`. -/
def faultIo (u : PrivMachine) : List IoEvent :=
  [⟨0xc0000004#32, 0x4641554c#32⟩, ⟨0xc0000004#32, u.csrs.mcause⟩, ⟨0xc0000004#32, u.csrs.mepc⟩,
   ⟨0xc0000004#32, 0#32⟩, ⟨0xc0000004#32, u.csrs.minstret⟩]

/-- A HALT's report to the print word: the tag, the payload's `a0`, `minstret` and `mcycle`. -/
def haltIo (u : PrivMachine) : List IoEvent :=
  [⟨0xc0000004#32, 0x48414c54#32⟩, ⟨0xc0000004#32, u.core.reg 10#5⟩, ⟨0xc0000004#32, u.csrs.minstret⟩,
   ⟨0xc0000004#32, u.csrs.mcycle⟩]

/-- What the host hears of a trap, in order: the report for the way it trapped, then the exit code to the exit word. -/
def trapIo (u : PrivMachine) : List IoEvent :=
  (if u.csrs.mcause = 8#32 ∧ u.core.reg 5#5 = 1#32 then haltIo u else faultIo u) ++ [⟨0xc0000008#32, exitCode u⟩]


set_option maxHeartbeats 4000000 in
set_option maxRecDepth 100000 in
/-- Trap entry, first three words: freeze the counters, swap in the M-mode stack, save `t0`. -/
theorem entry_1 (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hS : HState env M0 s) (ms : MStatus) (e c m cy : Word)
    (hpc : s.core.pc = 0x80000114#32) (hcs : s.csrs = csrsH ms e c m cy {} (0x80008000#32)) :
    (PrivMachine.run env 3 s).core.pc = 0x80000120#32 ∧
    Agree M0 (PrivMachine.run env 3 s).core.mem 0x80000000 624 ∧
    (PrivMachine.run env 3 s).halted = false ∧
    (PrivMachine.run env 3 s).mode = .M ∧
    (PrivMachine.run env 3 s).csrs = csrsH ms e c m cy { cy := true, ir := true } (s.core.reg 2#5) ∧
    (PrivMachine.run env 3 s).host = s.host ∧
    (PrivMachine.run env 3 s).io = s.io ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x80008000#32 4 = (s.core.reg 5#5).toNat % 4294967296 ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x80008004#32 4 = readLE s.core.mem 0x80008004#32 4 ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x80008008#32 4 = readLE s.core.mem 0x80008008#32 4 ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x8000800c#32 4 = readLE s.core.mem 0x8000800c#32 4 ∧
    SvcSame s.core.mem (PrivMachine.run env 3 s).core.mem ∧
    Frame s.core.mem (PrivMachine.run env 3 s).core.mem ∧
    (∀ r, (PrivMachine.run env 3 s).core.reg r = regsUpd s.core.reg [(2, 0x80008000#32)] r) := by
  obtain ⟨hW, hA, henv, hh, hm⟩ := hS
  obtain ⟨Mc, hmem⟩ : ∃ Mc, s.core.mem = Mc := ⟨_, rfl⟩
  have hA' : Agree M0 Mc 0x80000000 624 := hmem ▸ hA
  have sm : ∀ t : PrivMachine, Agree M0 t.core.mem 0x80000000 624 →
      (t.core.pc - 0x80000000#32).toNat / 4 < monitorCode.length →
      (t.core.pc - 0x80000000#32).toNat % 4 = 0 →
      PrivMachine.step env t =
        PrivMachine.stepW env t (monitorCode.getD ((t.core.pc - 0x80000000#32).toNat / 4) 0) :=
    fun t ht h1 h2 => step_mon hW ht h1 h2
  obtain ⟨F, hF⟩ : ∃ F, PrivMachine.run env 3 s = F := ⟨_, rfl⟩
  rw [hF]
  all_goals psimpH [pmpCheck_mon, sm, hmem, hA', henv, monRegion, agree_writeLE_iff, hpc, monitorCode, hh, hm, hcs, csrsH, csrsFixed, csrsConfigured] at hF
  all_goals subst hF
  all_goals refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals try psimpH [pmpCheck_mon, hpc, hmem, hA', agree_writeLE_iff, csrsH, csrsFixed, csrsConfigured, readLE_writeLE_self, readLE_writeLE_far, regsUpd]
  all_goals try (unfold Frame
                 intro x h1 h2 h3
                 simp only [writeLE4_apply, InStack, InPorts, InSvc, BitVec.toNat_sub, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod] at h1 h2 h3 ⊢
                 repeat' split
                 all_goals first | rfl | omega)
  all_goals try (unfold SvcSame
                 intro x h1
                 simp only [writeLE4_apply, InSvc, BitVec.toNat_sub, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod] at h1 ⊢
                 repeat' split
                 all_goals first | rfl | omega)
  all_goals try (intro r
                 have hr32 : r = 0#5 ∨ r = 1#5 ∨ r = 2#5 ∨ r = 3#5 ∨ r = 4#5 ∨ r = 5#5 ∨ r = 6#5 ∨ r = 7#5 ∨ r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 ∨ r = 16#5 ∨ r = 17#5 ∨ r = 18#5 ∨ r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨ r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 ∨ r = 31#5 := by bv_omega
                 rcases hr32 with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> psimpH [pmpCheck_mon, regsUpd])

