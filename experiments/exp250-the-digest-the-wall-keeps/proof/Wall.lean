/-- **The loop.** From the store, with `t0 = A` and `t1 = E` four-aligned, `A + 4 * (k + 1) = E`, and `[A, E)` in
    the payload's box: after `3 * (k + 1)` steps the machine stands at the instruction after the branch, `[A, E)` is
    zero, no other byte of memory has changed, and `t0 = E`. -/
theorem zloop_dig (env : Rv32.Env) (M0 : Word → Byte) :
    ∀ (k : Nat) (s : PrivMachine), HState env M0 s → ∀ (ms : MStatus) (e c m cy : Word) (A E : Word),
      s.core.pc = 0x800001d4#32 → s.csrs = csrsH ms e c m cy { cy := true, ir := true } (0#32) →
      s.core.reg 5#5 = A → s.core.reg 6#5 = E →
      A.toNat % 4 = 0 → 0x80010000 ≤ A.toNat → A.toNat + 4 * (k + 1) = E.toNat → E.toNat ≤ 0x80020000 →
      (PrivMachine.run env (3 * (k + 1)) s).core.pc = 0x800001e0#32 ∧
      Agree M0 (PrivMachine.run env (3 * (k + 1)) s).core.mem 0x80000000 624 ∧
      (PrivMachine.run env (3 * (k + 1)) s).halted = false ∧
      (PrivMachine.run env (3 * (k + 1)) s).mode = .M ∧
      (PrivMachine.run env (3 * (k + 1)) s).csrs = csrsH ms e c m cy { cy := true, ir := true } (0#32) ∧
      (PrivMachine.run env (3 * (k + 1)) s).host = s.host ∧
      (PrivMachine.run env (3 * (k + 1)) s).io = s.io ∧
      Zeroed A.toNat E.toNat s.core.mem (PrivMachine.run env (3 * (k + 1)) s).core.mem ∧
      (∀ r, (PrivMachine.run env (3 * (k + 1)) s).core.reg r = regsUpd s.core.reg [(5, E)] r) := by
  intro k
  induction k with
  | zero =>
    intro s hS ms e c m cy A E hpc hcs hA hE hal hlo hk hEhi
    have hAE : A + 4#32 = E := by
      apply BitVec.eq_of_toNat_eq
      have := A.isLt
      simp only [BitVec.toNat_add, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod]
      omega
    obtain ⟨p, a, h, m', c', o, i, x, rr⟩ := zloop_iter_dig env M0 s hS ms e c m cy A E hpc hcs hA hE hal hlo (by omega)
    refine ⟨?_, a, h, m', c', o, i, ?_, ?_⟩
    · rw [p]; simp [hAE]
    · rw [x]
      have := zeroed_write A s.core.mem (by omega)
      rw [show E.toNat = A.toNat + 4 by omega]
      exact this
    · intro r
      rw [rr r, hAE]
  | succ k ih =>
    intro s hS ms e c m cy A E hpc hcs hA hE hal hlo hk hEhi
    have hne : ¬ (A + 4#32 = E) := by
      intro h
      have := congrArg BitVec.toNat h
      have := A.isLt
      simp only [BitVec.toNat_add, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod] at *
      omega
    have hA4 : (A + 4#32).toNat = A.toNat + 4 := by
      have := A.isLt
      simp only [BitVec.toNat_add, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod]
      omega
    obtain ⟨p, a, h, m', c', o, i, x, r⟩ := zloop_iter_dig env M0 s hS ms e c m cy A E hpc hcs hA hE hal hlo (by omega)
    obtain ⟨s1, hs1⟩ : ∃ t, PrivMachine.run env 3 s = t := ⟨_, rfl⟩
    rw [hs1] at p a h m' c' o i x r
    simp only [hne, ↓reduceIte] at p
    have hS1 := hS.next a h m'
    have hA1 : s1.core.reg 5#5 = A + 4#32 := by rw [r 5#5]; simp [regsUpd]
    have hE1 : s1.core.reg 6#5 = E := by rw [r 6#5]; simp [regsUpd, hE]
    obtain ⟨p2, a2, h2, m2, c2, o2, i2, z2, r2⟩ := ih s1 hS1 ms e c m cy (A + 4#32) E p c' hA1 hE1
      (by rw [hA4]; omega) (by rw [hA4]; omega) (by rw [hA4]; omega) hEhi
    rw [show 3 * (k + 1 + 1) = 3 + 3 * (k + 1) by omega, PrivMachine.run_add, hs1]
    refine ⟨p2, a2, h2, m2, c2, o2.trans o, i2.trans i, ?_, ?_⟩
    · rw [x] at z2
      rw [hA4] at z2
      have := zeroed_write A s.core.mem (by omega)
      exact zeroed_trans this z2 (by omega) (by omega)
    · intro r'
      rw [r2 r']
      by_cases h5 : r'.toNat = 5
      · simp [regsUpd, h5]
      · have h5' : 5 ≠ r'.toNat := fun h => h5 h.symm
        have h1r := r r'
        simp [regsUpd, h5, h5'] at h1r ⊢
        exact h1r


theorem reg32 (r : Reg) : r = 0#5 ∨ r = 1#5 ∨ r = 2#5 ∨ r = 3#5 ∨ r = 4#5 ∨ r = 5#5 ∨ r = 6#5 ∨ r = 7#5 ∨ r = 8#5 ∨ r = 9#5 ∨ r = 10#5 ∨ r = 11#5 ∨ r = 12#5 ∨ r = 13#5 ∨ r = 14#5 ∨ r = 15#5 ∨ r = 16#5 ∨ r = 17#5 ∨ r = 18#5 ∨ r = 19#5 ∨ r = 20#5 ∨ r = 21#5 ∨ r = 22#5 ∨ r = 23#5 ∨ r = 24#5 ∨ r = 25#5 ∨ r = 26#5 ∨ r = 27#5 ∨ r = 28#5 ∨ r = 29#5 ∨ r = 30#5 ∨ r = 31#5 := by bv_omega

/-- The register scrub: every register but `a0` zero, `a0` as it was. -/
theorem regs_scrubbed {u t : PrivMachine} (q : ∀ r, t.core.reg r = regsUpd u.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32)] r) :
    t.core.reg 10#5 = u.core.reg 10#5 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32 := by
  refine ⟨?_, ?_⟩
  · rw [q 10#5]; simp [regsUpd]
  · intro r hr
    rw [q r]
    rcases reg32 r with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> first | (exfalso; exact hr rfl) | simp [regsUpd]


