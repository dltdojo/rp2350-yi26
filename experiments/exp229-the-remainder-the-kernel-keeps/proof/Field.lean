# exp229 — the remainder the kernel keeps

Addition, subtraction and multiplication modulo secp256k1's p, on numbers of
eight 32-bit words, in RV32IM, and their specification.
-/
import Rv32.Blocks
import Rv32.Flow
import Rv32.Line
import Rv32.Limbs
import Rv32.Asm

namespace Exp229
open Rv32

/-! ## The specification -/

/-- secp256k1's field prime. -/
def P : Nat := 2 ^ 256 - 2 ^ 32 - 977

/-- What each operation must leave: the remainder modulo p. Subtraction adds p
first, so that it is a natural number's remainder. -/
def spec : Nat → Nat → Nat → Nat
  | 0, a, b => (a + b) % P
  | 1, a, b => (a + P - b) % P
  | _, a, b => (a * b) % P

