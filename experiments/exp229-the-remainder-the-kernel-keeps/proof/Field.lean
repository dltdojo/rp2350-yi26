def bytes : List UInt8 := toBytes kernel

/-- p as the eight little-endian words the image holds from 0x800. -/
def primeBytes : List UInt8 :=
  (List.range 32).map fun i => (P / 256 ^ i % 256).toUInt8

/-- The image: the kernel from 0, zeros, p from 0x800. -/
def image : ByteArray := ⟨(bytes ++ List.replicate (0x800 - bytes.length) 0 ++ primeBytes).toArray⟩

end Exp229

def main (args : List String) : IO Unit := do
  match args with
  | [out] =>
    IO.FS.writeBinFile out Exp229.image
    for (i, k) in Exp229.kernel.zipIdx do
      IO.println s!"  {Rv32.hex8 (4 * k) |>.drop 4}  {Rv32.hex8 (Rv32.encode i).toNat}  {i.toAsm}"
  | _ => pure ()
