theorem monitorCode_length : monitorCode.length = 178 := by decide


/-- Run from here, one step at a time, on the words of the monitor. `M0` is the memory the
    words were loaded into; `Agree M0 m` says `m` still has them. -/
theorem step_mon {env : Rv32.Env} {M0 : Word → Byte} {t : PrivMachine}
    (hW : WordsAt M0 0x80000000#32 monitorCode)
    (hA : Agree M0 t.core.mem 0x80000000 712)
    (hlt : (t.core.pc - 0x80000000#32).toNat / 4 < monitorCode.length)
    (hal : (t.core.pc - 0x80000000#32).toNat % 4 = 0) :
    PrivMachine.step env t =
      PrivMachine.stepW env t (monitorCode.getD ((t.core.pc - 0x80000000#32).toNat / 4) 0) := by
  have hW' : WordsAt t.core.mem 0x80000000#32 monitorCode :=
    WordsAt.of_agree (by rw [monitorCode_length]; decide) (by rw [monitorCode_length]; exact hA) hW
  exact step_of_words' hW' hlt hal

/-- With the monitor's memory untouched, the step of any state is the step of the word at its `pc`. -/
theorem sm_mon (env : Rv32.Env) (M0 : Word → Byte) (hW : WordsAt M0 0x80000000#32 monitorCode) :
    ∀ t : PrivMachine, t.core.mem = M0 →
      (t.core.pc - 0x80000000#32).toNat / 4 < monitorCode.length →
      (t.core.pc - 0x80000000#32).toNat % 4 = 0 →
      PrivMachine.step env t =
        PrivMachine.stepW env t (monitorCode.getD ((t.core.pc - 0x80000000#32).toNat / 4) 0) :=
  fun t ht h1 h2 => step_mon hW (by rw [ht]; exact Agree.refl _ _ _) h1 h2


/-! ## Definitions -/

/-- What boot's CSR writes leave in the CSRs, whatever they held: trap vector, stack pointer for traps, the
    three PMP entries (code, data, stack) and the fourth over the seed window, read-only [Charm 2], the
    `mret` target, counters frozen at zero, `mstatus` and `mcause` zero. -/
def csrsConfigured : PrivCSRs :=
  { mtvec := 0x8000015c#32, mscratch := 0x80008000#32, mepc := 0x80010000#32,
    pmpcfg0 := 0x191b1b1d#32, pmpaddr0 := 0x2000400f#32, pmpaddr1 := 0x200041ff#32,
    pmpaddr2 := 0x20007dff#32, pmpaddr3 := 0x2000405f#32,
    mcountinhibit := { cy := true, ir := true } }

/-- Registers `x0..xK` hold what the launch sequence leaves them: zero, but `sp`. -/
def Cleared (K : Nat) (s : PrivMachine) : Prop :=
  ∀ r : Reg, r.toNat ≤ K → s.core.reg r = if r = 2 then 0x80020000#32 else 0#32

/-! ## The trap handler

From here the state is what a payload left behind: any registers, any memory outside the
monitor's own words, the CSRs boot set (`csrsFixed`) with the five fields a running payload
and a trap move (`mstatus`, `mepc`, `mcause` and the two counters) free. -/

/-- The CSRs a payload cannot change: everything boot set, with the counters running. -/
def csrsFixed : PrivCSRs := { csrsConfigured with mcountinhibit := {} }

/-- The handler's CSRs: `csrsFixed` with the free fields, the inhibit and `mscratch` named. -/
def csrsH (ms : MStatus) (e c m cy : Word) (inh : MCountInhibit) (sc : Word) : PrivCSRs :=
  { mstatus := ms, mtvec := 0x8000015c#32, mscratch := sc, mepc := e, mcause := c,
    pmpcfg0 := 0x191b1b1d#32, pmpaddr0 := 0x2000400f#32, pmpaddr1 := 0x200041ff#32, pmpaddr2 := 0x20007dff#32,
    pmpaddr3 := 0x2000405f#32, mcountinhibit := inh, minstret := m, mcycle := cy }

/-- A CSR file whose fixed fields are the monitor's is `csrsH` of its free fields. -/
theorem csrs_eq_csrsH (c : PrivCSRs) (h1 : c.mtvec = 0x8000015c#32) (h2 : c.mscratch = 0x80008000#32)
    (h4 : c.pmpcfg0 = 0x191b1b1d#32) (h5 : c.pmpaddr0 = 0x2000400f#32)
    (h6 : c.pmpaddr1 = 0x200041ff#32) (h7 : c.pmpaddr2 = 0x20007dff#32) (h8 : c.pmpaddr3 = 0x2000405f#32)
    (h9 : c.mcountinhibit = {}) :
    c = csrsH c.mstatus c.mepc c.mcause c.minstret c.mcycle {} 0x80008000#32 := by
  cases c
  simp_all [csrsH]

/-- `f` with the registers in `l` replaced. -/
def regsUpd (f : Reg → Word) (l : List (Nat × Word)) : Reg → Word := fun r =>
  match l.find? (fun p => p.1 == r.toNat) with
  | some p => p.2
  | none => f r

/-- The region Tier 1 lets M-mode code touch: monitor, payload, and the MMIO words. -/
def monRegion : Rv32.Region := ⟨0x80000000, 0xC0000100⟩

/-- With the PMP boot set, M-mode code outside the payload region is never refused: the three entries all lie
    inside `[0x80010000, 0x80020000)`, and so does the fourth. -/
theorem pmpCheck_mon (csrs : PrivCSRs) (addr : Word) (width : Nat) (acc : AccessType)
    (h0 : csrs.pmpcfg0 = 0x191b1b1d#32) (h1 : csrs.pmpaddr0 = 0x2000400f#32) (h2 : csrs.pmpaddr1 = 0x200041ff#32)
    (h3 : csrs.pmpaddr2 = 0x20007dff#32) (h4 : csrs.pmpaddr3 = 0x2000405f#32)
    (hout : addr.toNat + width ≤ 0x80010000 ∨ 0x80020000 ≤ addr.toNat) :
    pmpCheck csrs .M addr width acc = true := by
  apply pmpCheck_M_outside_in csrs 0x80010000 0x80020000 addr width acc _ _ _ _ hout
  · exact Or.inr ⟨0x80010000, 0x80010080,
      by simp [pmpAddrVal, h1, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop], by decide, by decide⟩
  · exact Or.inr ⟨0x80010000, 0x80011000,
      by simp [pmpAddrVal, h2, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop], by decide, by decide⟩
  · exact Or.inr ⟨0x8001f000, 0x80020000,
      by simp [pmpAddrVal, h3, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop], by decide, by decide⟩
  · exact Or.inr ⟨0x80010100, 0x80010200,
      by simp [pmpAddrVal, h4, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop], by decide, by decide⟩

/-- The common hypotheses of a handler step: loaded words, the region, not halted, M-mode. -/
structure HState (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine) : Prop where
  words : WordsAt M0 0x80000000#32 monitorCode
  agree : Agree M0 s.core.mem 0x80000000 712
  region : env.region = monRegion
  notHalted : s.halted = false
  mMode : s.mode = .M

/-- Where boot leaves the CSRs, whatever came before it: after the `mret`, counters running and having counted two
    instructions (`csrwi mcountinhibit, 0` and the `mret`), `mstatus` as `mret` leaves it, `mepc` the payload's entry. -/
def csrsBooted : PrivCSRs :=
  csrsH { mie := false, mpie := true, mpp := .U } 0x80010000#32 0#32 2#32 2#32 {} 0x80008000#32



/-! ## Where the monitor's own writes can land -/

/-- The four words trap entry saves on the M-mode stack. -/
def InStack (x : Word) : Prop := 0x80008000 ≤ x.toNat ∧ x.toNat < 0x80008010
/-- The testbench's report words: print and exit. -/
def InPorts (x : Word) : Prop := 0xc0000000 ≤ x.toNat ∧ x.toNat < 0xc0000010
/-- The service port: three argument words and the request. -/
def InSvc (x : Word) : Prop := 0xc0000010 ≤ x.toNat ∧ x.toNat < 0xc0000020

/-- Memory outside the monitor's stack words, the report words and the service port is what it was:
    the payload's box included. -/
def Frame (m m' : Word → Byte) : Prop := ∀ x, ¬ InStack x → ¬ InPorts x → ¬ InSvc x → m' x = m x

/-- The service port's bytes are what they were: the host was not asked. -/
def SvcSame (m m' : Word → Byte) : Prop := ∀ x, InSvc x → m' x = m x

theorem Frame.trans {a b c : Word → Byte} (h1 : Frame a b) (h2 : Frame b c) : Frame a c :=
  fun x i p v => (h2 x i p v).trans (h1 x i p v)

theorem SvcSame.trans {a b c : Word → Byte} (h1 : SvcSame a b) (h2 : SvcSame b c) : SvcSame a c :=
  fun x h => (h2 x h).trans (h1 x h)

theorem SvcSame.read {m m' : Word → Byte} (h : SvcSame m m') (a : Word)
    (ha : 0xc0000010 ≤ a.toNat ∧ a.toNat + 4 ≤ 0xc0000020) : readLE m' a 4 = readLE m a 4 := by
  apply readLE_four_congr
  intro d hd
  apply h
  unfold InSvc
  simp only [BitVec.toNat_add, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod]
  omega


theorem writeLE4_apply (m : Word → Byte) (a : Word) (v : Nat) (x : Word) :
    writeLE m a v 4 x = if (x - a).toNat < 4 then BitVec.ofNat 8 (v / 256 ^ (x - a).toNat) else m x :=
  writeLE_apply m a v 4 (by decide) x


/-! ## Boot, first half: configure the PMP, the trap vector, the stack and `mret` target -/

/-- [Charm 1] Memory as boot leaves it: the shrine's two words, which read as the bytes "OMAMKUAI". -/
def shrined (M0 : Word → Byte) : Word → Byte :=
  writeLE (writeLE M0 0x80008010#32 0x4d414d4f 4) 0x80008014#32 0x4941554b 4

/-- The shrine is outside the monitor's words. -/
theorem agree_shrined (M0 : Word → Byte) : Agree M0 (shrined M0) 0x80000000 712 := by
  unfold shrined
  rw [agree_writeLE_iff _ _ (by decide) (by decide), agree_writeLE_iff _ _ (by decide) (by decide)]
  exact Agree.refl _ _ _

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 100000 in
/-- Boot's first 35 steps, from any CSRs at all but a locked PMP entry: they write every CSR the model has,
    so `csrsConfigured` is where they end whatever was there, and then the shrine's first word [Charm 1]. Until
    `pmpcfg0` is written the PMP is whatever the machine came with, and what lets M-mode run through it is that none
    of its entries is locked (`pmpCheck_M_unlocked`). -/
theorem monitor_boot_config (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem : s.core.mem = M0)
    (hpc : s.core.pc = 0x80000040#32) (hh : s.halted = false) (hm : s.mode = .M)
    (hlock : PmpUnlocked s.csrs.pmpcfg0) (henv : env.region = monRegion) :
    (PrivMachine.run env 35 s).core.pc = 0x800000cc#32 ∧
    (PrivMachine.run env 35 s).core.mem = writeLE M0 0x80008010#32 0x4d414d4f 4 ∧
    (PrivMachine.run env 35 s).halted = false ∧
    (PrivMachine.run env 35 s).mode = .M ∧
    (PrivMachine.run env 35 s).csrs = csrsConfigured ∧
    (PrivMachine.run env 35 s).core.reg 5#5 = 0x80008010#32 := by
  have sm := sm_mon env M0 hW
  have l0 := hlock 0
  have l1 := hlock 1
  have l2 := hlock 2
  have l3 := hlock 3
  have hcfg : PmpUnlocked 0x191b1b1d#32 := by intro i; revert i; decide
  have k3 := hcfg 3
  -- the counters count until `csrwi mcountinhibit, 5`, or not, as the inhibit bits they find say; then they are zeroed
  rcases hci : s.csrs.mcountinhibit with ⟨_ | _, _ | _⟩ <;>
  · obtain ⟨F, hF⟩ : ∃ F, PrivMachine.run env 35 s = F := ⟨_, rfl⟩
    rw [hF]
    psimpH [sm, hmem, hpc, monitorCode, hh, hm, hci, l0, l1, l2, l3, k3, hlock, hcfg, pmpCheck_M_unlocked, henv,
      monRegion] at hF
    subst hF
    psimpH [hpc, hmem, csrsConfigured]

