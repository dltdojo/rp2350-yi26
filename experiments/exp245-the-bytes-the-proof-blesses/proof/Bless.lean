    readLE (PrivMachine.run env 34 s).core.mem 0x80008000#32 4 = readLE s.core.mem 0x80008000#32 4 ∧
    readLE (PrivMachine.run env 34 s).core.mem 0x80008004#32 4 = readLE s.core.mem 0x80008004#32 4 ∧
