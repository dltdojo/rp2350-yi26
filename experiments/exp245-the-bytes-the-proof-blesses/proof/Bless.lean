      apply BitVec.eq_of_toNat_eq
      have := A.isLt
      simp only [BitVec.toNat_add, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod]
      omega
    obtain ⟨p, a, h, m', c', o, i, x, rr⟩ := zloop_iter_slot env M0 s hS ms e c m cy A E hpc hcs hA hE hal hlo (by omega)
    refine ⟨?_, a, h, m', c', o, i, ?_, ?_⟩
    · rw [p]; simp [hAE]
