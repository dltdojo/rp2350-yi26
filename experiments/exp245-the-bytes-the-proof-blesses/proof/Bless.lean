/-- From reset (the image loaded at `0x80000000`, `pc = 0x80000040`, M-mode, any CSRs that lock no PMP entry --
    reset's among them -- any registers), 71 steps leave the machine in U-mode at the payload's first word, the PMP fencing it
    in with three entries -- code `[0x80010000, 0x80010080)` read and execute, data `[0x80010000, 0x80011000)` and
    stack `[0x8001f000, 0x80020000)` read and write -- every register zero but `sp`, the shrine's two words written [Charm 1], and the rest of memory untouched. -/
theorem monitor_boot (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hW : WordsAt M0 0x80000000#32 monitorCode) (hmem : s.core.mem = M0)
    (hpc : s.core.pc = 0x80000040#32) (hh : s.halted = false) (hm : s.mode = .M)
    (hlock : PmpUnlocked s.csrs.pmpcfg0) (henv : env.region = monRegion) :
    WXBoxed (PrivMachine.run env 71 s) 0x80010000 0x80010080 0x80010000 0x80011000 0x8001f000 0x80020000 ∧
    (PrivMachine.run env 71 s).core.pc = 0x80010000#32 ∧
    (PrivMachine.run env 71 s).csrs = csrsBooted ∧
    (PrivMachine.run env 71 s).core.mem = shrined M0 ∧
    (∀ r, (PrivMachine.run env 71 s).core.reg r = if r = 2 then 0x80020000#32 else 0#32) := by
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := monitor_boot_config env M0 s hW hmem hpc hh hm hlock henv
  have hA1 : Agree M0 (PrivMachine.run env 35 s).core.mem 0x80000000 712 := by
    rw [b2, agree_writeLE_iff _ _ (by decide) (by decide)]; exact Agree.refl _ _ _
  obtain ⟨c1, c2, c3, c4, c5⟩ := monitor_boot_shrine env M0 _ hW hA1 b1 b3 b4 b5 b6 henv
  rw [b2] at c2
  have hW1 : WordsAt (shrined M0) 0x80000000#32 monitorCode :=
    WordsAt.of_agree (by rw [monitorCode_length]; decide) (by rw [monitorCode_length]; exact agree_shrined M0) hW
  have hC0 : Cleared 0 (PrivMachine.run env 3 (PrivMachine.run env 35 s)) := by
    intro r hr
    have : r = 0 := by bv_omega
    subst this
    simp
  obtain ⟨a1, a2, a3, a4, a5, a6⟩ := monitor_launch_1 env (shrined M0) _ hW1 c2 c1 c3 c4 c5 hC0
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := monitor_launch_2 env (shrined M0) _ hW1 a2 a1 a3 a4 a5 a6
  obtain ⟨e1, e2, e3, e4, e5, e6⟩ := monitor_launch_3 env (shrined M0) _ hW1 b2 b1 b3 b4 b5 b6
  obtain ⟨g1, g2, g3, g4, g5, g6⟩ := monitor_launch_4 env (shrined M0) _ hW1 e2 e1 e3 e4 e5
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, hb, h13⟩ :=
    monitor_launch_5 env (shrined M0) _ hW1 g2 g1 g3 g4 g5
  rw [show 71 = 35 + 3 + 12 + 12 + 7 + 1 + 1 from rfl, PrivMachine.run_add, PrivMachine.run_add,
    PrivMachine.run_add, PrivMachine.run_add, PrivMachine.run_add, PrivMachine.run_add]
  refine ⟨⟨h4, h3, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, h1, hb, h2, ?_⟩
  · rw [h5]; decide
  · rw [h5]; decide
  · rw [h5]; decide
  · exact Or.inr (by simp [h9, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop])
  · simp [h6, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop]
  · simp [h7, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop]
  · simp [h8, decodeNapotRange, countTrailingOnes32, countTrailingOnes32.loop]
  · intro r
    rw [h13 r, g6 r]
    exact e6 r (by have h := r.isLt; omega)


theorem run_two {env : Rv32.Env} {n m : Nat} {s s1 s2 : PrivMachine}
    (h1 : PrivMachine.run env n s = s1) (h2 : PrivMachine.run env m s1 = s2) :
    PrivMachine.run env (n + m) s = s2 := by
  rw [PrivMachine.run_add, h1, h2]

/-- A register a chunk did not name is what it was. -/
theorem reg_keep {cur prev : Reg → Word} {l : List (Nat × Word)} {k : Reg} {v : Word}
    (hr : ∀ r, cur r = regsUpd prev l r) (hn : l.find? (fun p => p.1 == k.toNat) = none)
    (hv : prev k = v) : cur k = v := by
  rw [hr k]; simp [regsUpd, hn, hv]

/-- A register a chunk named is what it was told. -/
theorem reg_set {cur prev : Reg → Word} {l : List (Nat × Word)} {k : Reg} {v : Word}
    (hr : ∀ r, cur r = regsUpd prev l r) (hn : l.find? (fun p => p.1 == k.toNat) = some (k.toNat, v)) :
    cur k = v := by
  rw [hr k]; simp [regsUpd, hn]

/-- The state after a chunk is a handler state again. -/
theorem HState.next {env : Rv32.Env} {M0 : Word → Byte} {s t : PrivMachine} (hS : HState env M0 s)
    (ha : Agree M0 t.core.mem 0x80000000 712) (hh : t.halted = false) (hm : t.mode = .M) :
    HState env M0 t := ⟨hS.words, ha, hS.region, hh, hm⟩


theorem ofNat_toNat_mod (x : Word) : BitVec.ofNat 32 (x.toNat % 4294967296) = x := by
  apply BitVec.eq_of_toNat_eq
  have := x.isLt
  simp only [BitVec.toNat_ofNat, Nat.reducePow]
  omega


/-! ## What the monitor writes, and where -/

/-- With the PMP boot set, an M-mode word access is not refused anywhere, the payload's box included: no entry is
    locked, so the entries bind U-mode and leave M-mode alone. The scrub of the slot needs it. -/
theorem pmpCheck_mon_in (csrs : PrivCSRs) (addr : Word) (width : Nat) (acc : AccessType)
    (h0 : csrs.pmpcfg0 = 0x191b1b1d#32) (hw : width = 4) (hal : addr.toNat % 4 = 0) :
    pmpCheck csrs .M addr width acc = true := by
  subst hw
  exact pmpCheck_M_unlocked csrs addr acc (by rw [h0]; intro i; revert i; decide) hal

/-- A four-byte read the monitor's stack words, report words and service port do not touch: what a chunk's `Frame`
    leaves as it was. The shrine is one. -/
theorem Frame.read {m m' : Word → Byte} (h : Frame m m') (a : Word)
    (ha : 0x80008010 ≤ a.toNat ∧ a.toNat + 4 ≤ 0xc0000000) : readLE m' a 4 = readLE m a 4 := by
  apply readLE_four_congr
  intro d hd
  have := a.isLt
  apply h <;> simp only [InStack, InPorts, InSvc, BitVec.toNat_add, BitVec.toNat_ofNat, Nat.reducePow] <;> omega

/-- Memory outside the monitor's stack words and report words is what it was. -/
def FrameSP (m m' : Word → Byte) : Prop := ∀ x, ¬ InStack x → ¬ InPorts x → m' x = m x

theorem frameSP_of {m m' : Word → Byte} (f : Frame m m') (v : SvcSame m m') : FrameSP m m' := by
  intro x hs hp
  by_cases hv : InSvc x
  · exact v x hv
  · exact f x hs hp hv

theorem FrameSP.trans {a b c : Word → Byte} (h1 : FrameSP a b) (h2 : FrameSP b c) : FrameSP a c :=
  fun x i p => (h2 x i p).trans (h1 x i p)

/-- [Charm 3] The sacred key slot, `[0x80010e00, 0x80010e20)`, in the data. -/
def InSlot (x : Word) : Prop := 0x80010e00 ≤ x.toNat ∧ x.toNat < 0x80010e20

/-- **What an exit leaves of memory.** The slot zero; every other byte but the monitor's stack words and report words
    as it was. -/
def SlotFrame (m m' : Word → Byte) : Prop :=
  (∀ x, InSlot x → m' x = 0) ∧ (∀ x, ¬ InStack x → ¬ InPorts x → ¬ InSlot x → m' x = m x)

/-- The part of a trap before the scrub, which wrote nothing but the stack and report words, then the scrub. -/
theorem slotFrame_of {m0 m1 m2 : Word → Byte} (f : FrameSP m0 m1) (s : SlotFrame m1 m2) : SlotFrame m0 m2 := by
  refine ⟨s.1, ?_⟩
  intro x h1 h2 h3
  rw [s.2 x h1 h2 h3, f x h1 h2]

/-- The scrub of the slot: the slot setup, which writes nothing, the loop, the registers' scrub, which writes nothing
    but the exit word. -/
theorem slotFrame_scrub {m0 m1 m2 m3 : Word → Byte} (f1 : Frame m0 m1) (v1 : SvcSame m0 m1)
    (z : Zeroed 0x80010e00 0x80010e20 m1 m2) (f3 : Frame m2 m3) (v3 : SvcSame m2 m3) : SlotFrame m0 m3 := by
  have g1 := frameSP_of f1 v1
  have g3 := frameSP_of f3 v3
  refine ⟨?_, ?_⟩
  · intro x hx
    unfold InSlot at hx
    have hs : ¬ InStack x := by unfold InStack; omega
    have hp : ¬ InPorts x := by unfold InPorts; omega
    rw [g3 x hs hp, (z x).1 hx]
  · intro x hs hp hl
    unfold InSlot at hl
    rw [g3 x hs hp, (z x).2 hl, g1 x hs hp]

/-! ## The park loop, and the exit code -/

/-- The park loop, reached: every register but `a0` zero, `mscratch` zero, the two words trap entry saved zero. -/
def Parked (t : PrivMachine) (a0 : Word) : Prop :=
  t.core.pc = 0x800002c0#32 ∧ t.halted = false ∧ t.mode = .M ∧ t.csrs.mscratch = 0#32 ∧
  readLE t.core.mem 0x80008000#32 4 = 0 ∧ readLE t.core.mem 0x80008004#32 4 = 0 ∧
  t.core.reg 10#5 = a0 ∧ ∀ r, r ≠ 10#5 → t.core.reg r = 0#32

/-- [Charm 1] The shrine holds the seal: its two words read "OMAM" and "KUAI". -/
def Sealed (m : Word → Byte) : Prop :=
  BitVec.ofNat 32 (readLE m 0x80008010#32 4) = 0x4d414d4f#32 ∧
  BitVec.ofNat 32 (readLE m 0x80008014#32 4) = 0x4941554b#32

instance (m : Word → Byte) : Decidable (Sealed m) := inferInstanceAs (Decidable (_ ∧ _))

/-- The code the monitor parks with after a trap: the payload's own `a0` if it asked for HALT (`ecall` with
    `t0 = 1`) and the seal is intact, and 1 for everything else. -/
def exitCode (u : PrivMachine) : Word :=
  if u.csrs.mcause = 8#32 ∧ u.core.reg 5#5 = 1#32 ∧ Sealed u.core.mem then u.core.reg 10#5 else 1#32

/-- A fault's report to the print word: the tag, `mcause`, `mepc`, `mtval` (0: Hazard3 hardwires it)
    and `minstret`. -/
def faultIo (u : PrivMachine) : List IoEvent :=
  [⟨0xc0000004#32, 0x4641554c#32⟩, ⟨0xc0000004#32, u.csrs.mcause⟩, ⟨0xc0000004#32, u.csrs.mepc⟩,
   ⟨0xc0000004#32, 0#32⟩, ⟨0xc0000004#32, u.csrs.minstret⟩]

/-- A HALT's report to the print word: the tag, the payload's `a0`, `minstret` and `mcycle`. -/
def haltIo (u : PrivMachine) : List IoEvent :=
  [⟨0xc0000004#32, 0x48414c54#32⟩, ⟨0xc0000004#32, u.core.reg 10#5⟩, ⟨0xc0000004#32, u.csrs.minstret⟩,
   ⟨0xc0000004#32, u.csrs.mcycle⟩]

/-- What the host hears of a trap, in order: the report for the way it trapped, then the exit code to the exit word. -/
def trapIo (u : PrivMachine) : List IoEvent :=
  (if u.csrs.mcause = 8#32 ∧ u.core.reg 5#5 = 1#32 ∧ Sealed u.core.mem then haltIo u else faultIo u) ++
    [⟨0xc0000008#32, exitCode u⟩]

/-- How many steps the monitor takes from the trap vector to the park loop: an `ecall` for HALT with the seal intact,
    95; with its first word wrong, 96; with its second wrong, 100; an `ecall` for anything else, 90; any other trap, 87. -/
def trapSteps (u : PrivMachine) : Nat :=
  if u.csrs.mcause = 8#32 then
    (if u.core.reg 5#5 = 1#32 then
      (if BitVec.ofNat 32 (readLE u.core.mem 0x80008010#32 4) = 0x4d414d4f#32 then
        (if BitVec.ofNat 32 (readLE u.core.mem 0x80008014#32 4) = 0x4941554b#32 then 95 else 100) else 96)
     else 90)
  else 87

/-- The machine `k` steps into the payload, after boot's `71`. -/
def payloadAt (env : Rv32.Env) (s : PrivMachine) (k : Nat) : PrivMachine :=
  PrivMachine.run env k (PrivMachine.run env 71 s)

/-- The machine the monitor leaves after handling the trap at `u`. -/
def parkedAfter (env : Rv32.Env) (u : PrivMachine) : PrivMachine :=
  PrivMachine.run env (trapSteps u) u

/-- The bytes of the code entry, `[0x80010000, 0x80010080)`, are `C`'s. -/
def CodeSame (C : Word → Byte) (m : Word → Byte) : Prop :=
  ∀ x : Word, 0x80010000 ≤ x.toNat → x.toNat < 0x80010080 → m x = C x

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 100000 in
/-- Trap entry, first three words: freeze the counters, swap in the M-mode stack, save `t0`. -/
theorem entry_1 (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hS : HState env M0 s) (ms : MStatus) (e c m cy : Word)
    (hpc : s.core.pc = 0x8000015c#32) (hcs : s.csrs = csrsH ms e c m cy {} (0x80008000#32)) :
    (PrivMachine.run env 3 s).core.pc = 0x80000168#32 ∧
    Agree M0 (PrivMachine.run env 3 s).core.mem 0x80000000 712 ∧
    (PrivMachine.run env 3 s).halted = false ∧
    (PrivMachine.run env 3 s).mode = .M ∧
    (PrivMachine.run env 3 s).csrs = csrsH ms e c m cy { cy := true, ir := true } (s.core.reg 2#5) ∧
    (PrivMachine.run env 3 s).host = s.host ∧
    (PrivMachine.run env 3 s).io = s.io ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x80008000#32 4 = (s.core.reg 5#5).toNat % 4294967296 ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x80008004#32 4 = readLE s.core.mem 0x80008004#32 4 ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x80008008#32 4 = readLE s.core.mem 0x80008008#32 4 ∧
    readLE (PrivMachine.run env 3 s).core.mem 0x8000800c#32 4 = readLE s.core.mem 0x8000800c#32 4 ∧
    SvcSame s.core.mem (PrivMachine.run env 3 s).core.mem ∧
    Frame s.core.mem (PrivMachine.run env 3 s).core.mem ∧
    (∀ r, (PrivMachine.run env 3 s).core.reg r = regsUpd s.core.reg [(2, 0x80008000#32)] r) := by
  obtain ⟨hW, hA, henv, hh, hm⟩ := hS
  obtain ⟨Mc, hmem⟩ : ∃ Mc, s.core.mem = Mc := ⟨_, rfl⟩
  have hA' : Agree M0 Mc 0x80000000 712 := hmem ▸ hA
  have sm : ∀ t : PrivMachine, Agree M0 t.core.mem 0x80000000 712 →
      (t.core.pc - 0x80000000#32).toNat / 4 < monitorCode.length →
      (t.core.pc - 0x80000000#32).toNat % 4 = 0 →
      PrivMachine.step env t =
        PrivMachine.stepW env t (monitorCode.getD ((t.core.pc - 0x80000000#32).toNat / 4) 0) :=
    fun t ht h1 h2 => step_mon hW ht h1 h2
  obtain ⟨F, hF⟩ : ∃ F, PrivMachine.run env 3 s = F := ⟨_, rfl⟩
  rw [hF]
  all_goals psimpH [pmpCheck_mon, sm, hmem, hA', henv, monRegion, agree_writeLE_iff, hpc, monitorCode, hh, hm, hcs, csrsH, csrsFixed, csrsConfigured] at hF
  all_goals subst hF
  all_goals refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals try psimpH [pmpCheck_mon, hpc, hmem, hA', agree_writeLE_iff, csrsH, csrsFixed, csrsConfigured, readLE_writeLE_self, readLE_writeLE_far, regsUpd]
  all_goals try (unfold Frame
                 intro x h1 h2 h3
                 simp only [writeLE4_apply, InStack, InPorts, InSvc, BitVec.toNat_sub, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod] at h1 h2 h3 ⊢
