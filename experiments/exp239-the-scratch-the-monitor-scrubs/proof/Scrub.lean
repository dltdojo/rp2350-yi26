theorem zloop_iter_conf (env : Rv32.Env) (M0 : Word → Byte) (s : PrivMachine)
    (hS : HState env M0 s) (ms : MStatus) (e c m cy : Word) (A E : Word)
    (hpc : s.core.pc = 0x800001b8#32)
    (hcs : s.csrs = csrsH ms e c m cy { cy := true, ir := true } (0#32))
