/-! ## The specification

The subset of tapscript the kernel runs, as functions of the script, the stack
and the world: `env.hash` for OP_SHA256 and `env.sig` for OP_CHECKSIG, whatever
they are. script.py is the same thing in Python, and the README says where both
are stricter than BIP342. -/

abbrev Elem := List Byte

def SMAX : Nat := 1020
def EMAX : Nat := 80
def DMAX : Nat := 32

/-- The halt codes: 0 accepts. -/
def C_OK : Nat := 0
def C_BAD : Nat := 1
def C_PAST : Nat := 2
def C_UNDER : Nat := 3
def C_OVER : Nat := 4
def C_NUM : Nat := 5
def C_VERIFY : Nat := 6
def C_SIZE : Nat := 7
def C_INVALID : Nat := 8
def C_COUNT : Nat := 9
def C_CLEAN : Nat := 10
def C_FALSE : Nat := 11
def C_EQV : Nat := 12

/-- CastToBool: some byte is not zero, unless the only one is a last 0x80. -/
def cast : Elem → Bool
  | [] => false
  | [b] => b != 0 && b != 0x80
  | b :: c :: rest => b != 0 || cast (c :: rest)

/-- Little-endian, as a number. -/
def leNat : List Byte → Nat
  | [] => 0
  | b :: rest => b.toNat + 256 * leNat rest

/-- A number from an element: at most four bytes, minimally encoded, sign and
magnitude, little-endian. -/
def decode (e : Elem) : Option Int :=
  if 4 < e.length then none
  else if e.length = 0 then some 0
  else
    let last := e.getD (e.length - 1) 0
    if last &&& 0x7f = 0 ∧ (e.length = 1 ∨ e.getD (e.length - 2) 0 &&& 0x80 = 0) then none
    else
      let mag : Int := (leNat e % 2 ^ (8 * e.length - 1) : Nat)
      some (if 0x80 ≤ last.toNat then -mag else mag)

/-- A magnitude's bytes, little-endian, as few as hold it. -/
def magBytes (n : Nat) : List Byte :=
  if n = 0 then [] else BitVec.ofNat 8 (n % 256) :: magBytes (n / 256)
termination_by n
decreasing_by omega

/-- An element from a number: Bitcoin Core's CScriptNum::serialize. -/
def encode (v : Int) : Elem :=
  if v = 0 then []
  else
    let m := magBytes v.natAbs
    let top := m.getD (m.length - 1) 0
    if top &&& 0x80 ≠ 0 then m ++ [if v < 0 then 0x80 else 0]
    else if v < 0 then m.take (m.length - 1) ++ [top ||| 0x80]
    else m

/-- Where the interpreter is: the next script byte, the stack (top first), and
how many signatures it has checked. -/
structure Cfg where
  pc : Nat
  st : List Elem
  sigs : Nat

/-- One opcode's outcome: on to the next, or a halt code. -/
inductive Res
  | next (c : Cfg)
  | done (code : Nat)

def pushE (c : Cfg) (pc : Nat) (e : Elem) : Res :=
  if DMAX ≤ c.st.length then .done C_OVER else .next ⟨pc, e :: c.st, c.sigs⟩

/-- One opcode, at `c.pc`, which is inside the script. -/
def stepOp (env : Env) (scr : List Byte) (c : Cfg) : Res :=
  let op := (scr.getD c.pc 0).toNat
  let pc := c.pc + 1
  if op = 0 then pushE c pc []
  else if op ≤ 0x4b then
    if scr.length < pc + op then .done C_PAST
    else pushE c (pc + op) ((scr.drop pc).take op)
  else if op = 0x4f then pushE c pc [0x81]
  else if 0x51 ≤ op ∧ op ≤ 0x60 then pushE c pc [BitVec.ofNat 8 (op - 0x50)]
  else if op = 0x61 then .next ⟨pc, c.st, c.sigs⟩
  else if op = 0x69 then
