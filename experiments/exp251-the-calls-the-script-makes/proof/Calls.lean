      congr 2
    have k3 : ∀ x : Reg, x ≠ 6 → x ≠ 7 → x ≠ 13 → x ≠ 14 → s3.reg x = s.reg x := fun x h6 h7 h13 h14 => by
      rw [r3 x]; simp only [h14, false_and, ↓reduceIte]; rw [r2 x]; simp only [h13, false_and, ↓reduceIte]
