def bytes : List UInt8 := toBytes kernel

def image : ByteArray := ⟨bytes.toArray⟩

/-! ## Bits -/

theorem up1_bit (x : Word) (i : Nat) (hi : i < 32) : (up1 x).getLsbD i = x.getLsbD ((i + 31) % 32) := by
  rcases (by omega : i = 0 ∨ (0 < i ∧ i < 32)) with h | ⟨h0, h1⟩
  · subst h; simp [up1]
  · have b : (i + 31) % 32 = i - 1 := by omega
    simp [up1, b, h1, show ¬ i < 1 by omega, BitVec.getLsbD_of_ge x (31 + i) (by omega)]
    exact (BitVec.getLsbD_eq_getElem (by omega)).symm

theorem dn1_bit (x : Word) (i : Nat) (hi : i < 32) : (dn1 x).getLsbD i = x.getLsbD ((i + 1) % 32) := by
  rcases (by omega : i = 31 ∨ i < 31) with h | h
  · subst h; simp [dn1]
  · have a : (i + 1) % 32 = 1 + i := by omega
    simp [dn1, a, hi, show i < 31 from h]

/-! ## Counting bits -/

theorem pc_congr {a b : Word} : ∀ n, (∀ i < n, a.getLsbD i = b.getLsbD i) → pc a n = pc b n
  | 0, _ => rfl
  | n + 1, h => by simp only [pc]; rw [pc_congr n (fun i hi => h i (by omega)), h n (by omega)]

theorem pc_le (a : Word) : ∀ n, pc a n ≤ n
  | 0 => Nat.le_refl _
  | n + 1 => by simp only [pc]; have := pc_le a n; cases a.getLsbD n <;> simp <;> omega

/-- A word's set bits are those also in `b` and those not. -/
theorem pc_split (a b : Word) : ∀ n, n ≤ 32 → pc (a &&& ~~~b) n + pc (a &&& b) n = pc a n
  | 0, _ => rfl
  | n + 1, hn => by
    have ih := pc_split a b n (by omega)
    simp only [pc, BitVec.getLsbD_and, BitVec.getLsbD_not, show n < 32 by omega, decide_true, Bool.true_and]
    cases a.getLsbD n <;> cases b.getLsbD n <;> simp <;> omega

theorem pc_and_le (a b : Word) : ∀ n, pc (a &&& b) n ≤ pc a n
  | 0 => Nat.le_refl _
  | n + 1 => by
    have ih := pc_and_le a b n
    simp only [pc, BitVec.getLsbD_and]
    cases a.getLsbD n <;> cases b.getLsbD n <;> simp <;> omega

/-- No bit set below `n` and the count is zero, and back. -/
theorem pc_zero (a : Word) : ∀ n, pc a n = 0 → ∀ i < n, a.getLsbD i = false
  | 0, _, i, hi => absurd hi (Nat.not_lt_zero _)
  | n + 1, h, i, hi => by
    simp only [pc] at h
    rcases (by omega : i < n ∨ i = n) with h' | h'
    · exact pc_zero a n (by omega) i h'
    · subst h'; cases e : a.getLsbD i <;> simp_all

/-- Moving the ring one cell up keeps its count: the top cell comes round to the bottom. -/
theorem pc_up1 (x : Word) : pc (up1 x) 32 = pc x 32 := by
  have h : ∀ k, k < 32 → pc (up1 x) (k + 1) = (x.getLsbD 31).toNat + pc x k := by
    intro k
    induction k with
    | zero => intro _; simp only [pc]; rw [up1_bit x 0 (by decide)]; simp
    | succ k ih =>
      intro hk
      rw [show k + 1 + 1 = (k + 1) + 1 from rfl]
      simp only [pc] at ih ⊢
      rw [ih (by omega), up1_bit x (k + 1) hk, show (k + 1 + 31) % 32 = k by omega]
      omega
  have := h 31 (by decide)
  simp only [pc] at this ⊢
  omega

/-- And one cell down: the bottom cell comes round to the top. -/
theorem pc_dn1 (x : Word) : pc (dn1 x) 32 = pc x 32 := by
  have h : ∀ k, k < 32 → pc (dn1 x) k + (x.getLsbD 0).toNat = pc x (k + 1) := by
    intro k
    induction k with
    | zero => intro _; simp [pc]
    | succ k ih =>
      intro hk
      simp only [pc] at ih ⊢
      rw [dn1_bit x k (by omega), show (k + 1) % 32 = k + 1 by omega]
      have := ih (by omega)
      omega
  have h31 := h 31 (by decide)
  simp only [pc] at h31 ⊢
  rw [dn1_bit x 31 (by decide), show (31 + 1) % 32 = 0 from rfl]
  omega

/-! ## T3: the fly sees Rule 30 move up, or not at all -/

/-- Under Rule 30, what moved up is the cells whose lower neighbour was lit
and upper neighbour dark. -/
theorem up_life (x : Word) : up1 x &&& life x = up1 x &&& ~~~(dn1 x) := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [life, BitVec.getLsbD_and, BitVec.getLsbD_xor, BitVec.getLsbD_or, BitVec.getLsbD_not, hi,
    decide_true, Bool.true_and]
  cases (up1 x).getLsbD i <;> cases (dn1 x).getLsbD i <;> cases x.getLsbD i <;> rfl

/-- And what moved down is the cells whose upper neighbour was lit, lower
neighbour dark, and which were dark themselves. -/
theorem dn_life (x : Word) : dn1 x &&& life x = (dn1 x &&& ~~~(up1 x)) &&& ~~~x := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [life, BitVec.getLsbD_and, BitVec.getLsbD_xor, BitVec.getLsbD_or, BitVec.getLsbD_not, hi,
    decide_true, Bool.true_and]
  cases (up1 x).getLsbD i <;> cases (dn1 x).getLsbD i <;> cases x.getLsbD i <;> rfl

/-- **T3.** Whatever the ring holds, the fly watching one generation of Rule 30
counts at least as much moving up as moving down. -/
theorem life_moves_up (x : Word) : toDn x (life x) ≤ toUp x (life x) := by
  unfold toUp toDn
  rw [up_life, dn_life]
  have s1 := pc_split (up1 x) (dn1 x) 32 (Nat.le_refl _)
  have s2 := pc_split (dn1 x) (up1 x) 32 (Nat.le_refl _)
  have c : pc (up1 x &&& dn1 x) 32 = pc (dn1 x &&& up1 x) 32 := by rw [BitVec.and_comm]
  have le := pc_and_le (dn1 x &&& ~~~(up1 x)) (~~~x) 32
  rw [pc_up1] at s1
  rw [pc_dn1] at s2
  omega

/-! ## T2: a moving stripe is seen moving its way -/

/-- **T2, up.** A frame moved one cell up is seen moving up, strictly — unless
moving it two cells gives it back, when up and down cannot be told apart. -/
theorem shift_up (x : Word) (h : up1 (up1 x) ≠ x) : toDn x (up1 x) < toUp x (up1 x) := by
  unfold toUp toDn
  rw [BitVec.and_self]
  have s1 := pc_split (up1 x) (dn1 x) 32 (Nat.le_refl _)
  have s2 := pc_split (dn1 x) (up1 x) 32 (Nat.le_refl _)
  have c : pc (up1 x &&& dn1 x) 32 = pc (dn1 x &&& up1 x) 32 := by rw [BitVec.and_comm]
  rw [pc_up1] at s1 ⊢
  rw [pc_dn1] at s2
  refine Nat.lt_of_not_le (fun hn => h ?_)
  have z1 := pc_zero (up1 x &&& ~~~(dn1 x)) 32 (by omega)
  have z2 := pc_zero (dn1 x &&& ~~~(up1 x)) 32 (by omega)
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  have e : (up1 x).getLsbD ((i + 31) % 32) = (dn1 x).getLsbD ((i + 31) % 32) := by
    have a1 := z1 ((i + 31) % 32) (by omega)
    have a2 := z2 ((i + 31) % 32) (by omega)
    simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, show (i + 31) % 32 < 32 by omega, decide_true,
      Bool.true_and] at a1 a2
    revert a1 a2
    cases (up1 x).getLsbD ((i + 31) % 32) <;> cases (dn1 x).getLsbD ((i + 31) % 32) <;> simp
  rw [up1_bit _ i hi, e, dn1_bit x _ (by omega), show ((i + 31) % 32 + 1) % 32 = i by omega]

/-- **T2, down.** And a frame moved one cell down is seen moving down. -/
theorem shift_dn (x : Word) (h : dn1 (dn1 x) ≠ x) : toUp x (dn1 x) < toDn x (dn1 x) := by
  unfold toUp toDn
  rw [BitVec.and_self]
  have s1 := pc_split (up1 x) (dn1 x) 32 (Nat.le_refl _)
  have s2 := pc_split (dn1 x) (up1 x) 32 (Nat.le_refl _)
  have c : pc (up1 x &&& dn1 x) 32 = pc (dn1 x &&& up1 x) 32 := by rw [BitVec.and_comm]
  rw [pc_up1] at s1
  rw [pc_dn1] at s2 ⊢
  refine Nat.lt_of_not_le (fun hn => h ?_)
  have z1 := pc_zero (up1 x &&& ~~~(dn1 x)) 32 (by omega)
  have z2 := pc_zero (dn1 x &&& ~~~(up1 x)) 32 (by omega)
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  have e : (dn1 x).getLsbD ((i + 1) % 32) = (up1 x).getLsbD ((i + 1) % 32) := by
    have a1 := z1 ((i + 1) % 32) (by omega)
    have a2 := z2 ((i + 1) % 32) (by omega)
    simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, show (i + 1) % 32 < 32 by omega, decide_true,
      Bool.true_and] at a1 a2
    revert a1 a2
    cases (up1 x).getLsbD ((i + 1) % 32) <;> cases (dn1 x).getLsbD ((i + 1) % 32) <;> simp
  rw [dn1_bit _ i hi, e, up1_bit x _ (by omega), show ((i + 1) % 32 + 31) % 32 = i by omega]

end Exp230

