  .sh .srli 30 7 1,
  .sh .slli 31 7 31,
  .op .or 30 30 31,
  .op .and 29 29 28,
  .op .and 30 30 28,
  .opi .addi 13 0 0x0,
  .opi .addi 14 0 0x0,
  .opi .addi 5 0 0x20,
  .opi .andi 31 29 0x1,
  .op .add 13 13 31,
  .sh .srli 29 29 1,
  .opi .andi 31 30 0x1,
