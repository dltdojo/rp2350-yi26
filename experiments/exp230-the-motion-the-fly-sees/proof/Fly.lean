SPDX-License-Identifier: Apache-2.0

# exp230 — the motion the fly sees

The Hassenstein–Reichardt detector, in one bit a cell, on exp225's ring of
32 cells: the frame before, moved one cell up, ANDed with the frame now, and
counted; the same moved one cell down; the first count less the second is the
direction the fly sees.
-/
import Rv32.Blocks
import Rv32.Flow
import Rv32.Line
import Rv32.Limbs
import Rv32.Asm

namespace Exp230
open Rv32

/-! ## The specification -/

/-- How many of `x`'s low `n` bits are set. -/
def pc (x : Word) : Nat → Nat
  | 0 => 0
  | n + 1 => pc x n + (x.getLsbD n).toNat

/-- `x` moved one cell up, round the ring: bit i is x's bit i - 1. -/
def up1 (x : Word) : Word := x <<< 1 ||| x >>> 31

/-- `x` moved one cell down: bit i is x's bit i + 1. -/
def dn1 (x : Word) : Word := x >>> 1 ||| x <<< 31

/-- exp225's Rule 30: cell i becomes cell i + 1 XOR (cell i OR cell i - 1). -/
def life (x : Word) : Word := dn1 x ^^^ (up1 x ||| x)

/-- What moved up between frame `x` and frame `y`: cells lit in `y` whose
neighbour below was lit in `x`. -/
def toUp (x y : Word) : Nat := pc (up1 x &&& y) 32

/-- And what moved down. -/
def toDn (x y : Word) : Nat := pc (dn1 x &&& y) 32

/-! ## The kernel -/

-- BEGIN generated by kernel.py — do not edit

/-- Where each label is: an instruction number. -/
def ENTRY : Nat := 0
def STEP : Nat := 7
def BIT : Nat := 20
def DONE : Nat := 36

