/-! ## The three operations -/

/-- What the kernel is given: its code at base, p at PRIME, a and b. -/
structure Given (m : Word → Byte) (base : Word) (a b : Nat) : Prop where
  code : CodeAt m base kernel
  prime : numAt m base 0x800 8 = P
  ina : numAt m base 0x904 8 = a
  inb : numAt m base 0x924 8 = b

theorem P_lt : P < 2 ^ 256 := by unfold P; omega

theorem allOnes_se : (0 : Word) + (0xfff : BitVec 12).signExtend 32 = mask true := by
  rw [show (0xfff : BitVec 12) = BitVec.ofNat 12 4095 from rfl, se_neg 4095 (by decide) (by decide)]; decide

/-- **Addition**, from OP_ADD with s1 set: R is `(a + b) mod p`. -/
theorem add_run (hp : Placed env base) {s : Machine} {a b : Nat}
    (hpc : s.pc = base + BitVec.ofNat 32 (4 * OP_ADD)) (hg : Given s.mem base a b)
    (h9 : s.reg 9 = base + BitVec.ofNat 32 0x800) (ha : a < P) (hb : b < P) :
    ∃ s', run env 325 s = .running s' ∧ run env 326 s = .halted 0 s'
      ∧ numAt s'.mem base 0x944 8 = (a + b) % P := by
  have hfit := hp.fit
  have l1 : run env 1 s = .running (s.line [.opi .addi 13 0 0xfff]) :=
    run_line (prog := kernel) hp [.opi .addi 13 0 0xfff] rfl OP_ADD s (by decide) (by decide) hg.code hpc (by decide)
  generalize hs1 : s.line [.opi .addi 13 0 0xfff] = s1 at l1
  have p1 : s1.pc = base + BitVec.ofNat 32 (4 * A_ADDM) := by rw [← hs1, line_pc_at _ hpc (by decide)]; rfl
  have m1 : s1.mem = s.mem := by rw [← hs1, line_mem]
  have g13 : s1.reg 13 = mask true := by
    rw [← hs1]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluI]; regsimp
    rw [reg_zero]; exact allOnes_se
  have g9 : s1.reg 9 = base + BitVec.ofNat 32 0x800 := by
    rw [← hs1]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluI]; regsimp; exact h9
  obtain ⟨s2, e2, p2, kp2, n2, o2⟩ := addm_run hp a_addm (s := s1) (k := true) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) p1 (by rw [m1]; exact hg.code) g9 g13
  rw [m1] at kp2 n2
  have code2 : CodeAt s2.mem base kernel := Kept.code hfit kp2 (by rw [kernel_length]; decide) (by decide) hg.code
  have h92 : s2.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [o2 9 (by decide), g9]
  have hP2 : numAt s2.mem base 0x800 8 = P := by rw [kp2.num hfit (by decide) (by decide), hg.prime]
  have hS : numAt s2.mem base 0xb80 8 + 2 ^ 256 * wordAt s2.mem base (0xb80 + 32) = a + b := by
    have : numAt s2.mem base 0xb80 9 = numAt s2.mem base 0xb80 8 + wordAt s2.mem base (0xb80 + 4 * 8) * 2 ^ (32 * 8) := rfl
    rw [n2, hg.ina, hg.inb] at this
    simp only [ite_true] at this
    rw [show 32 * 8 = 256 from rfl] at this
    have e : (0xb80 + 4 * 8 : Nat) = 0xb80 + 32 := rfl
    rw [e] at this
    omega
  obtain ⟨s3, e3, p3, kp3, n3, h93⟩ := csub_run hp a_csub (s := s2) (by decide) (by decide) (by decide) p2 code2 h92 hP2
    (by rw [hS]; omega)
  rw [hS] at n3
  obtain ⟨s4, e4, e4', m4⟩ := halt_run hp a_halt (s := s3) p3
    (Kept.code hfit kp3 (by rw [kernel_length]; decide) (by decide) code2)
  refine ⟨s4, ?_, ?_, by rw [m4, n3]⟩
  · rw [show 325 = 1 + (118 + (204 + 2)) from rfl, run_add_running l1, run_add_running e2, run_add_running e3, e4]
  · rw [show 326 = 1 + (118 + (204 + 3)) from rfl, run_add_running l1, run_add_running e2, run_add_running e3, e4']

/-- `0 - t0`, a borrow of 0 or 1: the mask, all ones when it borrowed. -/
theorem neg_bit (w : Word) (h : w.toNat ≤ 1) : 0 - w = mask (decide (w.toNat = 1)) := by
  rcases (by omega : w.toNat = 0 ∨ w.toNat = 1) with e | e
  · have : w = 0 := BitVec.eq_of_toNat_eq (by rw [e]; rfl)
    subst this; decide
  · have : w = 1 := BitVec.eq_of_toNat_eq (by rw [e]; rfl)
    subst this; decide

/-- **Subtraction**, from OP_SUB with s1 set: R is `(a + p - b) mod p`. -/
theorem sub_run (hp : Placed env base) {s : Machine} {a b : Nat}
    (hpc : s.pc = base + BitVec.ofNat 32 (4 * OP_SUB)) (hg : Given s.mem base a b)
    (h9 : s.reg 9 = base + BitVec.ofNat 32 0x800) (ha : a < P) (hb : b < P) :
    ∃ s', run env 230 s = .running s' ∧ run env 231 s = .halted 0 s'
      ∧ numAt s'.mem base 0x944 8 = (a + P - b) % P := by
  have hfit := hp.fit
  obtain ⟨s1, e1, p1, kp1, f1, n1, o1⟩ := subn_run hp s_subn (s := s) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) hpc hg.code h9
  have code1 : CodeAt s1.mem base kernel := Kept.code hfit kp1 (by rw [kernel_length]; decide) (by decide) hg.code
  have l2 : run env 1 s1 = .running (s1.line [.op .sub 13 0 5]) :=
    run_line (prog := kernel) hp [.op .sub 13 0 5] rfl (S_SUBN + 18) s1 (by decide) (by decide) code1 p1 (by decide)
  generalize hs2 : s1.line [.op .sub 13 0 5] = s2 at l2
  have p2 : s2.pc = base + BitVec.ofNat 32 (4 * S_ADDM) := by rw [← hs2, line_pc_at _ p1 (by decide)]; rfl
  have m2 : s2.mem = s1.mem := by rw [← hs2, line_mem]
  have g13 : s2.reg 13 = mask (decide ((s1.reg 5).toNat = 1)) := by
    rw [← hs2]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluR]; regsimp
    rw [reg_zero]; exact neg_bit _ f1
  have g9 : s2.reg 9 = base + BitVec.ofNat 32 0x800 := by
    rw [← hs2]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluR]; regsimp
    rw [o1 9 (by decide), h9]
  obtain ⟨s3, e3, p3, kp3, n3, -⟩ := addm_run hp s_addm (s := s2) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) p2 (by rw [m2]; exact code1) g9 g13
  rw [m2] at kp3 n3
  have hP1 : numAt s1.mem base 0x800 8 = P := by rw [kp1.num hfit (by decide) (by decide), hg.prime]
  obtain ⟨s4, e4, e4', m4⟩ := halt_run hp s_halt (s := s3) p3
    (Kept.code hfit kp3 (by rw [kernel_length]; decide) (by decide) code1)
  refine ⟨s4, ?_, ?_, ?_⟩
  · rw [show 230 = 109 + (1 + (118 + 2)) from rfl, run_add_running e1, run_add_running l2, run_add_running e3, e4]
  · rw [show 231 = 109 + (1 + (118 + 3)) from rfl, run_add_running e1, run_add_running l2, run_add_running e3, e4']
  · rw [m4]
    have h9w : numAt s3.mem base 0x944 9
        = numAt s3.mem base 0x944 8 + wordAt s3.mem base (0x944 + 4 * 8) * 2 ^ (32 * 8) := rfl
    have hR := numAt_lt s3.mem base 0x944 8
    have hD := numAt_lt s1.mem base 0xb40 8
    rw [h9w, hP1] at n3
    rw [hg.ina, hg.inb] at n1
    rw [show 32 * 8 = 256 from rfl] at n3 hR hD
    have hPv : P = 2 ^ 256 - 2 ^ 32 - 977 := rfl
    have hN : a + P - b + b = a + P := Nat.sub_add_cancel (by omega)
    generalize a + P - b = N at hN ⊢
    rw [mod_lt2 (by omega)]
    by_cases hk : (s1.reg 5).toNat = 1
    · simp only [hk, decide_true, ↓reduceIte] at n3 n1
      rw [ifT (by omega)]
      omega
    · have hk0 : (s1.reg 5).toNat = 0 := by omega
      simp only [hk, hk0, decide_false, Bool.false_eq_true, ↓reduceIte] at n3 n1
      rw [ifF (by omega)]
      simp only [show decide ((0 : Nat) = 1) = false from rfl, Bool.false_eq_true, ↓reduceIte] at n3
      omega

/-- **The eight rows**: after `i`, T's first `8 + i` words are A's first `i` times B. -/
theorem rows_run (hp : Placed env base) {s : Machine}
    (hpc : s.pc = base + BitVec.ofNat 32 (4 * M_ROW0)) (hcode : CodeAt s.mem base kernel)
    (h9 : s.reg 9 = base + BitVec.ofNat 32 0x800) (hT : numAt s.mem base 0xa00 8 = 0) :
    ∀ i ≤ 8, ∃ s', run env (135 * i) s = .running s'
      ∧ s'.pc = base + BitVec.ofNat 32 (4 * (M_ROW0 + 23 * i))
      ∧ s'.reg 9 = base + BitVec.ofNat 32 0x800
      ∧ Kept s.mem s'.mem base 0xa00 0xa40
      ∧ numAt s'.mem base 0xa00 (8 + i) = numAt s.mem base 0x904 i * numAt s.mem base 0x924 8 := by
  have hfit := hp.fit
  intro i hi
  induction i with
  | zero => exact ⟨s, rfl, by simpa using hpc, h9, Kept.refl _ _ _ _, by rw [show 8 + 0 = 8 from rfl, hT]; simp [numAt]⟩
  | succ i ih =>
    obtain ⟨s1, e1, p1, g1, kp1, n1⟩ := ih (by omega)
    have hi' : i < 8 := by omega
    have code1 : CodeAt s1.mem base kernel := Kept.code hfit kp1 (by rw [kernel_length]; decide) (by decide) hcode
    obtain ⟨s2, e2, p2, kp2, n2, o2⟩ := row_run hp (m_rows i hi') (s := s1) ⟨by omega, by omega⟩ (by omega)
      (by decide) ⟨by omega, by omega⟩ (by decide) (by omega) (by omega) (by omega) p1 code1 g1
    have wa : wordAt s1.mem base (0x904 + 4 * i) = wordAt s.mem base (0x904 + 4 * i) :=
      kp1.word hfit (by omega) (by omega)
    have nb : numAt s1.mem base 0x924 8 = numAt s.mem base 0x924 8 := kp1.num hfit (by omega) (by omega)
    have ti : numAt s2.mem base 0xa00 i = numAt s1.mem base 0xa00 i := kp2.num hfit (by omega) (by omega)
    rw [wa, nb] at n2
    refine ⟨s2, ?_, ?_, by rw [o2 9 (by decide), g1], ?_, ?_⟩
    · rw [show 135 * (i + 1) = 135 * i + 135 by omega, run_add_running e1, e2]
    · rw [p2, show M_ROW0 + 23 * i + 23 = M_ROW0 + 23 * (i + 1) by omega]
    · exact kp1.trans (kp2.widen (by omega) (by omega))
    · have sp2 := numAt_split s2.mem base 0xa00 i 9
      have sp1 := numAt_split s1.mem base 0xa00 i 8
      rw [show i + 8 = 8 + i by omega] at sp1
      rw [show 8 + (i + 1) = i + 9 by omega, sp2, ti, n2]
      rw [n1] at sp1
      have e1 : 2 ^ (32 * i) * (numAt s1.mem base (0xa00 + 4 * i) 8
            + wordAt s.mem base (0x904 + 4 * i) * numAt s.mem base 0x924 8)
          = 2 ^ (32 * i) * numAt s1.mem base (0xa00 + 4 * i) 8
            + wordAt s.mem base (0x904 + 4 * i) * 2 ^ (32 * i) * numAt s.mem base 0x924 8 := by
        rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm (2 ^ (32 * i)) (wordAt s.mem base (0x904 + 4 * i))]
      have e2 : numAt s.mem base 0x904 (i + 1) * numAt s.mem base 0x924 8
          = numAt s.mem base 0x904 i * numAt s.mem base 0x924 8
            + wordAt s.mem base (0x904 + 4 * i) * 2 ^ (32 * i) * numAt s.mem base 0x924 8 := by
        simp only [numAt]; rw [Nat.add_mul]
      rw [e1, e2]
      omega

set_option exponentiation.threshold 300 in
/-- A number of ten words: its first eight and the two above, at their weights. -/
theorem num10 (m : Word → Byte) (o : Nat) :
    numAt m base o 10
      = numAt m base o 8 + wordAt m base (o + 32) * 2 ^ 256 + wordAt m base (o + 36) * (2 ^ 32 * 2 ^ 256) := by
  rw [show (2 : Nat) ^ 32 * 2 ^ 256 = 2 ^ (32 * 9) by rw [← Nat.pow_add]]; rfl

theorem num8_lt (m : Word → Byte) (o : Nat) : numAt m base o 8 < 2 ^ 256 := numAt_lt m base o 8

/-- **Multiplication**, from OP_MUL with s1 set: R is `a · b mod p`. -/
theorem mul_run (hp : Placed env base) {s : Machine} {a b : Nat}
    (hpc : s.pc = base + BitVec.ofNat 32 (4 * OP_MUL)) (hg : Given s.mem base a b)
    (h9 : s.reg 9 = base + BitVec.ofNat 32 0x800) :
    ∃ s', run env 1895 s = .running s' ∧ run env 1896 s = .halted 0 s'
      ∧ numAt s'.mem base 0x944 8 = (a * b) % P := by
  have hfit := hp.fit
  -- T[0 .. 8) = 0
  obtain ⟨s1, e1, p1, kp1, n1, o1⟩ := zero_run hp m_zero (s := s) (by decide) (by decide) (by decide) hpc hg.code h9
  have c1 : CodeAt s1.mem base kernel := Kept.code hfit kp1 (by rw [kernel_length]; decide) (by decide) hg.code
  have g1 : s1.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [o1 9 (by decide), h9]
  -- the eight rows: T = a · b
  obtain ⟨s2, e2, p2, g2, kp2, n2⟩ := rows_run hp (s := s1) (by rw [p1]; rfl) c1 g1 n1 8 (by decide)
  have c2 : CodeAt s2.mem base kernel := Kept.code hfit kp2 (by rw [kernel_length]; decide) (by decide) c1
  have k02 : Kept s.mem s2.mem base 0xa00 0xa40 := (kp1.widen (Nat.le_refl _) (by decide)).trans kp2
  have hab : numAt s2.mem base 0xa00 8 + 2 ^ 256 * numAt s2.mem base 0xa20 8 = a * b := by
    have sT : numAt s2.mem base 0xa00 16 = numAt s2.mem base 0xa00 8 + 2 ^ 256 * numAt s2.mem base 0xa20 8 :=
      numAt_split s2.mem base 0xa00 8 8
    have n2' : numAt s2.mem base 0xa00 16 = numAt s1.mem base 0x904 8 * numAt s1.mem base 0x924 8 := n2
    rw [kp1.num hfit (by decide) (by decide), kp1.num hfit (by decide) (by decide), hg.ina, hg.inb] at n2'
    rw [← sT, n2']
  -- U = L + (2^32 + 977) H
  obtain ⟨s3, e3, p3, kp3, n3, o3⟩ := fold_run hp m_fold1 (s := s2) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by rw [p2]; rfl) c2 g2
  have c3 : CodeAt s3.mem base kernel := Kept.code hfit kp3 (by rw [kernel_length]; decide) (by decide) c2
  have g3 : s3.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [o3 9 (by decide), g2]
  -- V = U[8] + 2^32 U[9]
  obtain ⟨s4, e4, p4, kp4, n4, o4⟩ := hset_run hp m_hset1 (s := s3) (by decide) (by decide) (by rw [p3]; rfl) c3 g3
  have c4 : CodeAt s4.mem base kernel := Kept.code hfit kp4 (by rw [kernel_length]; decide) (by decide) c3
  have g4 : s4.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [o4 9 (by decide), g3]
  -- W = U[0 .. 8) + (2^32 + 977) V
  obtain ⟨s5, e5, p5, kp5, n5, o5⟩ := fold_run hp m_fold2 (s := s4) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by rw [p4]; rfl) c4 g4
  have c5 : CodeAt s5.mem base kernel := Kept.code hfit kp5 (by rw [kernel_length]; decide) (by decide) c4
  have g5 : s5.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [o5 9 (by decide), g4]
  obtain ⟨s6, e6, p6, kp6, n6, o6⟩ := hset_run hp m_hset2 (s := s5) (by decide) (by decide) (by rw [p5]; rfl) c5 g5
  have c6 : CodeAt s6.mem base kernel := Kept.code hfit kp6 (by rw [kernel_length]; decide) (by decide) c5
  have g6 : s6.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [o6 9 (by decide), g5]
  -- X = W[0 .. 8) + (2^32 + 977) V
  obtain ⟨s7, e7, p7, kp7, n7, o7⟩ := fold_run hp m_fold3 (s := s6) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by rw [p6]; rfl) c6 g6
  have c7 : CodeAt s7.mem base kernel := Kept.code hfit kp7 (by rw [kernel_length]; decide) (by decide) c6
  have g7 : s7.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [o7 9 (by decide), g6]
  have k07 : Kept s.mem s7.mem base 0xa00 0xb28 :=
    (((((((k02.widen (Nat.le_refl _) (by decide)).trans (kp3.widen (by decide) (by decide))).trans
      (kp4.widen (by decide) (by decide))).trans (kp5.widen (by decide) (by decide))).trans
      (kp6.widen (by decide) (by decide))).trans (kp7.widen (by decide) (by decide))))
  have hP7 : numAt s7.mem base 0x800 8 = P := by rw [k07.num hfit (by decide) (by decide), hg.prime]
  -- what each piece read, as the one before left it
  have u4 : numAt s4.mem base 0xa40 8 = numAt s3.mem base 0xa40 8 := kp4.num hfit (by decide) (by decide)
  have w6 : numAt s6.mem base 0xac0 8 = numAt s5.mem base 0xac0 8 := kp6.num hfit (by decide) (by decide)
  have uS := num10 (base := base) s3.mem 0xa40
  have wS := num10 (base := base) s5.mem 0xac0
  have xS := num10 (base := base) s7.mem 0xb00
  rw [u4] at n5
  rw [w6] at n7
  have bT := num8_lt (base := base) s2.mem 0xa00
  have bT' := num8_lt (base := base) s2.mem 0xa20
  have bU := num8_lt (base := base) s3.mem 0xa40
  have bW := num8_lt (base := base) s5.mem 0xac0
  have bX := num8_lt (base := base) s7.mem 0xb00
  have bu8 := wordAt_lt s3.mem base (0xa40 + 32)
  have bu9 := wordAt_lt s3.mem base (0xa40 + 36)
  have bw8 := wordAt_lt s5.mem base (0xac0 + 32)
  have bw9 := wordAt_lt s5.mem base (0xac0 + 36)
  have bx8 := wordAt_lt s7.mem base (0xb00 + 32)
  have bx9 := wordAt_lt s7.mem base (0xb00 + 36)
  have hPv : P = 2 ^ 256 - 2 ^ 32 - 977 := rfl
  have hlt : numAt s7.mem base 0xb00 8 + 2 ^ 256 * wordAt s7.mem base (0xb00 + 32) < 2 * P := by omega
  have key : a * b = (numAt s7.mem base 0xb00 8 + 2 ^ 256 * wordAt s7.mem base (0xb00 + 32))
      + (2 ^ 256 - 2 ^ 32 - 977) * (numAt s2.mem base 0xa20 8 + numAt s4.mem base 0xa80 8
        + numAt s6.mem base 0xa80 8) := by omega
  obtain ⟨s8, e8, p8, kp8, n8, -⟩ := csub_run hp m_csub (s := s7) (by decide) (by decide) (by decide)
    (by rw [p7]; rfl) c7 g7 hP7 hlt
  obtain ⟨s9, e9, e9', m9⟩ := halt_run hp m_halt (s := s8) (by rw [p8]; rfl) (Kept.code hfit kp8 (by rw [kernel_length]; decide) (by decide) c7)
  refine ⟨s9, ?_, ?_, ?_⟩
  · rw [show 1895 = 76 + (135 * 8 + (171 + (10 + (171 + (10 + (171 + (204 + 2))))))) from rfl,
      run_add_running e1, run_add_running e2, run_add_running e3, run_add_running e4, run_add_running e5,
      run_add_running e6, run_add_running e7, run_add_running e8, e9]
  · rw [show 1896 = 76 + (135 * 8 + (171 + (10 + (171 + (10 + (171 + (204 + 3))))))) from rfl,
      run_add_running e1, run_add_running e2, run_add_running e3, run_add_running e4, run_add_running e5,
      run_add_running e6, run_add_running e7, run_add_running e8, e9']
  · rw [m9, n8, key, ← hPv, Nat.add_mul_mod_self_left]

/-! ## From the first instruction -/

/-- `auipc s1, 0; addi s1, s1, 0x400` twice; `lw t0, OPW(s1)`. -/
theorem entry_run (hp : Placed env base) {s : Machine} (hpc : s.pc = base) (hcode : CodeAt s.mem base kernel) :
    ∃ s', run env 4 s = .running s' ∧ s'.pc = base + BitVec.ofNat 32 (4 * 4) ∧ s'.mem = s.mem
      ∧ s'.reg 9 = base + BitVec.ofNat 32 0x800 ∧ s'.reg 5 = BitVec.ofNat 32 (wordAt s.mem base 0x900) := by
  have hfit := hp.fit
  obtain ⟨s1, e1, p1, m1, r1⟩ := regStep (prog := kernel) hp 0 (by decide) hcode (by simp [hpc])
    (i := .auipc 9 0) (by decide) rfl
  have b1 : s1.reg 9 = base := by
    rw [reg_wrote r1 (by decide), hpc, show (0 : BitVec 20) ++ 0#12 = (0 : Word) by decide]; simp
  have c1 : CodeAt s1.mem base kernel := by rw [m1]; exact hcode
  have l2 : run env 2 s1 = .running (s1.line [.opi .addi 9 9 0x400, .opi .addi 9 9 0x400]) :=
    run_line (prog := kernel) hp [.opi .addi 9 9 0x400, .opi .addi 9 9 0x400] rfl 1 s1 (by decide) (by decide)
      c1 p1 (by decide)
  generalize hs2 : s1.line [.opi .addi 9 9 0x400, .opi .addi 9 9 0x400] = s2 at l2
  have p2 : s2.pc = base + BitVec.ofNat 32 (4 * 3) := by rw [← hs2, line_pc_at _ p1 (by decide)]; rfl
  have m2 : s2.mem = s.mem := by rw [← hs2, line_mem, m1]
  have b2 : s2.reg 9 = base + BitVec.ofNat 32 0x800 := by
    rw [← hs2]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluI]; regsimp
    rw [b1, show (0x400 : BitVec 12) = BitVec.ofNat 12 1024 from rfl, se_small 1024 (by decide),
      off_add hfit 1024 1024 (by decide)]
  obtain ⟨s3, e3, p3, m3, r3⟩ := lwS1 hp 3 (by decide) (by rw [m2]; exact hcode) p2 b2 (rd := 5) (c := 0x900) (by decide)
    ⟨by decide, by decide⟩ (by decide)
  refine ⟨s3, ?_, p3, by rw [m3, m2], by rw [r3 9]; regsimp; exact b2, by rw [r3 5]; regsimp; rw [m2]⟩
  rw [show 4 = 1 + (2 + 1) from rfl, run_add_running e1, run_add_running l2, e3]

/-- `beq` on a word and a small number: equal exactly when the numbers are. -/
theorem beq_word {op : Nat} (h : op < 2 ^ 32) (c : Nat) (hc : c < 2 ^ 32) :
    (BitVec.ofNat 32 op == BitVec.ofNat 32 c) = decide (op = c) := by
  by_cases e : op = c
  · subst e; simp
  · have ne : BitVec.ofNat 32 op ≠ BitVec.ofNat 32 c := fun h' => e (by
      have := congrArg BitVec.toNat h'
      rwa [BitVec.toNat_ofNat, BitVec.toNat_ofNat, Nat.mod_eq_of_lt h, Nat.mod_eq_of_lt hc] at this)
    simp [ne, e]

/-- How many instructions each operation takes, to its `ecall` included. -/
def count (op : Nat) : Nat :=
  if op = 0 then 331 else if op = 1 then 238 else 1903

/-- **The kernel computes the field.** From base, with the kernel, p at PRIME,
the operation at OPW and `a, b < p` at A and B: the kernel runs `count op - 1`
instructions, the next one halts with 0, and R holds `spec op a b`. The count
does not depend on `a` or `b`. -/
theorem field (hp : Placed env base) {s : Machine} {op a b : Nat} (hpc : s.pc = base)
    (hg : Given s.mem base a b) (hop : wordAt s.mem base 0x900 = op) (ha : a < P) (hb : b < P) :
    ∃ s', run env (count op - 1) s = .running s' ∧ run env (count op) s = .halted 0 s'
      ∧ numAt s'.mem base 0x944 8 = spec op a b := by
  have hfit := hp.fit
  have hlt : op < 2 ^ 32 := hop ▸ wordAt_lt _ _ _
  obtain ⟨s4, e4, p4, m4, g4, r4⟩ := entry_run hp hpc hg.code
  rw [hop] at r4
  have hg4 : Given s4.mem base a b := by rw [m4]; exact hg
  obtain ⟨s5, e5, p5, m5, k5⟩ := brStep (prog := kernel) hp 4 (by decide) (by rw [m4]; exact hg.code) p4
    (op := .beq) (rs1 := 5) (rs2 := 0) (off := 0x2c0) (by decide) (k' := OP_ADD) (by jump)
  have hg5 : Given s5.mem base a b := by rw [m5]; exact hg4
  have g5 : s5.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [k5, g4]
  rw [r4, reg_zero, show (0 : Word) = BitVec.ofNat 32 0 from rfl] at p5
  simp only [taken, beq_word hlt 0 (by decide)] at p5
  by_cases h0 : op = 0
  · subst h0
    simp only [decide_true, ↓reduceIte] at p5
    obtain ⟨s', e, e', n⟩ := add_run hp p5 hg5 g5 ha hb
    refine ⟨s', ?_, ?_, n⟩
    · rw [show count 0 - 1 = 4 + (1 + 325) from rfl, run_add_running e4, run_add_running e5, e]
    · rw [show count 0 = 4 + (1 + 326) from rfl, run_add_running e4, run_add_running e5, e']
  · simp only [h0, decide_false, Bool.false_eq_true, ↓reduceIte] at p5
    have l6 : run env 1 s5 = .running (s5.line [.opi .addi 6 0 0x1]) :=
      run_line (prog := kernel) hp [.opi .addi 6 0 0x1] rfl 5 s5 (by decide) (by decide) hg5.code p5 (by decide)
    generalize hs6 : s5.line [.opi .addi 6 0 0x1] = s6 at l6
    have p6 : s6.pc = base + BitVec.ofNat 32 (4 * 6) := by rw [← hs6, line_pc_at _ p5 (by decide)]; rfl
    have m6 : s6.mem = s5.mem := by rw [← hs6, line_mem]
    have r65 : s6.reg 5 = BitVec.ofNat 32 op := by
      rw [← hs6]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluI]; regsimp
      rw [k5, r4]
    have r66 : s6.reg 6 = BitVec.ofNat 32 1 := by
      rw [← hs6]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluI]; regsimp
      rw [reg_zero]; exact setk_val 1 (by decide)
    have g6 : s6.reg 9 = base + BitVec.ofNat 32 0x800 := by
      rw [← hs6]; simp only [line_cons, line_nil, Machine.alu, next_reg, reg_setReg, aluI]; regsimp; exact g5
    have hg6 : Given s6.mem base a b := by rw [m6]; exact hg5
    obtain ⟨s7, e7, p7, m7, k7⟩ := brStep (prog := kernel) hp 6 (by decide) hg6.code p6
      (op := .beq) (rs1 := 5) (rs2 := 6) (off := 0x334) (by decide) (k' := OP_SUB) (by jump)
    have hg7 : Given s7.mem base a b := by rw [m7]; exact hg6
    have g7 : s7.reg 9 = base + BitVec.ofNat 32 0x800 := by rw [k7, g6]
    rw [r65, r66] at p7
    simp only [taken, beq_word hlt 1 (by decide)] at p7
    by_cases h1 : op = 1
    · subst h1
      simp only [decide_true, ↓reduceIte] at p7
      obtain ⟨s', e, e', n⟩ := sub_run hp p7 hg7 g7 ha hb
      have q1 : run env 237 s = .running s' := by
        rw [show 237 = 4 + (1 + (1 + (1 + 230))) from rfl, run_add_running e4, run_add_running e5,
          run_add_running l6, run_add_running e7, e]
      have q2 : run env 238 s = .halted 0 s' := by
        rw [show 238 = 4 + (1 + (1 + (1 + 231))) from rfl, run_add_running e4, run_add_running e5,
          run_add_running l6, run_add_running e7, e']
      have hc1 : count 1 - 1 = 237 := by simp [count]
      have hc2 : count 1 = 238 := by simp [count]
      have hs1 : spec 1 a b = (a + P - b) % P := by simp [spec]
      exact ⟨s', hc1 ▸ q1, hc2 ▸ q2, hs1 ▸ n⟩
    · simp only [h1, decide_false, Bool.false_eq_true, ↓reduceIte] at p7
      obtain ⟨s', e, e', n⟩ := mul_run hp (by rw [p7]; rfl) hg7 g7
      have q1 : run env 1902 s = .running s' := by
        rw [show 1902 = 4 + (1 + (1 + (1 + 1895))) from rfl, run_add_running e4, run_add_running e5,
          run_add_running l6, run_add_running e7, e]
      have q2 : run env 1903 s = .halted 0 s' := by
        rw [show 1903 = 4 + (1 + (1 + (1 + 1896))) from rfl, run_add_running e4, run_add_running e5,
          run_add_running l6, run_add_running e7, e']
      have hc1 : count op - 1 = 1902 := by simp [count, h0, h1]
      have hc2 : count op = 1903 := by simp [count, h0, h1]
      have hs : spec op a b = (a * b) % P := by simp [spec, h0, h1]
      exact ⟨s', hc1 ▸ q1, hc2 ▸ q2, hs ▸ n⟩

end Exp229



/-! ## Constant time

The kernel through lean/Rv32/Ct.lean's checker: p and the operation are
public, and nothing else is — a, b and everything made from them may differ
between two runs. At each loop's head s1 is `base + PRIME`, the counter t1 is
between 1 and 8, and each pointer is where it started plus four words for
each round already run, which is a fixed offset less four times t1. -/

namespace Exp229
open Rv32 Rv32.Ct

/-- Public: p and the operation word. -/
def pub : List (Nat × Nat) := [(0x800, 0x904)]

/-- A state where only the registers named are known, and the rest secret. -/
def known (o : List (Nat × AV)) : AState :=
  (List.range 32).map fun n => match o.find? (fun p => p.1 == n) with
    | some (_, v) => v
    | none => .sec

def loopHead (x y z : Nat) : AState :=
  known [(9, .ptr 0x800 0x800), (6, .num 1 8), (10, .aff 6 (-4) (x + 32)), (11, .aff 6 (-4) (y + 32)),
    (12, .aff 6 (-4) (z + 32))]

def heads : Heads :=
  (OP_ADD, known [(9, .ptr 0x800 0x800)]) :: (OP_SUB, known [(9, .ptr 0x800 0x800)]) ::
    loops.map fun (L, x, y, z) => (L, loopHead x y z)

set_option maxRecDepth 100000 in
theorem accepted : check kernel pub heads = true := by decide

/-- An image that begins with the kernel's 1832 bytes holds the kernel. -/
theorem code_of_image {base : Word} (hfit : base.toNat + 0x10000 ≤ 2^32) (img : ByteArray)
    (hsize : 1832 ≤ img.size) (himg : ∀ d (h : d < 1832), img.get d (by omega) = bytes.getD d 0) :
    CodeAt (memOfImage base img) base kernel :=
  Rv32.code_of_image hfit (by rw [kernel_length]; decide) (toBytes_words kernel) img
    (by rw [kernel_length]; exact hsize)
    (fun d h => himg d (by rw [kernel_length] at h; exact h))

/-- **The trace does not depend on a or b.** Two images that begin with the
kernel and hold the same p and the same operation — whatever a and b they
hold, and whatever else — run in lock step: at every step the same `pc`, the
same address loaded or stored, and the same end. -/
theorem field_constant_time {env : Env} {base : Word} (hp : Placed env base) (img1 img2 : ByteArray)
    (hsize1 : 1832 ≤ img1.size) (h1 : ∀ d (h : d < 1832), img1.get d (by omega) = bytes.getD d 0)
    (hpub : ∀ o, o < 0x10000 → InP kernel.length pub o →
      memOfImage base img1 (base + BitVec.ofNat 32 o) = memOfImage base img2 (base + BitVec.ofNat 32 o)) :
    ∀ n, trace env n (boot env.region img1) = trace env n (boot env.region img2)
      ∧ Same (run env n (boot env.region img1)) (run env n (boot env.region img2)) :=
  constant_time_boot hp accepted (by decide) img1 img2 hpub (code_of_image hp.fit img1 hsize1 h1)

end Exp229

