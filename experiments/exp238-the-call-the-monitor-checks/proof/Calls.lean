    readLE (PrivMachine.run env 54 s).core.mem 0x8000800c#32 4 = 0 ∧
    SvcSame s.core.mem (PrivMachine.run env 54 s).core.mem ∧
    Frame s.core.mem (PrivMachine.run env 54 s).core.mem ∧
    (∀ r, (PrivMachine.run env 54 s).core.reg r = regsUpd s.core.reg [(1, 0#32), (2, 0#32), (3, 0#32), (4, 0#32), (5, 0#32), (6, 0#32), (7, 0#32), (8, 0#32), (9, 0#32), (11, 0#32), (12, 0#32), (13, 0#32), (14, 0#32), (15, 0#32), (16, 0#32), (17, 0#32), (18, 0#32), (19, 0#32), (20, 0#32), (21, 0#32), (22, 0#32), (23, 0#32), (24, 0#32), (25, 0#32), (26, 0#32), (27, 0#32), (28, 0#32), (29, 0#32), (30, 0#32), (31, 0#32), (10, 1#32)] r) := by
  have p0 := hpc
  have c0 := hcs
