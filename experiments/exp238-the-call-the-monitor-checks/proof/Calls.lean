  obtain ⟨p2, a2, h2, m2, c2, w2_0, w2_1, w2_2, w2_3, sv2, fr2, r2⟩ := fault_2 env M0 s1 hS1 ms e c m cy p p1 c1 (by simp [r1, regsUpd, hsp])
