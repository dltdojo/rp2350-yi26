  · exact ⟨_, monitor_hashb_oob_2 env M0 s hS ms e c m cy hpc hcs hc ht0 c1' c2⟩
  have c2' : BitVec.ult 0x80020000#32 (s.core.reg 10#5) = false := by simpa using c2
  by_cases c3 : BitVec.ult (0x80020000#32 - s.core.reg 10#5) (s.core.reg 11#5) = true
  · exact ⟨_, monitor_hashb_oob_3 env M0 s hS ms e c m cy hpc hcs hc ht0 c1' c2' c3⟩
  have c3' : BitVec.ult (0x80020000#32 - s.core.reg 10#5) (s.core.reg 11#5) = false := by simpa using c3
  by_cases c4 : BitVec.ult (s.core.reg 12#5) 0x80010000#32 = true
