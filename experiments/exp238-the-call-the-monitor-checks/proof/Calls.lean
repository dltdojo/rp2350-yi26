  have sm := sm_mon env M0 hW
  obtain ⟨F, hF⟩ : ∃ F, PrivMachine.run env 1 s = F := ⟨_, rfl⟩
  rw [hF]
  psimp [sm, hmem, hpc, monitorCode, hh, hm, hcs, csrsConfigured] at hF
  subst hF
